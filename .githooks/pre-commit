#!/bin/sh
#
# 원격 main 이 앞서 있으면 커밋을 막는다.
#
# 사장님이 편집 화면(/admin/)에서 저장하면 그 커밋은 GitHub 의 main 에 바로 들어간다.
# 그것을 받아오기 전에 로컬에서 커밋하면 히스토리가 두 갈래로 갈라지고,
# push 는 거부되고, 같은 JSON 을 양쪽에서 만졌다면 손으로 합쳐야 한다.
# 갈라지는 순간은 "커밋할 때"이므로 여기서 막는 것이 가장 이르다.
#
# 새 PC 에서 켜는 법 (한 번만):
#   git config core.hooksPath .githooks
#
# 이 검사를 건너뛰려면: git commit --no-verify

# main 에서만 검사한다. 다른 브랜치는 main 보다 뒤처져 있는 것이 정상이다.
branch=$(git symbolic-ref --short -q HEAD)
[ "$branch" = "main" ] || exit 0

# 인증 창이 떠서 멈추는 일이 없도록 프롬프트를 끈다.
export GIT_TERMINAL_PROMPT=0

if ! git fetch -q origin main 2>/dev/null; then
	echo "[pre-commit] 원격을 확인하지 못했습니다(오프라인?). 검사를 건너뜁니다."
	exit 0
fi

behind=$(git rev-list --count HEAD..FETCH_HEAD 2>/dev/null) || behind=0

if [ "$behind" -gt 0 ]; then
	echo ""
	echo "  ┌──────────────────────────────────────────────────────────┐"
	echo "  │  원격 main 에 새 수정 ${behind} 건이 있습니다.                    "
	echo "  │  사장님이 편집 화면에서 저장한 내용일 수 있습니다.        "
	echo "  │                                                          "
	echo "  │  먼저 받아오세요:   git pull --rebase                     "
	echo "  └──────────────────────────────────────────────────────────┘"
	echo ""
	echo "  (그래도 그냥 커밋하려면: git commit --no-verify)"
	echo ""
	exit 1
fi

exit 0
