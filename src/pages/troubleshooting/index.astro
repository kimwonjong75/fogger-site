---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocList from '../../components/DocList.astro';
import SafetyBox from '../../components/SafetyBox.astro';
import { BUSINESS } from '../../data/site';
import { COLLECTION_META, docHref, getPublishedDocs } from '../../lib/content';
import { TROUBLESHOOTING_PAGE } from '../../data/pages';
import { itemListSchema } from '../../lib/schema';

const meta = COLLECTION_META.troubleshooting;
const docs = await getPublishedDocs('troubleshooting');

/** 문구는 편집 화면(/admin/ → "문제해결 목록 화면")에서 고친다 — src/content/pages/troubleshooting.json */
const page = TROUBLESHOOTING_PAGE;

const list = itemListSchema(
  meta.href,
  meta.title,
  docs.map((doc) => ({ name: doc.data.title, href: docHref('troubleshooting', doc.id) })),
);
---

<BaseLayout
  title={page.seo.title}
  description={page.lede}
  canonicalPath={meta.href}
  ogImage="/og/og-troubleshooting.png"
  crumbs={[{ name: meta.label, href: meta.href }]}
  schemaNodes={[list]}
>
  <h1>{page.heading}</h1>
  <p class="lede">{page.lede}</p>

  <SafetyBox title={page.safetyBoxTitle} compact only={['aux-inlet', 'heat']} />

  <DocList docs={docs} />

  <section class="as">
    <h2>{page.asHeading}</h2>
    <p>{page.asBody}</p>
    <p><a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a> {page.asContactSuffix}</p>
  </section>
</BaseLayout>

<style>
  .as {
    margin-top: 2.5rem;
    padding: 1.35rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-btn);
    background: var(--c-surface-alt);
  }

  .as h2 {
    margin-top: 0;
  }

  .as p {
    font-size: 0.94rem;
    color: var(--c-text-muted);
  }
</style>
