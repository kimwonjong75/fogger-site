---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocList from '../../components/DocList.astro';
import SafetyBox from '../../components/SafetyBox.astro';
import { COLLECTION_META, getPublishedDocs } from '../../lib/content';

const meta = COLLECTION_META.guides;
const docs = await getPublishedDocs('guides');
---

<BaseLayout
  title="연막소독기 사용법 모음"
  description={meta.description}
  canonicalPath={meta.href}
  ogImage="/og/og-guides.png"
  crumbs={[{ name: meta.label, href: meta.href }]}
>
  <h1>{meta.title}</h1>
  <p class="lede">{meta.description}</p>

  <SafetyBox title="모든 작업에 공통" compact only={['fill-limit', 'aux-inlet']} />

  <DocList docs={docs} />

  <p class="more">
    증상별 점검이 필요하면 <a href="/troubleshooting/">문제해결</a>, 현장별 운용은
    <a href="/uses/">활용사례</a>를 참고하세요.
  </p>
</BaseLayout>

<style>
  .more {
    margin-top: 2rem;
    font-size: 0.93rem;
    color: var(--c-text-muted);
  }
</style>
