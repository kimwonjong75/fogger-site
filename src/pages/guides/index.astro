---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocList from '../../components/DocList.astro';
import SafetyBox from '../../components/SafetyBox.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { HOWTO_STEPS, HOWTO_VIDEO, VIDEO_PUBLISHED_DATE, howToApprovalLabel } from '../../data/media';
import { COLLECTION_META, docHref, getPublishedDocs } from '../../lib/content';
import { GUIDES_PAGE } from '../../data/pages';
import { inlineParts } from '../../lib/page-content';
import { howToSchema, itemListSchema, videoSchema } from '../../lib/schema';

const meta = COLLECTION_META.guides;
const docs = await getPublishedDocs('guides');

/**
 * 문구는 편집 화면(/admin/ → "사용법 목록 화면")에서 고친다 — src/content/pages/guides.json
 *
 * 아래 10단계(HOWTO_STEPS)는 예외로 코드에 남겼다. 소개 영상의 자막을 그대로 옮긴
 * 순서라 글만 고치면 영상과 어긋나기 때문이다. 영상을 다시 찍으면 함께 고친다.
 */
const page = GUIDES_PAGE;

const approval = howToApprovalLabel();

const list = itemListSchema(
  meta.href,
  meta.title,
  docs.map((doc) => ({ name: doc.data.title, href: docHref('guides', doc.id) })),
);

/**
 * 공식 사용법 10단계.
 *
 * 2026-08-07에 홈에서 이 페이지로 옮겼다. 홈이 "왜 사야 하는가"만 답하도록 줄이면서
 * 단계 목록을 뺐는데, **화면의 10단계와 HowTo 구조화데이터는 반드시 같은 페이지에 있어야
 * 한다.** 둘이 갈라지면 검색엔진이 절차를 인식하지 못하고, 화면에 없는 내용을 구조화데이터로
 * 내보내는 정책 위반이 된다. 그래서 목록과 스키마를 함께 옮겼다.
 *
 * 화면에 렌더링하는 순서·문구를 그대로 쓴다. step-{no} 앵커도 스키마가 참조한다.
 */
const howTo = howToSchema(meta.href, '블루가드 연막소독기 사용방법', HOWTO_STEPS);

/**
 * 사용법 영상. 2026-08-08에 홈에서 이 페이지로 옮겼다.
 *
 * 아래 10단계는 이 영상의 자막을 그대로 옮긴 순서다. 둘이 떨어져 있으면 독자는 글만 읽고
 * 영상은 못 보게 되고, 검색엔진도 절차와 영상을 잇지 못한다. VideoObject 스키마도
 * 영상과 같은 페이지에 있어야 하므로 함께 옮겼다.
 */
const howToVideo = videoSchema({
  name: HOWTO_VIDEO.title,
  description: HOWTO_VIDEO.caption,
  contentUrl: HOWTO_VIDEO.src,
  thumbnailUrl: HOWTO_VIDEO.poster.src,
  durationSec: HOWTO_VIDEO.durationSec,
  uploadDate: VIDEO_PUBLISHED_DATE,
});
---

<BaseLayout
  title={page.seo.title}
  description={page.lede}
  canonicalPath={meta.href}
  ogImage="/og/og-guides.png"
  crumbs={[{ name: meta.label, href: meta.href }]}
  schemaNodes={[list, howTo, howToVideo]}
>
  <h1>{page.heading}</h1>
  <p class="lede">{page.lede}</p>

  <SafetyBox title={page.safetyBoxTitle} compact only={['fill-limit', 'aux-inlet']} />

  <section aria-labelledby="howto">
    <h2 id="howto">{page.howtoHeading}</h2>
    <p class="section-desc">{page.howtoDesc}</p>

    <VideoEmbed video={HOWTO_VIDEO} />

    <ol class="howto-steps">
      {
        HOWTO_STEPS.map((step) => (
          <li id={`step-${step.no}`}>
            <strong>{step.title}</strong>
            <span>{step.body}</span>
          </li>
        ))
      }
    </ol>
    {approval && <p class="howto-approval">{approval}</p>}
  </section>

  <h2>{page.docsHeading}</h2>
  <DocList docs={docs} />

  <p class="more">
    {
      inlineParts(page.moreText).map((part) =>
        part.kind === 'link' ? <a href={part.href}>{part.text}</a> : part.text,
      )
    }
  </p>
</BaseLayout>

<style>
  .section-desc {
    margin: 0 0 1.25rem;
    color: var(--c-text-muted);
    font-size: 0.97rem;
    max-width: 60ch;
  }

  /* 공식 10단계 — 영상 자막을 그대로 옮긴 순서라 번호를 그대로 노출한다 */
  .howto-steps {
    margin: 1.5rem 0 0;
    padding-left: 1.4rem;
    display: grid;
    gap: 0.7rem;
  }

  .howto-steps li {
    padding-left: 0.2rem;
  }

  .howto-steps strong {
    display: block;
    font-size: 0.97rem;
  }

  .howto-steps span {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--c-text-muted);
  }

  .howto-approval {
    margin: 1rem 0 0;
    font-size: 0.85rem;
    color: var(--c-text-muted);
  }

  .more {
    margin-top: 2rem;
    font-size: 0.93rem;
    color: var(--c-text-muted);
  }
</style>
