---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuyCTA from '../components/BuyCTA.astro';
import SafetyBox from '../components/SafetyBox.astro';
import { MEDIA_SPECS } from '../data/products';
import { MIST_PAGE } from '../data/pages';
import { inlineParts } from '../lib/page-content';
import { faqSchema } from '../lib/schema';

/**
 * 「연무기」로 검색해서 들어온 사람을 받는 화면.
 *
 * 문구는 편집 화면(/admin/ → "연무기 화면")에서 고친다 — src/content/pages/mist.json.
 *
 * 이 화면이 하는 일은 제품 소개가 아니라 **갈라 주기**다. 「연무기」 검색결과에는
 * 가열식·ULV 냉연무·전동 분무가 뒤섞여 나오므로, ULV 를 찾는 사람에게 먼저 "여기가
 * 아니다"라고 말한다. 그래야 잘못 들어온 사람이 헤매지 않고, 검색·AI 도 이 제품을
 * 냉연무기로 잘못 배우지 않는다.
 *
 * 매질 표는 손으로 적지 않고 `MEDIA_SPECS` 에서 읽는다 — 매질이 실내 가부를 정하므로
 * 여기 값이 안전수칙과 어긋나면 안 된다.
 */
const page = MIST_PAGE;
const url = '/mist/';

/** 화면의 문답과 구조화데이터가 항상 같아야 한다 — 같은 배열에서 둘 다 만든다 */
const faq = faqSchema(
  url,
  page.faq.map((item) => ({ q: item.q, a: item.a })),
);

/** 굵게·링크 표기를 그대로 렌더링한다 (HTML 태그는 글자로 나간다 — inlineParts 주석 참조) */
const parts = (text: string) => inlineParts(text);
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  canonicalPath={url}
  ogImage="/og/og-products.png"
  crumbs={[{ name: '연무기', href: url }]}
  schemaNodes={[faq]}
  stickyBuy="generic"
>
  <p class="eyebrow">{page.eyebrow}</p>
  <h1>{page.heading}</h1>
  <p class="lede">{page.lede}</p>

  <section class="panel panel--alt answer">
    <h2>{page.answerHeading}</h2>
    {
      page.answer.map((text) => (
        <p>
          {parts(text).map((part) =>
            part.kind === 'bold' ? (
              <strong>{part.text}</strong>
            ) : part.kind === 'link' ? (
              <a href={part.href}>{part.text}</a>
            ) : (
              part.text
            ),
          )}
        </p>
      ))
    }
  </section>

  <section>
    <h2>{page.methodsHeading}</h2>
    <p class="lede">
      {
        parts(page.methodsDesc).map((part) =>
          part.kind === 'bold' ? (
            <strong>{part.text}</strong>
          ) : part.kind === 'link' ? (
            <a href={part.href}>{part.text}</a>
          ) : (
            part.text
          ),
        )
      }
    </p>

    <div class="methods">
      {
        page.methods.map((method) => (
          <article class:list={['method', method.ours && 'method--ours']}>
            <header>
              <h3>{method.name}</h3>
              {method.ours && <span class="badge">이 제품</span>}
            </header>
            <dl>
              <div>
                <dt>입자</dt>
                <dd>{method.particle}</dd>
              </div>
              <div>
                <dt>동력</dt>
                <dd>{method.power}</dd>
              </div>
            </dl>
            <p>{method.detail}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <h2>{page.switchHeading}</h2>
    <p class="lede">
      {
        parts(page.switchDesc).map((part) =>
          part.kind === 'bold' ? (
            <strong>{part.text}</strong>
          ) : part.kind === 'link' ? (
            <a href={part.href}>{part.text}</a>
          ) : (
            part.text
          ),
        )
      }
    </p>

    <div class="media">
      {
        MEDIA_SPECS.map((medium) => (
          <article class="medium">
            <h3>{medium.name}</h3>
            <p class="medium__mode">
              {medium.mode} · {medium.venueLabel}
            </p>
            <p>{medium.detail}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <h2>{page.faqHeading}</h2>
    <div class="faq">
      {
        page.faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <SafetyBox title={page.safetyBoxTitle} />

  <nav class="more" aria-label="관련 화면">
    {page.moreLinks.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>

  <div class="cta">
    <BuyCTA content="mist_bottom" />
  </div>
</BaseLayout>

<style>
  .answer p {
    margin: 0 0 0.85rem;
    font-size: 1.02rem;
    line-height: 1.8;
  }

  .answer p:last-child {
    margin-bottom: 0;
  }

  /* 방식 비교 — 표가 아니라 카드로 둔다. 휴대폰에서 3열 표는 가로로 잘린다 */
  .methods {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .method {
    padding: 1.15rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-card);
    background: var(--c-surface);
  }

  /*
   * 이 제품이 쓰는 방식만 네 변을 고르게 두르고 배경을 옅게 깐다.
   * 색 있는 한쪽 테두리(border-left)는 디자인 시스템이 금한다.
   */
  .method--ours {
    border-color: var(--c-accent-dark);
    background: var(--c-accent-soft);
  }

  .method header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.6rem;
  }

  .method h3 {
    margin: 0;
  }

  .badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.12rem 0.45rem;
    border-radius: var(--r-tag);
    background: var(--c-accent-dark);
    color: #fff;
    white-space: nowrap;
  }

  .method dl {
    display: grid;
    gap: 0.3rem;
    margin: 0 0 0.7rem;
    padding: 0 0 0.7rem;
    border-bottom: 1px solid var(--c-border);
    font-size: 0.88rem;
  }

  .method dl > div {
    display: flex;
    gap: 0.5rem;
  }

  .method dt {
    flex: 0 0 3.2rem;
    color: var(--c-text-muted);
  }

  .method dd {
    margin: 0;
    font-weight: 700;
  }

  .method p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--c-text-muted);
  }

  .media {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .medium {
    padding: 1.15rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-card);
    background: var(--c-surface-alt);
  }

  .medium h3 {
    margin: 0 0 0.2rem;
  }

  .medium__mode {
    margin: 0 0 0.6rem;
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--c-accent-dark);
  }

  .medium p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--c-text-muted);
  }

  .faq {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .faq details {
    border: 1px solid var(--c-border);
    border-radius: var(--r-btn);
    background: var(--c-surface);
    padding: 0.85rem 1.1rem;
  }

  .faq summary {
    cursor: pointer;
    font-weight: 700;
  }

  .faq p {
    margin: 0.6rem 0 0;
    color: var(--c-text-muted);
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2.5rem;
  }

  .more a {
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--c-border-strong);
    border-radius: var(--r-pill);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .cta {
    margin-top: 2rem;
  }
</style>
