---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAV } from '../data/site';
---

<BaseLayout
  title="페이지를 찾을 수 없습니다"
  description="요청하신 주소의 페이지가 없습니다. 아래 메뉴에서 필요한 정보를 찾아보세요."
  canonicalPath="/404/"
  noindex
  crumbs={[{ name: '404', href: '/404/' }]}
  width="narrow"
>
  <div class="notfound">
    <p class="notfound__code">404</p>
    <h1>페이지를 찾을 수 없습니다</h1>
    <p class="lede">
      주소가 바뀌었거나 아직 공개되지 않은 문서일 수 있습니다. 아래에서 필요한 정보를 찾아보세요.
    </p>
    <ul>
      {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      <li><a href="/uses/">활용사례</a></li>
    </ul>
    <p><a href="/">홈으로 돌아가기</a></p>
  </div>
</BaseLayout>

<style>
  .notfound {
    padding: 2rem 0;
  }

  .notfound__code {
    margin: 0;
    font-size: 3rem;
    font-weight: 800;
    color: var(--c-border-strong);
    line-height: 1;
  }

  .notfound ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .notfound li a {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 1rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-btn);
    background: var(--c-surface);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .notfound li a:hover {
    border-color: var(--c-accent);
    background: var(--c-accent-soft);
  }
</style>
