---
import BaseLayout from '../layouts/BaseLayout.astro';
import FactTable from '../components/FactTable.astro';
import ModelSpecTable from '../components/ModelSpecTable.astro';
import { BUSINESS } from '../data/site';
import {
  FILL_RATIO_LABEL,
  HEAT_SOURCE,
  MEDIA_LABEL,
  SAFETY_RULES,
} from '../data/products';

const limits = [
  { label: '가열원', value: HEAT_SOURCE, note: '체결 상태를 매 작업 전 확인합니다.' },
  { label: '사용 가능 매질', value: MEDIA_LABEL, note: '가솔린·알코올·시너·폐유는 금지입니다.' },
  {
    label: '충전 한도',
    value: `탱크 용량의 ${FILL_RATIO_LABEL}`,
    note: '가열 시 팽창을 고려한 상한이며 초과 시 넘침·역류 위험이 있습니다.',
  },
  {
    label: '보조주입구',
    value: '작동 중 사용 금지',
    note: '완전히 끄고 식은 뒤에만 엽니다.',
  },
];
---

<BaseLayout
  title="연막소독기 안전수칙"
  description="충전 한도, 보조주입구 취급, 지정 매질, 환기와 고온부 주의까지 연막소독기 사용 시 반드시 지켜야 할 기준입니다."
  canonicalPath="/safety/"
  ogImage="/og/og-safety.png"
  crumbs={[{ name: '안전수칙', href: '/safety/' }]}
>
  <div class="head">
    <div>
      <h1>안전수칙</h1>
      <p class="lede">
        연막소독기는 매질을 가열해 기화시키는 기기입니다. 아래 항목은 모델과 무관하게 공통으로
        적용됩니다.
      </p>
    </div>
    <button
      type="button"
      class="print-btn"
      data-print
      data-ga-event="safety_print"
      data-ga-manual-name="safety_rules"
      data-ga-file-type="print"
    >
      인쇄 / PDF로 저장
    </button>
  </div>

  <h2>기본 한계값</h2>
  <FactTable rows={limits} caption="전 모델 공통 기준" />

  <h2>지켜야 할 것</h2>
  <ol class="rules">
    {
      SAFETY_RULES.map((rule) => (
        <li class:list={[`is-${rule.level}`]}>
          <h3>
            {rule.title}
            <span class="rules__level">{rule.level === 'critical' ? '필수' : '주의'}</span>
          </h3>
          <p>{rule.body}</p>
        </li>
      ))
    }
  </ol>

  <h2>하지 말아야 할 것</h2>
  <ul class="dont">
    <li>탱크를 가득 채우는 것</li>
    <li>작동 중이거나 뜨거운 상태에서 주입구를 여는 것</li>
    <li>가솔린·알코올·시너·폐유를 넣는 것</li>
    <li>서로 다른 매질을 섞어 쓰는 것</li>
    <li>점화가 안 될 때 반복해서 점화 스위치를 누르는 것</li>
    <li>점화·가스 계통을 임의로 분해하거나 개조하는 것</li>
    <li>부탄가스를 체결한 채로 장기 보관하는 것</li>
    <li>밀폐 공간에 혼자 들어가 작업하는 것</li>
  </ul>

  <h2>모델별 충전 한도</h2>
  <ModelSpecTable
    caption="모델별 탱크 용량과 최대 충전량"
    includeShared={false}
    footnote="표의 최대 충전량을 넘겨 채우지 마세요."
  />

  <section class="emergency">
    <h2>이상이 생겼을 때</h2>
    <ol>
      <li>분사를 멈추고 가열원을 차단합니다.</li>
      <li>기기에서 떨어져 환기부터 확보합니다.</li>
      <li>가스 냄새가 나면 즉시 가스를 분리하고 화기를 멀리합니다.</li>
      <li>식기 전에는 분해하거나 주입구를 열지 않습니다.</li>
      <li>
        증상이 남으면 <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a> 로 접수해 주세요.
      </li>
    </ol>
    <p class="emergency__note">
      화재·누출 등 긴급 상황에서는 안전한 곳으로 대피한 뒤 119에 신고하세요.
    </p>
  </section>
</BaseLayout>

<script>
  document.querySelector<HTMLButtonElement>('[data-print]')?.addEventListener('click', () => {
    window.print();
  });
</script>

<style>
  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .head h1 {
    margin-top: 0.4rem;
  }

  .print-btn {
    flex: none;
    margin-top: 1rem;
    height: 40px;
    padding: 0 1rem;
    border-radius: 8px;
    border: 1.5px solid var(--c-border-strong);
    background: var(--c-surface);
    color: var(--c-text);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
  }

  .print-btn:hover {
    border-color: var(--c-accent);
    color: var(--c-accent-dark);
  }

  .rules {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    counter-reset: rule;
  }

  .rules li {
    padding: 1rem 1.15rem;
    border: 1px solid var(--c-border);
    border-left: 4px solid var(--c-warn);
    border-radius: 8px;
    background: var(--c-surface);
  }

  .rules li.is-critical {
    border-left-color: var(--c-danger);
  }

  .rules h3 {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .rules__level {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: var(--c-warn-soft);
    color: var(--c-warn-text);
  }

  .rules li.is-critical .rules__level {
    background: #fee2e2;
    color: #991b1b;
  }

  .rules p {
    margin: 0;
    font-size: 0.93rem;
    color: var(--c-text-muted);
  }

  .dont {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.35rem;
  }

  .emergency {
    margin-top: 2.5rem;
    padding: 1.35rem;
    border: 1px solid var(--c-warn-border);
    border-radius: 10px;
    background: var(--c-warn-soft);
  }

  .emergency h2 {
    margin-top: 0;
  }

  .emergency ol {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.35rem;
  }

  .emergency__note {
    margin: 1rem 0 0;
    font-weight: 600;
    font-size: 0.93rem;
  }

  @media print {
    .print-btn {
      display: none;
    }
  }
</style>
