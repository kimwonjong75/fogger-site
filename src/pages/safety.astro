---
import BaseLayout from '../layouts/BaseLayout.astro';
import FactTable from '../components/FactTable.astro';
import ModelSpecTable from '../components/ModelSpecTable.astro';
import { BUSINESS } from '../data/site';
import { SAFETY_PAGE } from '../data/pages';

/**
 * 안전수칙 문구는 편집 화면(/admin/ → "안전수칙 화면")에서 고친다.
 * 값은 src/content/pages/safety.json 에 있다.
 *
 * 충전 한도·가열원 같은 **숫자는 여기서 직접 쓰지 않는다** — 문구 안에 `{{충전한도}}`
 * 처럼 적으면 src/data/products.ts 의 값으로 자동 치환된다. 사양이 바뀌었을 때
 * 안전 문구만 옛 숫자로 남는 것을 막기 위한 규칙이다.
 */
const page = SAFETY_PAGE;
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  canonicalPath="/safety/"
  ogImage="/og/og-safety.png"
  crumbs={[{ name: '안전수칙', href: '/safety/' }]}
>
  <div class="head">
    <div>
      <h1>{page.heading}</h1>
      <p class="lede">{page.lede}</p>
    </div>
    <button
      type="button"
      class="print-btn"
      data-print
      data-ga-event="safety_print"
      data-ga-manual-name="safety_rules"
      data-ga-file-type="print"
    >
      {page.printButtonLabel}
    </button>
  </div>

  <h2>{page.limitsHeading}</h2>
  <FactTable rows={page.limits} caption={page.limitsCaption} />

  <h2>{page.rulesHeading}</h2>
  <ol class="rules">
    {
      page.rules.map((rule) => (
        <li class:list={[`is-${rule.level}`]}>
          <h3>
            {rule.title}
            <span class="rules__level">{rule.level === 'critical' ? '필수' : '주의'}</span>
          </h3>
          <p>{rule.body}</p>
        </li>
      ))
    }
  </ol>

  <h2>{page.dontHeading}</h2>
  <ul class="dont">
    {page.dont.map((item) => <li>{item}</li>)}
  </ul>

  <h2>{page.fillTableHeading}</h2>
  <ModelSpecTable
    caption={page.fillTableCaption}
    includeShared={false}
    footnote={page.fillTableFootnote}
  />

  <section class="emergency">
    <h2>{page.emergencyHeading}</h2>
    <ol>
      {page.emergencySteps.map((step) => <li>{step}</li>)}
      <li>
        {/* 앞뒤 빈칸을 명시한다 — 줄바꿈만으로는 붙어서 렌더링된다 */}
        {page.emergencyContactPrefix}{' '}
        <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>{' '}
        {page.emergencyContactSuffix}
      </li>
    </ol>
    <p class="emergency__note">{page.emergencyNote}</p>
  </section>
</BaseLayout>

<script>
  document.querySelector<HTMLButtonElement>('[data-print]')?.addEventListener('click', () => {
    window.print();
  });
</script>

<style>
  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .head h1 {
    margin-top: 0.4rem;
  }

  .print-btn {
    flex: none;
    margin-top: 1rem;
    height: 40px;
    padding: 0 1rem;
    border-radius: var(--r-btn);
    border: 1.5px solid var(--c-border-strong);
    background: var(--c-surface);
    color: var(--c-text);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
  }

  .print-btn:hover {
    border-color: var(--c-accent);
    color: var(--c-accent-dark);
  }

  .rules {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    counter-reset: rule;
  }

  .rules li {
    padding: 1rem 1.15rem;
    border: 1.5px solid var(--c-warn-border);
    border-radius: var(--r-btn);
    background: var(--c-surface);
  }

  .rules li.is-critical {
    border-color: var(--c-danger);
  }

  .rules h3 {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .rules__level {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: var(--r-tag);
    background: var(--c-warn-soft);
    color: var(--c-warn-text);
  }

  .rules li.is-critical .rules__level {
    background: #fee2e2;
    color: #991b1b;
  }

  .rules p {
    margin: 0;
    font-size: 0.93rem;
    color: var(--c-text-muted);
  }

  .dont {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.35rem;
  }

  .emergency {
    margin-top: 2.5rem;
    padding: 1.35rem;
    border: 1px solid var(--c-warn-border);
    border-radius: var(--r-btn);
    background: var(--c-warn-soft);
  }

  .emergency h2 {
    margin-top: 0;
  }

  .emergency ol {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.35rem;
  }

  .emergency__note {
    margin: 1rem 0 0;
    font-weight: 600;
    font-size: 0.93rem;
  }

  @media print {
    .print-btn {
      display: none;
    }
  }
</style>
