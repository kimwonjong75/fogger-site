---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BuyCTA from '../../components/BuyCTA.astro';
import FactTable from '../../components/FactTable.astro';
import Pic from '../../components/Pic.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import SafetyBox from '../../components/SafetyBox.astro';
import ShippingNote from '../../components/ShippingNote.astro';
import ShopReferral from '../../components/ShopReferral.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import {
  EFFICACY,
  FILL_RATIO_LABEL,
  HEAT_SOURCE,
  MEDIA_LABEL,
  PRODUCTS,
  PRODUCT_TYPE,
  MEDIA_SPECS,
  SPRAY_MODES,
  STORAGE,
  USE_VENUE,
  WORK_REFERENCE,
  workReferenceLabel,
  getProduct,
  maxFillLiters,
  priceLabel,
  shopOptionLabel,
  type Product,
} from '../../data/products';
import { getAllPublishedDocs } from '../../lib/content';
import { productSchema } from '../../lib/schema';
import { HOWTO_VIDEO, LONG_NOZZLE_VIDEO } from '../../data/media';

export const getStaticPaths = (() =>
  PRODUCTS.map((product) => ({
    params: { id: product.id },
    props: { product },
  }))) satisfies GetStaticPaths;

interface Props {
  product: Product;
}

const { product } = Astro.props;
const url = `/products/${product.id}/`;

const facts = [
  { label: '제품명', value: '블루가드 연막소독기' },
  { label: '형식', value: PRODUCT_TYPE },
  { label: '공식 옵션명', value: product.officialLabel },
  { label: '탱크 용량', value: `${product.tankLiters}L` },
  {
    label: '최대 충전량',
    value: `${maxFillLiters(product.tankLiters)}L`,
    note: `탱크 용량의 ${FILL_RATIO_LABEL} 상한을 적용한 값입니다.`,
  },
  { label: '크기', value: `${product.dimensionsMm} (mm)` },
  { label: '노즐', value: product.nozzle },
  { label: '분사 모드', value: SPRAY_MODES, note: '연료를 바꿔 모드를 전환합니다.' },
  { label: '분사 방식', value: product.sprayMode },
  {
    label: '작업 기준',
    value: workReferenceLabel(),
    note: WORK_REFERENCE.note,
  },
  { label: '어깨끈', value: product.shoulderStrap ? '포함' : '미포함' },
  { label: '작동 방식', value: HEAT_SOURCE },
  { label: '사용 연료', value: MEDIA_LABEL },
  { label: '효능', value: EFFICACY },
  { label: '사용 장소', value: USE_VENUE.label, note: USE_VENUE.condition },
  { label: '보관 방법', value: STORAGE },
  { label: '보조주입구', value: '작동 중 사용 금지' },
];

const price = priceLabel(product);

const PRIMARY_FACT_LABELS = ['공식 옵션명', '탱크 용량', '최대 충전량', '크기', '노즐', '어깨끈'];
const primaryFacts = facts.filter((f) => PRIMARY_FACT_LABELS.includes(f.label));
const secondaryFacts = facts.filter((f) => !PRIMARY_FACT_LABELS.includes(f.label));

const base = product.basedOn ? getProduct(product.basedOn) : null;
const related = (await getAllPublishedDocs()).slice(0, 3);
---

<BaseLayout
  title={product.seoTitle}
  description={`${product.tagline} 탱크 ${product.tankLiters}L, 최대 충전량 ${maxFillLiters(product.tankLiters)}L. 구성품과 사용 조건, 공식몰 주문 옵션을 확인하세요.`}
  canonicalPath={url}
  ogImage="/og/og-products.png"
  crumbs={[
    { name: '제품', href: '/products/' },
    { name: product.officialLabel, href: url },
  ]}
  schemaNodes={[productSchema(product)]}
  stickyBuy="model-guide"
>
  <article>
    <h1>{product.name}</h1>
    <p class="lede">{product.tagline}</p>

    <section class="model-guide" id="model-guide" aria-labelledby="model-guide-heading" tabindex="-1">
      <Pic
        src={product.image}
        alt={product.imageAlt}
        width={560}
        height={560}
        priority
        sizes="(max-width: 720px) 100vw, (max-width: 1160px) 50vw, 560px"
        class="product-hero"
      />
      <div class="model-guide__copy">
        <h2 id="model-guide-heading">{product.officialLabel}의 주요 사용처</h2>
        <ul class="plain">
          {product.bestFor.map((item) => <li>{item}</li>)}
        </ul>
        <dl class="model-guide__facts">
          <div><dt>탱크 용량</dt><dd>{product.tankLiters}L</dd></div>
          <div><dt>노즐</dt><dd>{product.nozzle}</dd></div>
          <div><dt>어깨끈</dt><dd>{product.shoulderStrap ? '포함' : '미포함'}</dd></div>
        </dl>
        {base && (
          <p class="variant-note">
            <a href={`/products/${base.id}/`}>{base.officialLabel}</a> 본체에 롱노즐을 더한 구성입니다.
          </p>
        )}
        <div class="buy-row">
          <a class="buy-row__link" href="/compare/">다른 모델과 비교</a>
          <a
            class="buy-row__link"
            href="#purchase-guide"
            data-ga-event="model_select"
            data-ga-model={product.officialLabel}
            data-ga-product-id={product.id}
            data-ga-context="product_detail_guide"
          >가격과 주문 옵션 보기</a>
        </div>
      </div>
    </section>

    <h2>사양</h2>
    <FactTable rows={primaryFacts} caption={`${product.officialLabel} 핵심 사양`} />
    <details class="spec-more">
      <summary>전체 사양 보기 ({secondaryFacts.length}개 항목 더)</summary>
      <FactTable rows={secondaryFacts} caption={`${product.officialLabel} 전체 사양`} />
    </details>

    {
      product.includes.length > 0 && (
        <>
          <h2>구성품</h2>
          <ul class="plain">
            {product.includes.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </>
      )
    }

    <h2>실내에서도 쓸 수 있나요?</h2>
    <ul class="venue-list">
      {MEDIA_SPECS.map((medium) => (
        <li>
          <strong>{medium.name}</strong> — {medium.venueLabel}
          <span>{medium.detail}</span>
        </li>
      ))}
    </ul>
    <p class="venue-note">
      {USE_VENUE.condition} 실제 허용 장소와 대상 해충은 함께 쓰는 약제의 표시사항이
      정하므로, 작업 전에 라벨을 먼저 확인하세요.
    </p>

    <SafetyBox />

    <h2>공식 사용방법 영상</h2>
    <VideoEmbed video={HOWTO_VIDEO} />

    {
      product.id === 'bf-102-long-nozzle' && (
        <>
          <h2>롱노즐 분사 촬영</h2>
          <VideoEmbed video={LONG_NOZZLE_VIDEO} />
        </>
      )
    }

    <section class="closing" id="purchase-guide" aria-labelledby="purchase-heading" tabindex="-1">
      <h2 id="purchase-heading">{product.officialLabel} 가격과 주문 옵션</h2>
      {price && <p class="closing__price">공식몰 판매가 <strong>{price}</strong></p>}
      <p>세 모델은 공식몰의 같은 상품에서 판매합니다.</p>
      <ol>
        <li>상품 화면의 ‘옵션을 선택해 주세요’를 열고 <strong>‘{shopOptionLabel(product)}’</strong> 옵션을 직접 선택하세요.</li>
        <li>선택한 옵션명과 최종 결제 금액을 확인하고 주문하세요.</li>
      </ol>
      <ShippingNote />
      <div class="buy-row">
        <BuyCTA productId={product.id} content={`product_${product.id}_bottom`} label={`공식몰에서 ${product.officialLabel} 선택하기`} />
        <a class="buy-row__link" href="/safety/">안전수칙 보기</a>
      </div>
    </section>

    <RelatedGuides docs={related} title="사용 전에 읽어두면 좋은 문서" />
  </article>

  <ShopReferral destination="detail" />
</BaseLayout>

<style>
  .model-guide, .closing {
    scroll-margin-block: 7.5rem 5rem;
  }

  .model-guide {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.25rem, 4vw, 3rem);
  }

  .model-guide__copy h2 {
    margin-top: 0;
  }

  .model-guide__facts {
    display: grid;
    gap: 0.45rem;
    margin: 1.25rem 0;
  }

  .model-guide__facts div {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 0.5rem;
    border-bottom: 1px solid var(--c-border);
    padding-bottom: 0.45rem;
  }

  .model-guide__facts dt {
    color: var(--c-text-muted);
  }

  .model-guide__facts dd {
    margin: 0;
    font-weight: 600;
  }

  article :global(.product-hero) {
    width: 100%;
    max-width: 560px;
    height: auto;
    border-radius: var(--r-card);
    display: block;
    margin: 0 auto;
    background: var(--c-surface-alt);
  }

  .buy-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin: 1.25rem 0;
  }

  .buy-row__link {
    font-weight: 600;
    font-size: 0.94rem;
  }

  .variant-note {
    padding: 0.85rem 1rem;
    border-radius: var(--r-btn);
    background: var(--c-surface-alt);
    border: 1px solid var(--c-border);
    font-size: 0.92rem;
    color: var(--c-text-muted);
  }

  .plain {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.3rem;
  }

  .venue-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .venue-list li {
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-btn);
    background: var(--c-surface-alt);
    font-size: 0.9rem;
  }

  .venue-list span {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.84rem;
    color: var(--c-text-muted);
  }

  .venue-note {
    margin: 0.75rem 0 0;
    font-size: 0.87rem;
    color: var(--c-text-muted);
  }

  .closing {
    margin-top: 2.5rem;
    padding: 1.35rem;
    border: 1px solid var(--c-accent);
    border-radius: var(--r-btn);
    background: var(--c-accent-soft);
  }

  .closing h2 {
    margin-top: 0;
  }

  .closing ol {
    padding-left: 1.35rem;
  }

  .closing__price strong {
    margin-left: 0.35rem;
    font-size: 1.25em;
  }

  .spec-more {
    margin: -0.5rem 0 1.5rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-btn);
    background: var(--c-surface);
  }

  .spec-more summary {
    cursor: pointer;
    padding: 0.85rem 1rem;
    font-weight: 600;
    font-size: 0.93rem;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--c-text-muted);
  }

  .spec-more summary::-webkit-details-marker {
    display: none;
  }

  .spec-more summary::after {
    content: '+';
    flex: none;
    font-weight: 400;
  }

  .spec-more[open] summary::after {
    content: '−';
  }

  .spec-more :global(.fact-table) {
    margin: 0;
    padding: 0 1rem 1rem;
  }

  @media (max-width: 720px) {
    .model-guide, .closing {
      scroll-margin-block-start: 5rem;
    }

    .model-guide {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
