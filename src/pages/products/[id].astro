---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BuyCTA from '../../components/BuyCTA.astro';
import FactTable from '../../components/FactTable.astro';
import Pic from '../../components/Pic.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import SafetyBox from '../../components/SafetyBox.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import {
  EFFICACY,
  FILL_RATIO_LABEL,
  HEAT_SOURCE,
  MEDIA_LABEL,
  PRODUCTS,
  PRODUCT_TYPE,
  MEDIA_SPECS,
  SHIPPING,
  SPRAY_MODES,
  STORAGE,
  USE_VENUE,
  WORK_REFERENCE,
  getProduct,
  maxFillLiters,
  priceLabel,
  type Product,
} from '../../data/products';
import { getAllPublishedDocs } from '../../lib/content';
import { productSchema } from '../../lib/schema';
import { HOWTO_VIDEO, LONG_NOZZLE_VIDEO } from '../../data/media';

export const getStaticPaths = (() =>
  PRODUCTS.map((product) => ({
    params: { id: product.id },
    props: { product },
  }))) satisfies GetStaticPaths;

interface Props {
  product: Product;
}

const { product } = Astro.props;
const url = `/products/${product.id}/`;

const facts = [
  { label: '제품명', value: '블루가드 연막소독기' },
  { label: '형식', value: PRODUCT_TYPE },
  { label: '공식 옵션명', value: product.officialLabel },
  { label: '탱크 용량', value: `${product.tankLiters}L` },
  {
    label: '최대 충전량',
    value: `${maxFillLiters(product.tankLiters)}L`,
    note: `탱크 용량의 ${FILL_RATIO_LABEL} 상한을 적용한 값입니다.`,
  },
  { label: '크기', value: `${product.dimensionsMm} (mm)` },
  { label: '노즐', value: product.nozzle },
  { label: '분사 모드', value: SPRAY_MODES, note: '매질을 바꿔 모드를 전환합니다.' },
  { label: '분사 방식', value: product.sprayMode },
  {
    label: '작업 기준',
    value: `${WORK_REFERENCE.chargeMl.toLocaleString('ko-KR')}mL로 약 ${WORK_REFERENCE.minutes}분 · ${WORK_REFERENCE.pyeong}평`,
    note: WORK_REFERENCE.note,
  },
  { label: '어깨끈', value: product.shoulderStrap ? '포함' : '미포함' },
  { label: '작동 방식', value: HEAT_SOURCE },
  { label: '사용 매질', value: MEDIA_LABEL },
  { label: '효능', value: EFFICACY },
  { label: '사용 장소', value: USE_VENUE.label, note: USE_VENUE.condition },
  { label: '보관 방법', value: STORAGE },
  { label: '보조주입구', value: '작동 중 사용 금지' },
  { label: '배송', value: SHIPPING.label, note: SHIPPING.note },
];

const price = priceLabel(product);
if (price) facts.splice(3, 0, { label: '공식몰 정가', value: price });

/** 구매 판단에 직결되는 값만 먼저 보여주고 나머지는 접어 둔다 */
const PRIMARY_FACT_LABELS = ['공식 옵션명', '공식몰 정가', '탱크 용량', '크기', '배송'];
const primaryFacts = facts.filter((f) => PRIMARY_FACT_LABELS.includes(f.label));
const secondaryFacts = facts.filter((f) => !PRIMARY_FACT_LABELS.includes(f.label));

const base = product.basedOn ? getProduct(product.basedOn) : null;
const related = (await getAllPublishedDocs()).slice(0, 3);
---

<BaseLayout
  title={product.seoTitle}
  description={`${product.name}의 탱크 용량과 최대 충전량, 구성품, 실내외 사용 매질과 안전 기준을 공식 사양 그대로 정리했습니다.`}
  canonicalPath={url}
  ogImage="/og/og-products.png"
  crumbs={[
    { name: '제품', href: '/products/' },
    { name: product.officialLabel, href: url },
  ]}
  schemaNodes={[productSchema(product)]}
  stickyBuy={product.id}
>
  <article>
    <h1>{product.name}</h1>
    <p class="lede">{product.tagline}</p>

    <Pic
      src={product.image}
      alt={product.imageAlt}
      width={560}
      height={560}
      priority
      sizes="(max-width: 640px) 100vw, 560px"
      class="product-hero"
    />

    <div class="buy-row">
      <BuyCTA productId={product.id} content={`product_${product.id}_top`} showShipping />
      <a class="buy-row__link" href="/compare/">다른 모델과 비교</a>
    </div>

    {
      base && (
        <p class="variant-note">
          이 구성은 <a href={`/products/${base.id}/`}>{base.officialLabel}</a> 에 롱노즐을 더한 것입니다.
          본체 사양은 동일합니다.
        </p>
      )
    }

    <h2>사양</h2>
    <FactTable rows={primaryFacts} caption={`${product.officialLabel} 핵심 사양`} />
    <details class="spec-more">
      <summary>전체 사양 보기 ({secondaryFacts.length}개 항목 더)</summary>
      <FactTable rows={secondaryFacts} caption={`${product.officialLabel} 전체 사양`} />
    </details>

    {
      product.includes.length > 0 && (
        <>
          <h2>구성품</h2>
          <ul class="plain">
            {product.includes.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </>
      )
    }

    {
      product.bestFor.length > 0 && (
        <>
          <h2>주요 사용처</h2>
          <ul class="plain">
            {product.bestFor.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <h3 class="venue-heading">실내에서도 쓸 수 있나요?</h3>
          <ul class="venue-list">
            {MEDIA_SPECS.map((medium) => (
              <li>
                <strong>{medium.name}</strong> — {medium.venueLabel}
                <span>{medium.detail}</span>
              </li>
            ))}
          </ul>
          <p class="venue-note">
            {USE_VENUE.condition} 실제 허용 장소와 대상 해충은 함께 쓰는 약제의 표시사항이
            정하므로, 작업 전에 라벨을 먼저 확인하세요.
          </p>
        </>
      )
    }

    <SafetyBox />

    <h2>공식 사용방법 영상</h2>
    <VideoEmbed video={HOWTO_VIDEO} />

    {
      product.id === 'bf-102-long-nozzle' && (
        <>
          <h2>롱노즐 분사 촬영</h2>
          <VideoEmbed video={LONG_NOZZLE_VIDEO} />
        </>
      )
    }

    <section class="closing">
      <h2>{product.officialLabel}으로 결정하셨나요?</h2>
      <p>사용 전 준비 절차와 안전수칙을 먼저 확인하시길 권합니다.</p>
      <div class="buy-row">
        <BuyCTA productId={product.id} content={`product_${product.id}_bottom`} showShipping />
        <a class="buy-row__link" href="/safety/">안전수칙 보기</a>
      </div>
    </section>

    <RelatedGuides docs={related} title="사용 전에 읽어두면 좋은 문서" />
  </article>
</BaseLayout>

<style>
  article :global(.product-hero) {
    width: 100%;
    max-width: 560px;
    height: auto;
    border-radius: var(--r-card);
    display: block;
    margin: 0.5rem auto 1.5rem;
    background: var(--c-surface-alt);
  }

  .buy-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin: 1.25rem 0;
  }

  .buy-row__link {
    font-weight: 600;
    font-size: 0.94rem;
  }

  .variant-note {
    padding: 0.85rem 1rem;
    border-radius: var(--r-btn);
    background: var(--c-surface-alt);
    border: 1px solid var(--c-border);
    font-size: 0.92rem;
    color: var(--c-text-muted);
  }

  .plain {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.3rem;
  }

  .venue-heading {
    margin: 1.5rem 0 0.6rem;
    font-size: 1rem;
  }

  .venue-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .venue-list li {
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-btn);
    background: var(--c-surface-alt);
    font-size: 0.9rem;
  }

  .venue-list span {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.84rem;
    color: var(--c-text-muted);
  }

  .venue-note {
    margin: 0.75rem 0 0;
    font-size: 0.87rem;
    color: var(--c-text-muted);
  }

  .closing {
    margin-top: 2.5rem;
    padding: 1.35rem;
    border: 1px solid var(--c-accent);
    border-radius: var(--r-btn);
    background: var(--c-accent-soft);
  }

  .closing h2 {
    margin-top: 0;
  }

  .spec-more {
    margin: -0.5rem 0 1.5rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-btn);
    background: var(--c-surface);
  }

  .spec-more summary {
    cursor: pointer;
    padding: 0.85rem 1rem;
    font-weight: 600;
    font-size: 0.93rem;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--c-text-muted);
  }

  .spec-more summary::-webkit-details-marker {
    display: none;
  }

  .spec-more summary::after {
    content: '+';
    flex: none;
    font-weight: 400;
  }

  .spec-more[open] summary::after {
    content: '−';
  }

  .spec-more :global(.fact-table) {
    margin: 0;
    padding: 0 1rem 1rem;
  }
</style>
