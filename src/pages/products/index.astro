---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FactTable from '../../components/FactTable.astro';
import ModelCard from '../../components/ModelCard.astro';
import SafetyBox from '../../components/SafetyBox.astro';
import ShippingNote from '../../components/ShippingNote.astro';
import StatRow from '../../components/StatRow.astro';
import TrustBar from '../../components/TrustBar.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { BUILD_QUALITY, PRODUCTS } from '../../data/products';
import { PRODUCTS_PAGE } from '../../data/pages';
import { CUSTOMER_USE_VIDEOS, QC_VIDEOS, SPRAY_TEST_VIDEO } from '../../data/media';
import { itemListSchema } from '../../lib/schema';

/** 문구는 편집 화면(/admin/ → "제품 목록 화면")에서 고친다 — src/content/pages/products.json */
const page = PRODUCTS_PAGE;

/**
 * 조립·분사 촬영본과 신뢰 블록은 2026-08-07에 홈에서 이 페이지로 옮겼다.
 * 홈은 "왜 사야 하는가"만 답하도록 줄였고, 이 자료들은 이미 사려고 마음먹은 사람이
 * 마지막으로 확인하는 근거라서 구매 판단 페이지가 제자리다.
 */
const evidenceVideos = [...QC_VIDEOS, SPRAY_TEST_VIDEO, ...CUSTOMER_USE_VIDEOS];

const list = itemListSchema(
  '/products/',
  '블루가드 휴대용 연막소독기 라인업',
  PRODUCTS.map((product) => ({ name: product.name, href: `/products/${product.id}/` })),
);

---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  canonicalPath="/products/"
  ogImage="/og/og-products.png"
  crumbs={[{ name: '제품', href: '/products/' }]}
  schemaNodes={[list]}
  stickyBuy="generic"
>
  <p class="eyebrow">{page.eyebrow}</p>
  <h1>{page.heading}</h1>
  <p class="lede">{page.lede}</p>

  <StatRow />

  <div class="grid">
    {
      PRODUCTS.map((product) => (
        <ModelCard product={product} context="products" />
      ))
    }
  </div>

  <h2>{page.partsHeading}</h2>
  <p class="section-desc">{page.partsDesc}</p>
  <dl class="parts">
    {
      BUILD_QUALITY.map((part) => (
        <div class="parts__row">
          <dt>{part.part}</dt>
          <dd>
            <strong>{part.claim}</strong>
            <span>{part.detail}</span>
            <span class="parts__check">
              {page.partsCheckLabel} — {part.howToCheck}
            </span>
          </dd>
        </div>
      ))
    }
  </dl>

  <h2>{page.commonHeading}</h2>
  <FactTable rows={page.commonFacts} footnote={page.commonFootnote} />

  <ShippingNote />

  <h2>{page.videoHeading}</h2>
  <p class="section-desc">{page.videoDesc}</p>
  <div class="video-row">
    {evidenceVideos.map((video) => <VideoEmbed video={video} />)}
  </div>

  <SafetyBox />

  <TrustBar />

  <p class="more"><a href={page.moreLink.href}>{page.moreLink.label}</a></p>
</BaseLayout>

<style>
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 1.5rem 0 0.5rem;
  }

  .section-desc {
    margin: 0 0 1.25rem;
    color: var(--c-text-muted);
    font-size: 0.97rem;
    max-width: 60ch;
  }

  .parts {
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .parts__row {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.5rem 1rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-btn);
    background: var(--c-surface);
  }

  .parts__row dt {
    font-weight: 700;
    font-size: 0.95rem;
  }

  .parts__row dd {
    margin: 0;
    display: grid;
    gap: 0.15rem;
  }

  .parts__row strong {
    font-size: 1rem;
    letter-spacing: -0.015em;
  }

  .parts__row span {
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--c-text-muted);
  }

  .parts__check {
    margin-top: 0.2rem;
    padding-top: 0.4rem;
    border-top: 1px dotted var(--c-border);
  }

  .video-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.9rem;
  }

  .more {
    font-weight: 600;
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    /* 부품명 칸(7.5rem)을 남기면 설명이 160px로 눌려 한 줄에 다섯 글자씩 끊긴다 */
    .parts__row {
      grid-template-columns: 1fr;
      row-gap: 0.35rem;
    }
  }
</style>
