---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuyCTA from '../components/BuyCTA.astro';
import { BUY_CTA_LABEL_SHORT } from '../data/site';
import ModelSpecTable from '../components/ModelSpecTable.astro';
import SafetyBox from '../components/SafetyBox.astro';
import ShippingNote from '../components/ShippingNote.astro';
import { PRODUCTS, maxFillLiters } from '../data/products';
import { COMPARE_PAGE } from '../data/pages';
import { inlineParts } from '../lib/page-content';

/** 문구는 편집 화면(/admin/ → "모델비교 화면")에서 고친다 — src/content/pages/compare.json */
const page = COMPARE_PAGE;
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  canonicalPath="/compare/"
  ogImage="/og/og-compare.png"
  crumbs={[{ name: '모델비교', href: '/compare/' }]}
  stickyBuy="generic"
>
  <p class="eyebrow">{page.eyebrow}</p>
  <h1>{page.heading}</h1>
  <p class="lede">{page.lede}</p>

  <ModelSpecTable caption={page.specTableCaption} footnote={page.specTableFootnote} />

  <h2>{page.pickerHeading}</h2>
  <div class="picker">
    {
      PRODUCTS.map((product) => (
        <section class="picker__item">
          <h3>{product.officialLabel}</h3>
          <p class="picker__spec">
            탱크 {product.tankLiters}L · 최대충전 {maxFillLiters(product.tankLiters)}L
          </p>
          <ul>
            {product.bestFor.map((item) => <li>{item}</li>)}
          </ul>
          <div class="picker__actions">
            <a
              href={`/products/${product.id}/`}
              data-ga-event="model_select"
              data-ga-model={product.officialLabel}
              data-ga-product-id={product.id}
              data-ga-context="compare"
            >
              {page.pickerDetailLabel}
            </a>
            <BuyCTA productId={product.id} content={`compare_${product.id}`} label={BUY_CTA_LABEL_SHORT} variant="secondary" />
          </div>
        </section>
      ))
    }
  </div>

  <h2>{page.summaryHeading}</h2>
  <ul class="summary">
    {
      /* **별표** 로 감싼 부분이 굵게 나온다 — page-content.ts 의 inlineParts 참조 */
      page.summary.map((text) => (
        <li>
          {inlineParts(text).map((part) =>
            part.kind === 'bold' ? <strong>{part.text}</strong> : part.text,
          )}
        </li>
      ))
    }
  </ul>

  <ShippingNote />

  <SafetyBox title={page.safetyBoxTitle} />
</BaseLayout>

<style>
  .picker {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.25rem 0 0;
  }

  .picker__item {
    padding: 1.15rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-btn);
    background: var(--c-surface);
  }

  .picker__item h3 {
    margin: 0 0 0.25rem;
  }

  .picker__spec {
    margin: 0 0 0.75rem;
    font-size: 0.86rem;
    color: var(--c-text-muted);
  }

  .picker__item ul {
    margin: 0 0 1rem;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.25rem;
    font-size: 0.9rem;
  }

  .picker__actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .summary {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.5rem;
  }

  @media (max-width: 900px) {
    .picker {
      grid-template-columns: 1fr;
    }
  }
</style>
