---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuyCTA from '../components/BuyCTA.astro';
import Faq from '../components/Faq.astro';
import ModelSpecTable from '../components/ModelSpecTable.astro';
import Pic from '../components/Pic.astro';
import SafetyBox from '../components/SafetyBox.astro';
import ShippingNote from '../components/ShippingNote.astro';
import ShopReferral from '../components/ShopReferral.astro';
import { priceLabel, PRODUCTS, PRICES_CONFIRMED, shopOptionLabel } from '../data/products';
import { COMPARE_PAGE } from '../data/pages';
import { inlineParts } from '../lib/page-content';
import { faqSchema } from '../lib/schema';

/** 문구는 편집 화면(/admin/ → "모델비교 화면")에서 고친다 — src/content/pages/compare.json */
const page = COMPARE_PAGE;
const url = '/compare/';
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  canonicalPath={url}
  ogImage="/og/og-compare.png"
  crumbs={[{ name: '모델비교', href: url }]}
  schemaNodes={[faqSchema(url, page.faq)]}
  stickyBuy="model-guide"
>
  <p class="eyebrow">{page.eyebrow}</p>
  <h1>{page.heading}</h1>
  <p class="lede">{page.lede}</p>

  <section id="model-guide" aria-labelledby="picker-heading" tabindex="-1">
    <h2 id="picker-heading">{page.pickerHeading}</h2>
    <div class="picker">
      {PRODUCTS.map((product, index) => (
        <article class="picker__item">
          <div class="picker__photo">
            <Pic
              src={product.image}
              alt={product.imageAlt}
              width={320}
              height={320}
              sizes="(max-width: 720px) 32vw, 320px"
              priority={index === 0}
            />
          </div>
          <div class="picker__copy">
            <h3>{product.officialLabel}</h3>
            <p class="picker__use">{product.bestFor.join(' · ')}</p>
            <p class="picker__spec">
              탱크 {product.tankLiters}L · {product.longNozzle ? product.nozzle : product.shoulderStrap ? '어깨끈 포함' : '어깨끈 미포함'}
            </p>
          </div>
          <div class="picker__actions">
            <a class="picker__guide" href={`#buy-${product.id}`}
              data-ga-event="model_select" data-ga-model={product.officialLabel}
              data-ga-product-id={product.id} data-ga-context="compare_guide">
              {product.officialLabel} 구매 안내
            </a>
            <a href={`/products/${product.id}/`}
              aria-label={`${product.officialLabel} ${page.pickerDetailLabel}`}
              data-ga-event="model_select" data-ga-model={product.officialLabel}
              data-ga-product-id={product.id} data-ga-context="compare">
              {page.pickerDetailLabel}
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <h2>{page.summaryHeading}</h2>
  <ul class="summary">
    {
      /* **별표** 로 감싼 부분이 굵게 나온다 — page-content.ts 의 inlineParts 참조 */
      page.summary.map((text) => (
        <li>
          {inlineParts(text).map((part) =>
            part.kind === 'bold' ? <strong>{part.text}</strong> : part.text,
          )}
        </li>
      ))
    }
  </ul>

  <h2>전체 사양 비교</h2>
  <ModelSpecTable caption={page.specTableCaption} footnote={page.specTableFootnote} />
  <SafetyBox title={page.safetyBoxTitle} />
  <Faq items={page.faq} />

  <section id="purchase-guide" aria-labelledby="purchase-heading">
    <h2 id="purchase-heading">공식몰 가격과 주문 옵션</h2>
    <p>세 모델은 공식몰의 같은 상품에서 판매합니다. 원하는 구성의 옵션명을 확인한 뒤 상품 화면에서 직접 선택하세요.</p>
    <div class="purchase-options">
      {PRODUCTS.map((product) => (
        <article class="purchase-option" id={`buy-${product.id}`} tabindex="-1" aria-labelledby={`order-${product.id}`}>
          <div>
            <h3 id={`order-${product.id}`}>{product.officialLabel}</h3>
            {PRICES_CONFIRMED && <p class="purchase-option__price">공식몰 판매가 <strong>{priceLabel(product)}</strong></p>}
            <p>공식몰에서 선택할 옵션 <strong>‘{shopOptionLabel(product)}’</strong></p>
          </div>
          <BuyCTA productId={product.id} content={`compare_${product.id}`} label={`공식몰에서 ${product.officialLabel} 선택하기`} />
        </article>
      ))}
    </div>
    <ShippingNote />
  </section>
  <ShopReferral destination="compare" />
</BaseLayout>

<style>
  #model-guide, .purchase-option {
    scroll-margin-block: 7.5rem 5rem;
  }

  #picker-heading {
    margin-top: 2rem;
  }

  .picker {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .picker__item {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-card);
    background: var(--c-surface);
  }

  .picker__photo {
    display: grid;
    place-items: center;
    margin-bottom: 1rem;
  }

  .picker__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 12rem;
    object-fit: contain;
  }

  .picker__item h3, .purchase-option h3 {
    margin: 0 0 0.25rem;
  }

  .picker__use, .picker__spec, .purchase-option p { margin: 0.3rem 0; }
  .picker__spec { font-size: 0.9rem; color: var(--c-text-muted); }

  .picker__actions {
    display: flex;
    align-items: center;
    gap: 0 0.9rem;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 0.65rem;
    font-size: 0.9rem;
  }

  .picker__actions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .picker__guide {
    padding: 0 0.85rem;
    background: var(--c-accent-soft);
    border-radius: var(--r-sm);
    font-weight: 700;
    text-decoration: none;
  }

  .picker__guide:hover { text-decoration: underline; }

  .purchase-options {
    border-top: 1px solid var(--c-border-strong);
  }

  .purchase-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.7rem 1.5rem;
    padding: 1.2rem;
    border-bottom: 1px solid var(--c-border);
  }

  .purchase-option:target {
    background: var(--c-accent-soft);
    box-shadow: inset 4px 0 var(--c-accent-dark);
  }

  .purchase-option__price { color: var(--c-text-muted); }
  .purchase-option__price strong { color: var(--c-text); }

  .purchase-option:focus-visible, #model-guide:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 2px;
  }

  .summary {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.5rem;
  }

  @media (max-width: 720px) {
    #model-guide, .purchase-option { scroll-margin-block: 5rem; }
    .picker { grid-template-columns: 1fr; }
    .picker__item {
      display: grid;
      grid-template-columns: minmax(0, 32%) 1fr;
      align-items: center;
      column-gap: 1rem;
    }
    .picker__photo { margin: 0; }
    .picker__actions {
      grid-column: 1 / -1;
      margin: 0;
    }
  }
</style>
