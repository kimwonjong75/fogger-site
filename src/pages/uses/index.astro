---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocList from '../../components/DocList.astro';
import { COLLECTION_META, docHref, getPublishedDocs } from '../../lib/content';
import { USES_PAGE } from '../../data/pages';
import { inlineParts } from '../../lib/page-content';
import { itemListSchema } from '../../lib/schema';

const meta = COLLECTION_META.uses;
const docs = await getPublishedDocs('uses');

/** 문구는 편집 화면(/admin/ → "활용사례 목록 화면")에서 고친다 — src/content/pages/uses.json */
const page = USES_PAGE;

const list = itemListSchema(
  meta.href,
  meta.title,
  docs.map((doc) => ({ name: doc.data.title, href: docHref('uses', doc.id) })),
);
---

<BaseLayout
  title={page.seo.title}
  description={page.lede}
  canonicalPath={meta.href}
  ogImage="/og/og-uses.png"
  crumbs={[{ name: meta.label, href: meta.href }]}
  schemaNodes={[list]}
  noindex={docs.length === 0}
>
  <h1>{page.heading}</h1>
  <p class="lede">{page.lede}</p>

  <DocList docs={docs} />

  <p class="more">
    {
      inlineParts(page.moreText).map((part) =>
        part.kind === 'link' ? <a href={part.href}>{part.text}</a> : part.text,
      )
    }
  </p>
</BaseLayout>

<style>
  .more {
    margin-top: 2rem;
    font-size: 0.93rem;
    color: var(--c-text-muted);
  }
</style>
