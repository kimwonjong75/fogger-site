---
import heroImage from '../assets/photo-bf-102.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import BuyCTA from '../components/BuyCTA.astro';
import ModelCard from '../components/ModelCard.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import Pic from '../components/Pic.astro';
import SafetyBox from '../components/SafetyBox.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import {
  BUILD_QUALITY,
  DOMESTIC_PARTS_PERCENT,
  MEDIA_SPECS,
  PRODUCTS,
  SPRAY_MODES,
  WORK_REFERENCE,
} from '../data/products';
import { HOWTO_VIDEO, VIDEO_PUBLISHED_DATE } from '../data/media';
import { itemListSchema, organizationSchema, videoSchema, websiteSchema } from '../lib/schema';

/**
 * 홈은 "왜 이 제품을 사야 하는가"만 답한다.
 *
 * 사용법 10단계·매질 조건·가이드 목록·문제해결 목록은 홈에서 뺐다. 삭제가 아니라
 * 이동이다 — 10단계와 HowTo 구조화데이터는 /guides/로 함께 옮겼고(둘이 떨어지면
 * 검색에서 절차가 인식되지 않는다), 매질 조건은 /guides/choose-media/와 /safety/에
 * 이미 같은 내용이 있다.
 *
 * 배경: 개편 전 홈은 한글 2,369자·모바일 13.5화면이었고 사진 비중은 29%였다.
 * 정보가 부족해서가 아니라 읽어야 해서 이탈한다는 판단(2026-08-07 사장님 지시).
 */

/** 홈에는 눈으로 확인 가능한 네 곳만 낸다. 가스 연결부는 제품 상세에서 다룬다 */
const HOME_PARTS = BUILD_QUALITY.slice(0, 4);

const base = PRODUCTS[0];
const large = PRODUCTS[1];
/** 외형 표기 "465×265×180" 의 가장 긴 변 — 소형화 주장의 근거 수치 */
const longestSideMm = base.dimensionsMm.split('×')[0];

const videoMin = Math.floor(HOWTO_VIDEO.durationSec / 60);
const videoSec = HOWTO_VIDEO.durationSec % 60;
const videoLength = videoMin > 0 ? `${videoMin}분 ${videoSec}초` : `${videoSec}초`;

const productList = itemListSchema(
  '/products/',
  '블루가드 휴대용 연막소독기 라인업',
  PRODUCTS.map((product) => ({ name: product.name, href: `/products/${product.id}/` })),
);

/** 대표 사용법 영상 1건만 구조화데이터로 낸다 — 나머지는 보조 클립이라 넣지 않는다 */
const howToVideo = videoSchema({
  name: HOWTO_VIDEO.title,
  description: HOWTO_VIDEO.caption,
  contentUrl: HOWTO_VIDEO.src,
  thumbnailUrl: HOWTO_VIDEO.poster.src,
  durationSec: HOWTO_VIDEO.durationSec,
  uploadDate: VIDEO_PUBLISHED_DATE,
});
---

<BaseLayout
  title="가정용 휴대용 연막소독기 블루가드"
  description="차량 장비가 들어가기 어려운 좁은 현장을 위해 소형화한 국산 휴대용 연막소독기. 연막·연무 겸용 사양과 눈으로 확인하는 부품 기준을 정리했습니다."
  canonicalPath="/"
  ogImage="/og/og-default.png"
  crumbs={[{ name: '홈', href: '/' }]}
  schemaNodes={[organizationSchema(), websiteSchema(), productList, howToVideo]}
  stickyBuy="generic"
>
  <Fragment slot="hero">
    <div class="full-bleed hero-band">
      <div class="full-bleed__inner hero">
        <div class="hero__text">
          <p class="eyebrow eyebrow--ink">부품 {DOMESTIC_PARTS_PERCENT}% 국산</p>
          <h1>차량 장비가 못 들어가는 곳까지,<br />손에 드는 국산 연막소독기</h1>
          <p class="lede">
            국산 기술로 줄인 부탄가스 연막기입니다. 마당·창고·축사·하수구까지 직접 들고
            이동해 분사합니다.
          </p>
          <div class="hero__actions">
            <a class="hero__cta hero__cta--primary" href="#works">
              작동 영상 보기 · {videoLength}
            </a>
            <a class="hero__cta hero__cta--secondary" href="#models">내게 맞는 모델 찾기</a>
          </div>
          <p class="hero__media">
            한 손 휴대 · {SPRAY_MODES} · {base.officialLabel} {base.tankLiters}L / {
              large.officialLabel
            } {large.tankLiters}L
          </p>
        </div>

        <div class="hero__figure">
          <Pic
            src={heroImage}
            alt="블루가드 연막소독기 대용량 — 흰색 연료통과 스테인리스 배럴이 보이는 본체 제품 사진"
            width={440}
            height={440}
            priority
            sizes="(max-width: 900px) 80vw, 440px"
            class="hero__image"
          />
        </div>
      </div>
    </div>
  </Fragment>

  <!-- S2 소형화 — 사장님이 가장 강조하고 싶어 한 메시지 -->
  <section id="works" aria-labelledby="works-h">
    <h2 id="works-h">차량까지 동원할 필요 없는 현장을 위해</h2>
    <p class="section-desc">
      대형 장비가 들어가기 어려운 좁은 곳에서도 작업자가 직접 들고 이동합니다.
    </p>

    <div class="works">
      <PhotoSlot
        no="⑫"
        what="실제 작업 전경"
        note="마당·창고·축사 중 한 곳에서 사람이 들고 이동하며 분사하는 전신 컷"
        ratio="4 / 3"
      />
      <ul class="benefits">
        <li>
          <strong>한 손으로 듭니다</strong>
          <span>가장 긴 변 {longestSideMm}mm. 오래 작업할 때는 어깨끈을 씁니다.</span>
        </li>
        <li>
          <strong>{SPRAY_MODES}</strong>
          <span>
            넣는 매질만 바꾸면 모드가 바뀝니다 — {
              MEDIA_SPECS.map((m) => `${m.name} ${m.venueLabel}`).join(', ')
            }.
          </span>
        </li>
        <li>
          <strong>
            <span class="num">{WORK_REFERENCE.chargeMl.toLocaleString('ko-KR')}</span>mL로 약
            <span class="num">{WORK_REFERENCE.minutes}</span>분 ·
            <span class="num">{WORK_REFERENCE.pyeong}</span>평
          </strong>
          <span>{WORK_REFERENCE.note}</span>
        </li>
      </ul>
    </div>

    <VideoEmbed video={HOWTO_VIDEO} />

    <p class="section-more">
      <a href="/guides/">사용 순서 10단계 보기</a> ·
      <a href="/guides/choose-media/">매질 고르는 법</a>
    </p>
  </section>

  <!-- S3 부품 — 이번 개편의 핵심 섹션 -->
  <section class="panel panel--ink parts" aria-labelledby="parts-h">
    <h2 id="parts-h">겉은 비슷해도, 안쪽은 다릅니다</h2>
    <p class="parts__desc">
      가격표보다 먼저 확인할 네 곳입니다. 저희 것부터 열어서 보여드립니다.
    </p>

    <div class="parts__grid">
      {
        HOME_PARTS.map((part, i) => (
          <article class="part">
            <PhotoSlot
              no={['③', '④', '⑤', '⑥'][i]}
              what={`${part.part} 클로즈업`}
              note="네 컷을 같은 배경·조명·거리로 한 번에 촬영"
              ratio="1 / 1"
            />
            <p class="part__name">{part.part}</p>
            <p class="part__claim">{part.claim}</p>
            <p class="part__detail">{part.detail}</p>
            <p class="part__check">
              <span>확인법</span>
              {part.howToCheck}
            </p>
          </article>
        ))
      }
    </div>

    <p class="parts__close">1~2만원의 차이보다, 오래 쓸 구조를 먼저 보세요.</p>
  </section>

  <!-- S4 모델 -->
  <section id="models" aria-labelledby="models-h">
    <h2 id="models-h">어디에 쓰실 건가요</h2>
    <p class="section-desc">
      마당이면 기본형, 넓은 곳이면 대용량, 손이 안 닿는 곳이면 롱노즐입니다.
    </p>
    <div class="grid grid--3">
      {
        PRODUCTS.map((product) => (
          <ModelCard product={product} context="home" withBuy={false} compact />
        ))
      }
    </div>
    <p class="section-more">
      <a href="/compare/">세 구성 비교표 보기</a> · <a href="/products/">제품 전체 보기</a>
    </p>
  </section>

  <!-- S5 안전 + 구매 -->
  <section aria-labelledby="close-h">
    <h2 id="close-h">사진만 보지 말고, 부품과 작동 모습을 확인하세요</h2>
    <p class="section-desc">
      실제 구조와 분사 영상을 확인한 뒤 현장에 맞는 구성을 고르시면 됩니다.
    </p>
    <SafetyBox title="쓰기 전에 이것만은" compact only={['venue', 'fill-limit', 'aux-inlet']} />
    <div class="close-actions">
      <BuyCTA content="home_close" />
      <a class="close-actions__link" href="/safety/">전체 안전수칙 보기 →</a>
    </div>
    <p class="section-more section-more--quiet">
      <a href="/guides/">사용법</a> · <a href="/uses/">활용사례</a> ·
      <a href="/troubleshooting/">문제해결</a>
    </p>
  </section>
</BaseLayout>

<style>
  .hero-band {
    background: linear-gradient(160deg, var(--c-ink), var(--c-ink-2) 70%);
    color: var(--c-on-ink);
    padding: clamp(2rem, 5vw, 3.5rem) 0 clamp(2.5rem, 6vw, 4rem);
  }

  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .hero__text h1 {
    margin-top: 0;
    color: #fff;
  }

  .hero__text .lede {
    color: var(--c-on-ink-dim);
  }

  .eyebrow--ink {
    color: #ffe9a8;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 1.4rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.98rem;
    text-decoration: none;
  }

  .hero__cta--primary {
    background: var(--c-yellow);
    color: #1a1400;
  }

  .hero__cta--primary:hover {
    background: var(--c-yellow-dark);
  }

  .hero__cta--secondary {
    border: 1.5px solid rgb(255 255 255 / 0.45);
    color: #fff;
  }

  .hero__cta--secondary:hover {
    background: rgb(255 255 255 / 0.1);
  }

  .hero__media {
    margin: 1.1rem 0 0;
    font-size: 0.85rem;
    color: var(--c-on-ink-dim);
  }

  /* 제품 사진을 흰 카드에 가두지 않고, 아래에 접지 그림자만 깔아 배경과 자연스럽게 잇는다 */
  .hero__figure {
    position: relative;
  }

  .hero__figure::after {
    content: '';
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -6%;
    height: 18%;
    background: radial-gradient(ellipse, rgb(0 0 0 / 0.45), transparent 70%);
    filter: blur(4px);
  }

  .hero :global(.hero__image) {
    position: relative;
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 18px 22px rgb(0 0 0 / 0.35));
  }

  .grid {
    display: grid;
    gap: 1rem;
  }

  .grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .section-desc {
    margin: 0 0 1.25rem;
    color: var(--c-text-muted);
    font-size: 0.97rem;
    max-width: 60ch;
  }

  .section-more {
    margin: 1.25rem 0 0;
    font-size: 0.93rem;
    font-weight: 700;
  }

  .section-more--quiet {
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--c-text-muted);
  }

  .section-more a {
    text-decoration: none;
  }

  .section-more a:hover {
    text-decoration: underline;
  }

  /* 소형화 — 사진과 근거 3개를 나란히 두고 문단을 쓰지 않는다 */
  .works {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1rem, 3vw, 1.75rem);
    align-items: start;
    margin-bottom: 1.5rem;
  }

  .benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
    align-content: center;
  }

  .benefits li {
    display: grid;
    gap: 0.2rem;
    padding-left: 0.9rem;
    border-left: 3px solid var(--c-yellow);
  }

  .benefits strong {
    font-size: 1.02rem;
    letter-spacing: -0.015em;
  }

  .benefits span {
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--c-text-muted);
  }

  /* 부품 — 어두운 패널로 세워 이 섹션에만 시선이 멈추게 한다 */
  .parts__desc {
    margin: 0 0 1.5rem;
    color: var(--c-on-ink-dim);
    font-size: 0.97rem;
    max-width: 60ch;
  }

  .parts__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .part {
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }

  .part__name {
    margin: 0.6rem 0 0;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--c-on-ink-dim);
  }

  .part__claim {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .part__detail {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--c-on-ink-dim);
  }

  .part__check {
    margin: 0.35rem 0 0;
    padding-top: 0.55rem;
    border-top: 1px solid rgb(255 255 255 / 0.16);
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--c-on-ink);
  }

  .part__check span {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--c-yellow);
    margin-bottom: 0.15rem;
  }

  .parts__close {
    margin: 1.75rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.16);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .close-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .close-actions__link {
    font-size: 0.93rem;
    font-weight: 700;
    text-decoration: none;
  }

  .close-actions__link:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .hero,
    .grid--3,
    .works {
      grid-template-columns: 1fr;
    }

    .hero__figure {
      max-width: 320px;
      margin: 0 auto;
    }

    /*
     * 모바일에서도 2열을 유지한다.
     * 1열로 떨어뜨리면 네 곳이 세로로 2,300px 늘어져 "네 곳"이 한눈에 안 들어온다.
     * 이 섹션은 개별 사진을 뜯어보는 자리가 아니라 네 곳이 있다는 걸 보여주는 자리다
     * (자세한 값은 /products/의 부품 표에 있다).
     */
    .parts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
  }
</style>
