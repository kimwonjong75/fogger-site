---
import heroImage from '../assets/photo-bf-102.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import ModelCard from '../components/ModelCard.astro';
import PhotoRequest from '../components/PhotoRequest.astro';
import Pic from '../components/Pic.astro';
import SafetyBox from '../components/SafetyBox.astro';
import ShippingNote from '../components/ShippingNote.astro';
import StatRow from '../components/StatRow.astro';
import TrustBar from '../components/TrustBar.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import { MEDIA_LABEL, PRODUCTS } from '../data/products';
import { CUSTOMER_USE_VIDEOS, HOWTO_VIDEO, QC_VIDEOS } from '../data/media';
import { HOME_PHOTO_REQUESTS } from '../data/photo-requests';
import { OFFICIAL_STORE_PRODUCT_URL } from '../data/site';
import { COLLECTION_META, docHref, getPublishedDocs } from '../lib/content';
import { organizationSchema, websiteSchema } from '../lib/schema';
import { withUtm } from '../lib/url';

const guides = (await getPublishedDocs('guides')).slice(0, 4);
const troubles = (await getPublishedDocs('troubleshooting')).slice(0, 4);
const evidenceVideos = [...QC_VIDEOS, ...CUSTOMER_USE_VIDEOS];
const optionUrl = withUtm(OFFICIAL_STORE_PRODUCT_URL, { content: 'home_hero_secondary' });
---

<BaseLayout
  title="블루가드 연막소독기 공식 정보"
  description="휴대용 부탄가스 연막소독기 BF-100S·BF-102의 사양과 사용법, 안전수칙, 문제해결을 한곳에 모았습니다."
  canonicalPath="/"
  ogImage="/og/og-default.png"
  crumbs={[{ name: '홈', href: '/' }]}
  schemaNodes={[organizationSchema(), websiteSchema()]}
>
  <Fragment slot="hero">
    <div class="full-bleed hero-band">
      <div class="full-bleed__inner hero">
        <div class="hero__text">
          <p class="eyebrow eyebrow--ink">공식 기술정보</p>
          <h1>블루가드 연막소독기<br />BF-100S · BF-102</h1>
          <p class="lede">
            부탄가스로 작동하는 휴대용 미니 연막기입니다. 모델별 탱크 용량과 노즐 구성, 충전
            한도와 안전 기준을 공식 사양 그대로 정리했습니다.
          </p>
          <div class="hero__actions">
            <a class="hero__cta hero__cta--primary" href="/compare/">모델 차이 비교하기</a>
            <a
              class="hero__cta hero__cta--secondary"
              href={optionUrl}
              target="_blank"
              rel="noopener external"
              data-ga-event="purchase_cta_click"
              data-ga-utm-content="home_hero_secondary"
            >
              공식몰에서 옵션 선택
            </a>
          </div>
          <p class="hero__media">사용 매질 · {MEDIA_LABEL}</p>
        </div>

        <div class="hero__figure">
          <Pic
            src={heroImage}
            alt="블루가드 연막소독기 대용량 — 흰색 연료통과 스테인리스 배럴이 보이는 본체 제품 사진"
            width={440}
            height={440}
            priority
            sizes="(max-width: 900px) 80vw, 440px"
            class="hero__image"
          />
        </div>
      </div>
    </div>

    <div class="full-bleed stat-band">
      <div class="full-bleed__inner">
        <StatRow variant="ink" />
      </div>
    </div>
  </Fragment>

  <SafetyBox title="쓰기 전에 이것만은" compact only={['venue', 'fill-limit', 'aux-inlet']} />

  <section aria-labelledby="models">
    <h2 id="models">모델 고르기</h2>
    <p class="section-desc">
      본체 구조와 사용 절차는 세 구성이 같습니다. 갈리는 것은 한 번에 담는 양, 들고 다니는 방식,
      분사구가 닿는 거리입니다.
    </p>
    <div class="grid grid--3">
      {PRODUCTS.map((product) => <ModelCard product={product} context="home" />)}
    </div>
    <p class="section-more">
      <a href="/products/">제품 전체 보기</a> · <a href="/compare/">모델 비교표</a>
    </p>
    <ShippingNote />
  </section>

  <section aria-labelledby="evidence">
    <h2 id="evidence">실물 확인</h2>
    <p class="section-desc">
      제조 현장과 실제 사용 모습을 담은 촬영본입니다. 아직 확보하지 못한 사진은 자리만 비워
      두었습니다.
    </p>
    <div class="video-row">
      {evidenceVideos.map((video) => <VideoEmbed video={video} />)}
    </div>
    <PhotoRequest items={HOME_PHOTO_REQUESTS} />
  </section>

  <section aria-labelledby="howto">
    <h2 id="howto">공식 사용방법</h2>
    <p class="section-desc">
      제조사가 만든 안내 영상입니다. 작업 전 준비부터 약제 충전, 점화, 펌핑, 사용 후 세척까지
      순서대로 보여줍니다.
    </p>
    <VideoEmbed video={HOWTO_VIDEO} />
  </section>

  <TrustBar />

  <section aria-labelledby="sec-guides">
    <h2 id="sec-guides">{COLLECTION_META.guides.title}</h2>
    <p class="section-desc">{COLLECTION_META.guides.description}</p>
    <ol class="step-list">
      {
        guides.map((doc, i) => (
          <li>
            <a href={docHref(doc.collection, doc.id)}>
              <span class="step-list__no">{i + 1}</span>
              <span class="step-list__body">
                <strong>{doc.data.title}</strong>
                <span>{doc.data.description}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="section-more">
      <a href={COLLECTION_META.guides.href}>{COLLECTION_META.guides.label} 전체 보기 →</a>
    </p>
  </section>

  <section aria-labelledby="sec-troubleshooting">
    <h2 id="sec-troubleshooting">{COLLECTION_META.troubleshooting.title}</h2>
    <p class="section-desc">{COLLECTION_META.troubleshooting.description}</p>
    <div class="symptom-list">
      {
        troubles.map((doc) => (
          <a class="symptom" href={docHref(doc.collection, doc.id)}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 9v4m0 4h.01M10.3 3.9 2.7 17.5A1.8 1.8 0 0 0 4.3 20h15.4a1.8 1.8 0 0 0 1.6-2.5L13.7 3.9a1.8 1.8 0 0 0-3.4 0Z" />
            </svg>
            <span>
              <strong>{doc.data.title}</strong>
              <span>{doc.data.description}</span>
            </span>
          </a>
        ))
      }
    </div>
    <p class="section-more">
      <a href={COLLECTION_META.troubleshooting.href}>
        {COLLECTION_META.troubleshooting.label} 전체 보기 →
      </a>
    </p>
  </section>

  <section class="panel panel--ink closing">
    <h2>안전하게 쓰는 것이 먼저입니다</h2>
    <p>
      연막소독기는 매질을 가열해 기화시키는 기기입니다. 충전 한도, 보조주입구 취급, 지정 매질
      이 세 가지만 지켜도 사고 대부분을 막을 수 있습니다. 사용 가능한 장소는 함께 쓰는 약제의
      표시사항이 정합니다.
    </p>
    <p><a href="/safety/">전체 안전수칙 보기 →</a></p>
  </section>
</BaseLayout>

<style>
  .hero-band {
    background: linear-gradient(160deg, var(--c-ink), var(--c-ink-2) 70%);
    color: var(--c-on-ink);
    padding: clamp(2rem, 5vw, 3.5rem) 0 clamp(2.5rem, 6vw, 4rem);
  }

  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .hero__text h1 {
    margin-top: 0;
    color: #fff;
  }

  .hero__text .lede {
    color: var(--c-on-ink-dim);
  }

  .eyebrow--ink {
    color: #ffe9a8;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 1.4rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.98rem;
    text-decoration: none;
  }

  .hero__cta--primary {
    background: var(--c-yellow);
    color: #1a1400;
  }

  .hero__cta--primary:hover {
    background: var(--c-yellow-dark);
  }

  .hero__cta--secondary {
    border: 1.5px solid rgb(255 255 255 / 0.45);
    color: #fff;
  }

  .hero__cta--secondary:hover {
    background: rgb(255 255 255 / 0.1);
  }

  .hero__media {
    margin: 1.1rem 0 0;
    font-size: 0.85rem;
    color: var(--c-on-ink-dim);
  }

  /* 제품 사진을 흰 카드에 가두지 않고, 아래에 접지 그림자만 깔아 배경과 자연스럽게 잇는다 */
  .hero__figure {
    position: relative;
  }

  .hero__figure::after {
    content: '';
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -6%;
    height: 18%;
    background: radial-gradient(ellipse, rgb(0 0 0 / 0.45), transparent 70%);
    filter: blur(4px);
  }

  .hero :global(.hero__image) {
    position: relative;
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 18px 22px rgb(0 0 0 / 0.35));
  }

  .stat-band {
    background: var(--c-ink-2);
    padding: 0.25rem 0 clamp(1.5rem, 4vw, 2.25rem);
  }

  .grid {
    display: grid;
    gap: 1rem;
  }

  .grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .section-desc {
    margin: 0 0 1.25rem;
    color: var(--c-text-muted);
    font-size: 0.97rem;
    max-width: 60ch;
  }

  .section-more {
    margin: 1.25rem 0 0;
    font-size: 0.93rem;
    font-weight: 700;
  }

  .section-more a {
    text-decoration: none;
  }

  .section-more a:hover {
    text-decoration: underline;
  }

  .video-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.9rem;
  }

  /* 사용법 — 순서가 중요한 콘텐츠라 번호 칩으로 단계처럼 보이게 한다 */
  .step-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    counter-reset: step;
  }

  .step-list a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--c-border);
    border-radius: 12px;
    text-decoration: none;
    color: var(--c-text);
    background: var(--c-surface);
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  .step-list a:hover {
    border-color: var(--c-accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .step-list__no {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--c-accent-soft);
    color: var(--c-accent-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.9rem;
  }

  .step-list__body {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .step-list__body strong {
    font-size: 1rem;
    letter-spacing: -0.015em;
  }

  .step-list__body span {
    font-size: 0.87rem;
    color: var(--c-text-muted);
    line-height: 1.6;
  }

  /* 문제해결 — 증상을 고르는 흐름이라 경고 아이콘을 앞세운다 */
  .symptom-list {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.6rem;
  }

  .symptom {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--c-warn-border);
    border-left: 3px solid var(--c-warn);
    border-radius: 10px;
    text-decoration: none;
    color: var(--c-text);
    background: var(--c-warn-soft);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .symptom:hover {
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  .symptom svg {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 0.1rem;
    fill: none;
    stroke: var(--c-warn-text);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .symptom span {
    display: grid;
    gap: 0.15rem;
  }

  .symptom strong {
    font-size: 0.98rem;
    color: var(--c-text);
  }

  .symptom span span {
    font-size: 0.86rem;
    color: var(--c-text-muted);
    line-height: 1.6;
  }

  .closing p {
    color: var(--c-on-ink);
    max-width: 62ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .step-list a:hover,
    .symptom:hover {
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .hero,
    .grid--3 {
      grid-template-columns: 1fr;
    }

    .hero__figure {
      max-width: 320px;
      margin: 0 auto;
    }
  }
</style>
