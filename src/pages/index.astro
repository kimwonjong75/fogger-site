---
import heroImage from '../assets/photo-bf-102.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import BuyCTA from '../components/BuyCTA.astro';
import ModelCard from '../components/ModelCard.astro';
import Pic from '../components/Pic.astro';
import SafetyBox from '../components/SafetyBox.astro';
import ShippingNote from '../components/ShippingNote.astro';
import StatRow from '../components/StatRow.astro';
import TrustBar from '../components/TrustBar.astro';
import { MEDIA_LABEL, PRODUCTS } from '../data/products';
import { COLLECTION_META, docHref, getPublishedDocs } from '../lib/content';
import { organizationSchema, websiteSchema } from '../lib/schema';

const sections = [
  { key: 'guides' as const, docs: (await getPublishedDocs('guides')).slice(0, 4) },
  { key: 'troubleshooting' as const, docs: (await getPublishedDocs('troubleshooting')).slice(0, 3) },
  { key: 'uses' as const, docs: (await getPublishedDocs('uses')).slice(0, 3) },
].filter(({ docs }) => docs.length > 0);
---

<BaseLayout
  title="블루가드 연막소독기 공식 정보"
  description="휴대용 부탄가스 연막소독기 BF-100S·BF-102의 사양과 사용법, 안전수칙, 문제해결을 한곳에 모았습니다."
  canonicalPath="/"
  ogImage="/og/og-default.png"
  crumbs={[{ name: '홈', href: '/' }]}
  schemaNodes={[organizationSchema(), websiteSchema()]}
>
  <section class="hero">
    <div class="hero__text">
      <p class="eyebrow">공식 기술정보</p>
      <h1>블루가드 연막소독기<br />BF-100S · BF-102</h1>
      <p class="lede">
        부탄가스로 작동하는 휴대용 미니 연막기입니다. 모델별 탱크 용량과 노즐 구성, 충전 한도와
        안전 기준을 공식 사양 그대로 정리했습니다.
      </p>
      <div class="hero__actions">
        <BuyCTA content="home_hero" showShipping />
        <a class="hero__link" href="/compare/">모델 비교표 보기 →</a>
      </div>
      <p class="hero__media">사용 매질 · {MEDIA_LABEL}</p>
    </div>
    <Pic
      src={heroImage}
      alt="블루가드 연막소독기 대용량 — 흰색 연료통과 스테인리스 배럴이 보이는 본체 제품 사진"
      width={480}
      height={480}
      priority
      sizes="(max-width: 900px) 100vw, 480px"
      class="hero__image"
    />
  </section>

  <StatRow />

  <SafetyBox title="쓰기 전에 이것만은" compact only={['venue', 'fill-limit', 'aux-inlet']} />

  <section aria-labelledby="models">
    <h2 id="models">모델 고르기</h2>
    <p class="section-desc">
      본체 구조와 사용 절차는 세 구성이 같습니다. 갈리는 것은 한 번에 담는 양, 들고 다니는 방식,
      분사구가 닿는 거리입니다.
    </p>
    <div class="grid">
      {PRODUCTS.map((product) => <ModelCard product={product} context="home" />)}
    </div>
    <p class="section-more">
      <a href="/products/">제품 전체 보기</a> · <a href="/compare/">모델 비교표</a>
    </p>
    <ShippingNote />
  </section>

  <TrustBar />

  {
    sections.map(({ key, docs }) => (
      <section aria-labelledby={`sec-${key}`}>
        <h2 id={`sec-${key}`}>{COLLECTION_META[key].title}</h2>
        <p class="section-desc">{COLLECTION_META[key].description}</p>
        <ul class="doc-list">
          {docs.map((doc) => (
            <li>
              <a href={docHref(doc.collection, doc.id)}>
                <strong>{doc.data.title}</strong>
                <span>{doc.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="section-more">
          <a href={COLLECTION_META[key].href}>{COLLECTION_META[key].label} 전체 보기 →</a>
        </p>
      </section>
    ))
  }

  <section class="panel panel--ink closing">
    <h2>안전하게 쓰는 것이 먼저입니다</h2>
    <p>
      연막소독기는 매질을 가열해 기화시키는 기기입니다. 충전 한도, 보조주입구 취급, 지정 매질
      이 세 가지만 지켜도 사고 대부분을 막을 수 있습니다. 사용 가능한 장소는 함께 쓰는 약제의
      표시사항이 정합니다.
    </p>
    <p><a href="/safety/">전체 안전수칙 보기 →</a></p>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(1rem, 3vw, 2.25rem) 0 1rem;
  }

  .hero__text h1 {
    margin-top: 0;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .hero__link {
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .hero__link:hover {
    text-decoration: underline;
  }

  .hero__media {
    margin: 1.1rem 0 0;
    font-size: 0.85rem;
    color: var(--c-text-muted);
  }

  .hero :global(.hero__image) {
    width: 100%;
    height: auto;
    border-radius: 14px;
    display: block;
    background: var(--c-surface-alt);
  }

  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .section-desc {
    margin: 0 0 1.25rem;
    color: var(--c-text-muted);
    font-size: 0.97rem;
    max-width: 60ch;
  }

  .section-more {
    margin: 1.25rem 0 0;
    font-size: 0.93rem;
    font-weight: 700;
  }

  .section-more a {
    text-decoration: none;
  }

  .section-more a:hover {
    text-decoration: underline;
  }

  .doc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .doc-list a {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--c-border);
    border-radius: 12px;
    text-decoration: none;
    color: var(--c-text);
    background: var(--c-surface);
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  .doc-list a:hover {
    border-color: var(--c-accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .doc-list strong {
    font-size: 1rem;
    letter-spacing: -0.015em;
  }

  .doc-list span {
    font-size: 0.88rem;
    color: var(--c-text-muted);
    line-height: 1.65;
  }

  .closing p {
    color: var(--c-on-ink);
    max-width: 62ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .doc-list a:hover {
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .hero,
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
