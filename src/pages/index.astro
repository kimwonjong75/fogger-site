---
import heroImage from '../assets/photo-bf-102.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import ModelCard from '../components/ModelCard.astro';
import Pic from '../components/Pic.astro';
import SafetyBox from '../components/SafetyBox.astro';
import ShippingNote from '../components/ShippingNote.astro';
import StatRow from '../components/StatRow.astro';
import TrustBar from '../components/TrustBar.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import { MEDIA_SPECS, PRODUCTS, WORK_REFERENCE } from '../data/products';
import {
  CUSTOMER_USE_VIDEOS,
  HOWTO_STEPS,
  HOWTO_VIDEO,
  QC_VIDEOS,
  VIDEO_PUBLISHED_DATE,
} from '../data/media';
import { OFFICIAL_STORE_PRODUCT_URL } from '../data/site';
import { COLLECTION_META, docHref, getPublishedDocs } from '../lib/content';
import {
  howToSchema,
  itemListSchema,
  organizationSchema,
  videoSchema,
  websiteSchema,
} from '../lib/schema';
import { withUtm } from '../lib/url';

const guides = (await getPublishedDocs('guides')).slice(0, 4);
const troubles = (await getPublishedDocs('troubleshooting')).slice(0, 4);
const evidenceVideos = [...QC_VIDEOS, ...CUSTOMER_USE_VIDEOS];
const optionUrl = withUtm(OFFICIAL_STORE_PRODUCT_URL, { content: 'home_hero_secondary' });

/** 화면에 렌더링하는 10단계와 같은 순서·문구를 쓴다 */
const howTo = howToSchema('/', '블루가드 연막소독기 사용방법', HOWTO_STEPS);

const productList = itemListSchema(
  '/products/',
  '블루가드 휴대용 연막소독기 라인업',
  PRODUCTS.map((product) => ({ name: product.name, href: `/products/${product.id}/` })),
);

/** 대표 사용법 영상 1건만 구조화데이터로 낸다 — 나머지는 보조 클립이라 넣지 않는다 */
const howToVideo = videoSchema({
  name: HOWTO_VIDEO.title,
  description: HOWTO_VIDEO.caption,
  contentUrl: HOWTO_VIDEO.src,
  thumbnailUrl: HOWTO_VIDEO.poster.src,
  durationSec: HOWTO_VIDEO.durationSec,
  uploadDate: VIDEO_PUBLISHED_DATE,
});
---

<BaseLayout
  title="가정용 휴대용 연막소독기 블루가드"
  description="가정용·휴대용 연막소독기 블루가드 BF-100S·BF-102 공식 정보. 실내외 매질 기준과 모기 방역 사용법, 안전수칙, 문제해결을 한곳에 모았습니다."
  canonicalPath="/"
  ogImage="/og/og-default.png"
  crumbs={[{ name: '홈', href: '/' }]}
  schemaNodes={[organizationSchema(), websiteSchema(), productList, howTo, howToVideo]}
>
  <Fragment slot="hero">
    <div class="full-bleed hero-band">
      <div class="full-bleed__inner hero">
        <div class="hero__text">
          <p class="eyebrow eyebrow--ink">공식 기술정보</p>
          <h1>가정용 휴대용 연막소독기<br />블루가드 BF-100S · BF-102</h1>
          <p class="lede">
            부탄가스로 작동하는 국산 미니 연막기입니다. <strong>연막·연무를 한 대로</strong> 쓰며,
            넣는 매질을 바꾸면 실내에서도 작업합니다. 모델별 탱크 용량과 노즐 구성, 충전 한도와
            안전 기준을 공식 사양 그대로 정리했습니다.
          </p>
          <div class="hero__actions">
            <a class="hero__cta hero__cta--primary" href="/compare/">모델 차이 비교하기</a>
            <a
              class="hero__cta hero__cta--secondary"
              href={optionUrl}
              target="_blank"
              rel="noopener external"
              data-ga-event="purchase_cta_click"
              data-ga-utm-content="home_hero_secondary"
            >
              공식몰에서 옵션 선택
            </a>
          </div>
          <p class="hero__media">
            {MEDIA_SPECS.map((medium) => `${medium.name} · ${medium.venueLabel}`).join('  /  ')}
          </p>
        </div>

        <div class="hero__figure">
          <Pic
            src={heroImage}
            alt="블루가드 연막소독기 대용량 — 흰색 연료통과 스테인리스 배럴이 보이는 본체 제품 사진"
            width={440}
            height={440}
            priority
            sizes="(max-width: 900px) 80vw, 440px"
            class="hero__image"
          />
        </div>
      </div>
    </div>

    <div class="full-bleed stat-band">
      <div class="full-bleed__inner">
        <StatRow variant="ink" />
      </div>
    </div>
  </Fragment>

  <SafetyBox title="쓰기 전에 이것만은" compact only={['venue', 'fill-limit', 'aux-inlet']} />

  <section aria-labelledby="models">
    <h2 id="models">어떤 모델을 골라야 하나요?</h2>
    <p class="section-desc">
      본체 구조와 사용 절차는 세 구성이 같습니다. 갈리는 것은 한 번에 담는 양, 들고 다니는 방식,
      분사구가 닿는 거리입니다. 마당처럼 좁은 곳이면 기본형, 정원·창고처럼 넓은 곳이면 대용량,
      하수구나 풀숲처럼 손이 닿지 않는 곳이면 롱노즐 구성입니다.
    </p>
    <div class="grid grid--3">
      {PRODUCTS.map((product) => <ModelCard product={product} context="home" />)}
    </div>
    <p class="section-more">
      <a href="/products/">제품 전체 보기</a> · <a href="/compare/">모델 비교표</a>
    </p>
    <ShippingNote />
  </section>

  <section aria-labelledby="venue">
    <h2 id="venue">실내에서도 쓸 수 있나요?</h2>
    <p class="section-desc">
      쓸 수 있습니다. 이 기기는 <strong>연막·연무 겸용</strong>이라, 탱크에 넣는 매질을 바꾸면
      모드가 바뀝니다. 기기를 두 대 살 필요가 없습니다.
    </p>
    <div class="venue-grid">
      {
        MEDIA_SPECS.map((medium) => (
          <div class="venue-card">
            <p class="venue-card__where">
              {medium.mode} 모드 · {medium.venueLabel}
            </p>
            <p class="venue-card__name">{medium.name}</p>
            <p class="venue-card__detail">{medium.detail}</p>
          </div>
        ))
      }
    </div>
    <p class="venue-work">
      충전량 {WORK_REFERENCE.chargeMl.toLocaleString('ko-KR')}mL 기준 약 {WORK_REFERENCE.minutes}분
      · {WORK_REFERENCE.pyeong}평 작업 <span>{WORK_REFERENCE.note}</span>
    </p>
    <p class="venue-caution">
      매질을 무엇으로 바꾸든 가열원은 부탄가스 연소입니다. 창문·출입구·환기설비로 공기가 통하는
      상태에서만 작동시키고, 창이 없는 방이나 환기가 막힌 지하공간에서는 사용하지 마세요.
      실제 허용 장소와 대상 해충은 함께 쓰는 약제의 표시사항이 정합니다.
    </p>
    <p class="section-more">
      <a href="/guides/choose-media/">매질 고르는 법</a> ·
      <a href="/guides/fogger-vs-mist-blower/">연막기와 연무기 차이</a>
    </p>
  </section>

  <section aria-labelledby="howto">
    <h2 id="howto">어떻게 사용하나요?</h2>
    <p class="section-desc">
      공식 사용법 영상의 10단계입니다. 작업 전 준비부터 점화, 펌핑, 사용 후 세척까지 순서대로
      따라가면 됩니다.
    </p>
    <VideoEmbed video={HOWTO_VIDEO} />
    <ol class="howto-steps">
      {
        HOWTO_STEPS.map((step) => (
          <li id={`step-${step.no}`}>
            <strong>{step.title}</strong>
            <span>{step.body}</span>
          </li>
        ))
      }
    </ol>
    <p class="section-more">
      <a href="/guides/">단계별 상세 문서 보기</a> · <a href="/safety/">안전수칙</a>
    </p>
  </section>

  <section aria-labelledby="evidence">
    <h2 id="evidence">실제로 어떻게 생겼나요?</h2>
    <p class="section-desc">
      조립 공정과 실제 분사 장면을 담은 촬영본입니다. 클릭하면 재생됩니다.
    </p>
    <div class="video-row">
      {evidenceVideos.map((video) => <VideoEmbed video={video} />)}
    </div>
  </section>

  <TrustBar />

  <section aria-labelledby="sec-guides">
    <h2 id="sec-guides">{COLLECTION_META.guides.title}</h2>
    <p class="section-desc">{COLLECTION_META.guides.description}</p>
    <ol class="step-list">
      {
        guides.map((doc, i) => (
          <li>
            <a href={docHref(doc.collection, doc.id)}>
              <span class="step-list__no">{i + 1}</span>
              <span class="step-list__body">
                <strong>{doc.data.title}</strong>
                <span>{doc.data.description}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="section-more">
      <a href={COLLECTION_META.guides.href}>{COLLECTION_META.guides.label} 전체 보기 →</a>
    </p>
  </section>

  <section aria-labelledby="sec-troubleshooting">
    <h2 id="sec-troubleshooting">{COLLECTION_META.troubleshooting.title}</h2>
    <p class="section-desc">{COLLECTION_META.troubleshooting.description}</p>
    <div class="symptom-list">
      {
        troubles.map((doc) => (
          <a class="symptom" href={docHref(doc.collection, doc.id)}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 9v4m0 4h.01M10.3 3.9 2.7 17.5A1.8 1.8 0 0 0 4.3 20h15.4a1.8 1.8 0 0 0 1.6-2.5L13.7 3.9a1.8 1.8 0 0 0-3.4 0Z" />
            </svg>
            <span>
              <strong>{doc.data.title}</strong>
              <span>{doc.data.description}</span>
            </span>
          </a>
        ))
      }
    </div>
    <p class="section-more">
      <a href={COLLECTION_META.troubleshooting.href}>
        {COLLECTION_META.troubleshooting.label} 전체 보기 →
      </a>
    </p>
  </section>

  <section class="panel panel--ink closing">
    <h2>안전하게 쓰는 것이 먼저입니다</h2>
    <p>
      연막소독기는 매질을 가열해 기화시키는 기기입니다. 충전 한도, 보조주입구 취급, 지정 매질
      이 세 가지만 지켜도 사고 대부분을 막을 수 있습니다. 사용 가능한 장소는 함께 쓰는 약제의
      표시사항이 정합니다.
    </p>
    <p><a href="/safety/">전체 안전수칙 보기 →</a></p>
  </section>
</BaseLayout>

<style>
  .hero-band {
    background: linear-gradient(160deg, var(--c-ink), var(--c-ink-2) 70%);
    color: var(--c-on-ink);
    padding: clamp(2rem, 5vw, 3.5rem) 0 clamp(2.5rem, 6vw, 4rem);
  }

  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .hero__text h1 {
    margin-top: 0;
    color: #fff;
  }

  .hero__text .lede {
    color: var(--c-on-ink-dim);
  }

  .eyebrow--ink {
    color: #ffe9a8;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 1.4rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.98rem;
    text-decoration: none;
  }

  .hero__cta--primary {
    background: var(--c-yellow);
    color: #1a1400;
  }

  .hero__cta--primary:hover {
    background: var(--c-yellow-dark);
  }

  .hero__cta--secondary {
    border: 1.5px solid rgb(255 255 255 / 0.45);
    color: #fff;
  }

  .hero__cta--secondary:hover {
    background: rgb(255 255 255 / 0.1);
  }

  .hero__media {
    margin: 1.1rem 0 0;
    font-size: 0.85rem;
    color: var(--c-on-ink-dim);
  }

  /* 제품 사진을 흰 카드에 가두지 않고, 아래에 접지 그림자만 깔아 배경과 자연스럽게 잇는다 */
  .hero__figure {
    position: relative;
  }

  .hero__figure::after {
    content: '';
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -6%;
    height: 18%;
    background: radial-gradient(ellipse, rgb(0 0 0 / 0.45), transparent 70%);
    filter: blur(4px);
  }

  .hero :global(.hero__image) {
    position: relative;
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 18px 22px rgb(0 0 0 / 0.35));
  }

  .stat-band {
    background: var(--c-ink-2);
    padding: 0.25rem 0 clamp(1.5rem, 4vw, 2.25rem);
  }

  .grid {
    display: grid;
    gap: 1rem;
  }

  .grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .section-desc {
    margin: 0 0 1.25rem;
    color: var(--c-text-muted);
    font-size: 0.97rem;
    max-width: 60ch;
  }

  .section-more {
    margin: 1.25rem 0 0;
    font-size: 0.93rem;
    font-weight: 700;
  }

  .section-more a {
    text-decoration: none;
  }

  .section-more a:hover {
    text-decoration: underline;
  }

  .video-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.9rem;
  }

  /* 실내외 — 매질 두 개를 나란히 두고 어느 쪽이 어디용인지 한눈에 보이게 한다 */
  .venue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.9rem;
    margin-top: 1.25rem;
  }

  .venue-card {
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--c-border);
    border-radius: 12px;
    background: var(--c-surface-alt);
  }

  .venue-card__where {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--c-accent-ink, var(--c-text));
  }

  .venue-card__name {
    margin: 0.3rem 0 0.5rem;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .venue-card__detail {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--c-text-muted);
  }

  .venue-work {
    margin: 0.9rem 0 0;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .venue-work span {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--c-text-muted);
  }

  .venue-caution {
    margin: 1rem 0 0;
    padding: 0.9rem 1.05rem;
    border-left: 3px solid var(--c-border-strong);
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--c-text-muted);
  }

  /* 공식 10단계 — 영상 자막을 그대로 옮긴 순서라 번호를 그대로 노출한다 */
  .howto-steps {
    margin: 1.5rem 0 0;
    padding-left: 1.4rem;
    display: grid;
    gap: 0.7rem;
  }

  .howto-steps li {
    padding-left: 0.2rem;
  }

  .howto-steps strong {
    display: block;
    font-size: 0.97rem;
  }

  .howto-steps span {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--c-text-muted);
  }

  /* 사용법 — 순서가 중요한 콘텐츠라 번호 칩으로 단계처럼 보이게 한다 */
  .step-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    counter-reset: step;
  }

  .step-list a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--c-border);
    border-radius: 12px;
    text-decoration: none;
    color: var(--c-text);
    background: var(--c-surface);
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  .step-list a:hover {
    border-color: var(--c-accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .step-list__no {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--c-accent-soft);
    color: var(--c-accent-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.9rem;
  }

  .step-list__body {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .step-list__body strong {
    font-size: 1rem;
    letter-spacing: -0.015em;
  }

  .step-list__body span {
    font-size: 0.87rem;
    color: var(--c-text-muted);
    line-height: 1.6;
  }

  /* 문제해결 — 증상을 고르는 흐름이라 경고 아이콘을 앞세운다 */
  .symptom-list {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.6rem;
  }

  .symptom {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--c-warn-border);
    border-left: 3px solid var(--c-warn);
    border-radius: 10px;
    text-decoration: none;
    color: var(--c-text);
    background: var(--c-warn-soft);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .symptom:hover {
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  .symptom svg {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 0.1rem;
    fill: none;
    stroke: var(--c-warn-text);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .symptom span {
    display: grid;
    gap: 0.15rem;
  }

  .symptom strong {
    font-size: 0.98rem;
    color: var(--c-text);
  }

  .symptom span span {
    font-size: 0.86rem;
    color: var(--c-text-muted);
    line-height: 1.6;
  }

  .closing p {
    color: var(--c-on-ink);
    max-width: 62ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .step-list a:hover,
    .symptom:hover {
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .hero,
    .grid--3 {
      grid-template-columns: 1fr;
    }

    .hero__figure {
      max-width: 320px;
      margin: 0 auto;
    }
  }
</style>
