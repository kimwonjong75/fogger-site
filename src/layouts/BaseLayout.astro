---
import Analytics from '../components/Analytics.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';
import StickyBuyBar from '../components/StickyBuyBar.astro';
import { SITE } from '../data/site';
import type { ProductId } from '../data/products';
import { breadcrumbSchema, graph, type Crumb } from '../lib/schema';

interface Props {
  /** 30자 이내 고유 title */
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  updatedDate?: Date;
  /** 화면 브레드크럼 = BreadcrumbList. 홈("/")은 자동으로 맨 앞에 붙는다. */
  crumbs?: Crumb[];
  /** 홈의 Organization/WebSite, 문서의 Article 등 추가 JSON-LD 노드 */
  schemaNodes?: unknown[];
  /** 전환층 전용 하단 고정 구매바 */
  stickyBuy?: ProductId | false;
  /** 본문 최대폭 — 문서형은 narrow */
  width?: 'page' | 'narrow';
}

const {
  title,
  description,
  canonicalPath,
  ogImage,
  ogType = 'website',
  noindex = false,
  updatedDate,
  crumbs = [],
  schemaNodes = [],
  stickyBuy = false,
  width = 'page',
} = Astro.props;

const HOME: Crumb = { name: '홈', href: '/' };
const allCrumbs: Crumb[] = crumbs[0]?.href === '/' ? crumbs : [HOME, ...crumbs];

const jsonLd = graph([breadcrumbSchema(allCrumbs), ...schemaNodes]);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      updatedDate={updatedDate}
      jsonLd={jsonLd}
    />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <Analytics />
  </head>

  <body>
    <a class="skip-link" href="#main">본문 바로가기</a>
    <Header />

    <div class:list={['shell', `shell--${width}`]}>
      <Breadcrumbs crumbs={allCrumbs} />
      <main id="main">
        <slot />
      </main>
    </div>

    <Footer />
    {stickyBuy && <StickyBuyBar productId={stickyBuy} />}
  </body>
</html>

<style is:global>
  :root {
    --c-text: #0f172a;
    --c-text-muted: #52627a;
    --c-surface: #ffffff;
    --c-surface-alt: #f6f8fb;
    --c-border: #e2e8f0;
    --c-border-strong: #cbd5e1;
    --c-accent: #1d63b8;
    --c-accent-dark: #164e91;
    --c-accent-soft: #e8f0fb;
    --c-warn: #d97706;
    --c-warn-soft: #fffbeb;
    --c-warn-border: #fcd9a4;
    --c-warn-text: #92400e;
    --c-danger: #dc2626;

    --w-page: 1080px;
    --w-narrow: 760px;
    --pad-x: 20px;

    /* 웹폰트 0 — 시스템 폰트만 사용 */
    --font-sans: system-ui, -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', '맑은 고딕',
      'Segoe UI', Roboto, sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.7;
    color: var(--c-text);
    background: var(--c-surface);
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  body > .shell {
    flex: 1 0 auto;
  }

  .shell {
    width: 100%;
    max-width: var(--w-page);
    margin: 0 auto;
    padding: 0 var(--pad-x) 2.5rem;
  }

  .shell--narrow {
    max-width: var(--w-narrow);
  }

  h1,
  h2,
  h3,
  h4 {
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--c-text);
  }

  h1 {
    font-size: clamp(1.6rem, 4.2vw, 2.1rem);
    margin: 0.4rem 0 0.75rem;
  }

  h2 {
    font-size: clamp(1.25rem, 3vw, 1.45rem);
    margin: 2.25rem 0 0.75rem;
  }

  h3 {
    font-size: 1.08rem;
    margin: 1.6rem 0 0.5rem;
  }

  p,
  li {
    overflow-wrap: break-word;
  }

  a {
    color: var(--c-accent-dark);
    text-underline-offset: 2px;
  }

  a:focus-visible,
  button:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  hr {
    border: 0;
    border-top: 1px solid var(--c-border);
    margin: 2rem 0;
  }

  code {
    background: var(--c-surface-alt);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.6rem 1rem;
    background: var(--c-accent);
    color: #fff;
  }

  .skip-link:focus {
    left: 0;
  }

  .lede {
    font-size: 1.02rem;
    color: var(--c-text-muted);
    margin: 0 0 1.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
