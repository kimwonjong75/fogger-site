---
import Analytics from '../components/Analytics.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';
import StickyBuyBar from '../components/StickyBuyBar.astro';
import { SITE } from '../data/site';
import type { ProductId } from '../data/products';
import { breadcrumbSchema, graph, type Crumb } from '../lib/schema';

interface Props {
  /** 30자 이내 고유 title */
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  updatedDate?: Date;
  /** 화면 브레드크럼 = BreadcrumbList. 홈("/")은 자동으로 맨 앞에 붙는다. */
  crumbs?: Crumb[];
  /** 홈의 Organization/WebSite, 문서의 Article 등 추가 JSON-LD 노드 */
  schemaNodes?: unknown[];
  /** 전환층 전용 하단 고정 구매바. 'generic'은 모델 미지정 바 */
  stickyBuy?: ProductId | 'generic' | false;
  /** 본문 최대폭 — 문서형은 narrow */
  width?: 'page' | 'narrow';
}

const {
  title,
  description,
  canonicalPath,
  ogImage,
  ogType = 'website',
  noindex = false,
  updatedDate,
  crumbs = [],
  schemaNodes = [],
  stickyBuy = false,
  width = 'page',
} = Astro.props;

const HOME: Crumb = { name: '홈', href: '/' };
const allCrumbs: Crumb[] = crumbs[0]?.href === '/' ? crumbs : [HOME, ...crumbs];

const jsonLd = graph([breadcrumbSchema(allCrumbs), ...schemaNodes]);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      updatedDate={updatedDate}
      jsonLd={jsonLd}
    />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <Analytics />
  </head>

  <body>
    <a class="skip-link" href="#main">본문 바로가기</a>
    <Header />

    <div class:list={['shell', `shell--${width}`]}>
      <Breadcrumbs crumbs={allCrumbs} />
      <main id="main">
        <slot />
      </main>
    </div>

    <Footer />
    {stickyBuy && <StickyBuyBar productId={stickyBuy === 'generic' ? undefined : stickyBuy} />}
  </body>
</html>

<style is:global>
  :root {
    --c-text: #0f172a;
    --c-text-muted: #52627a;
    --c-surface: #ffffff;
    --c-surface-alt: #f4f7fb;
    --c-border: #e2e8f0;
    --c-border-strong: #cbd5e1;
    --c-accent: #1d63b8;
    --c-accent-dark: #164e91;
    --c-accent-soft: #e8f0fb;
    /* 어두운 배경 블록 — 히어로·수치 강조에 사용 */
    --c-ink: #0b2545;
    --c-ink-2: #143a6b;
    --c-on-ink: #eaf1fb;
    --c-on-ink-dim: #a8c1e2;
    --c-warn: #d97706;
    --c-warn-soft: #fffbeb;
    --c-warn-border: #fcd9a4;
    --c-warn-text: #92400e;
    --c-danger: #dc2626;

    --w-page: 1080px;
    --w-narrow: 760px;
    --pad-x: 20px;

    /* 그림자 — 웹폰트 없이 깊이를 만드는 거의 유일한 수단이라 값을 통일해 쓴다 */
    --shadow-sm: 0 1px 2px rgb(11 37 69 / 0.06);
    --shadow-md: 0 4px 16px -4px rgb(11 37 69 / 0.12), 0 1px 3px rgb(11 37 69 / 0.06);

    /* 웹폰트 0 — 시스템 폰트만 사용 */
    --font-sans: system-ui, -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', '맑은 고딕',
      'Segoe UI', Roboto, sans-serif;
    /* 수치 표기 전용 — 폭 고정 숫자로 표가 흔들리지 않게 한다 */
    --font-num: ui-monospace, 'SF Mono', 'Cascadia Mono', Consolas, monospace;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.7;
    color: var(--c-text);
    background: var(--c-surface);
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  body > .shell {
    flex: 1 0 auto;
  }

  .shell {
    width: 100%;
    max-width: var(--w-page);
    margin: 0 auto;
    padding: 0 var(--pad-x) 2.5rem;
  }

  .shell--narrow {
    max-width: var(--w-narrow);
  }

  /*
   * 타이포 스케일.
   * 웹폰트를 못 쓰는 대신 크기·굵기·자간 대비를 크게 벌려 위계를 만든다.
   * 한글은 라틴보다 자간이 넓어 보이므로 큰 제목일수록 letter-spacing을 더 조인다.
   */
  h1,
  h2,
  h3,
  h4 {
    line-height: 1.28;
    color: var(--c-text);
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(1.9rem, 5.2vw, 2.65rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin: 0.5rem 0 0.9rem;
  }

  h2 {
    font-size: clamp(1.4rem, 3.4vw, 1.75rem);
    font-weight: 750;
    letter-spacing: -0.025em;
    margin: 3rem 0 1rem;
  }

  h3 {
    font-size: 1.14rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 1.9rem 0 0.55rem;
  }

  /* 섹션 제목 위 짧은 액센트 바 — 색을 거의 쓰지 않는 레이아웃에 리듬을 준다 */
  .shell main > section > h2::before,
  .shell main > h2::before {
    content: '';
    display: block;
    width: 34px;
    height: 3px;
    border-radius: 2px;
    background: var(--c-accent);
    margin-bottom: 0.7rem;
  }

  /* 제목 위 작은 라벨 */
  .eyebrow {
    display: inline-block;
    margin: 0 0 0.4rem;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--c-accent-dark);
    text-transform: uppercase;
  }

  /* 수치는 폭 고정 숫자로 */
  .num {
    font-family: var(--font-num);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  p,
  li {
    overflow-wrap: break-word;
  }

  a {
    color: var(--c-accent-dark);
    text-underline-offset: 2px;
  }

  a:focus-visible,
  button:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  hr {
    border: 0;
    border-top: 1px solid var(--c-border);
    margin: 2rem 0;
  }

  code {
    background: var(--c-surface-alt);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.6rem 1rem;
    background: var(--c-accent);
    color: #fff;
  }

  .skip-link:focus {
    left: 0;
  }

  .lede {
    font-size: clamp(1.02rem, 2.2vw, 1.12rem);
    line-height: 1.75;
    color: var(--c-text-muted);
    margin: 0 0 1.75rem;
    max-width: 62ch;
    text-wrap: pretty;
  }

  /*
   * 섹션 패널.
   * 전폭 밴드는 가로 스크롤 위험이 있어 쓰지 않고, 안쪽에서 배경·여백으로 리듬을 만든다.
   */
  .panel {
    margin: 2.5rem 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--c-border);
    border-radius: 14px;
    background: var(--c-surface);
    box-shadow: var(--shadow-sm);
  }

  .panel--alt {
    background: var(--c-surface-alt);
    box-shadow: none;
  }

  .panel--ink {
    border-color: transparent;
    background: linear-gradient(135deg, var(--c-ink), var(--c-ink-2));
    color: var(--c-on-ink);
  }

  .panel--ink h2,
  .panel--ink h3 {
    color: #fff;
  }

  .panel--ink h2::before {
    background: var(--c-on-ink-dim);
  }

  .panel--ink a {
    color: #fff;
  }

  .panel > :first-child {
    margin-top: 0;
  }

  .panel > :last-child {
    margin-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
