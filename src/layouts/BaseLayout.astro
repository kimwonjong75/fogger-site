---
import Analytics from '../components/Analytics.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';
import StickyBuyBar from '../components/StickyBuyBar.astro';
import { SITE } from '../data/site';
import type { ProductId } from '../data/products';
import { breadcrumbSchema, graph, type Crumb } from '../lib/schema';

interface Props {
  /** 30자 이내 고유 title */
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  updatedDate?: Date;
  /** 화면 브레드크럼 = BreadcrumbList. 홈("/")은 자동으로 맨 앞에 붙는다. */
  crumbs?: Crumb[];
  /** 홈의 Organization/WebSite, 문서의 Article 등 추가 JSON-LD 노드 */
  schemaNodes?: unknown[];
  /** 전환층 전용 하단 고정 구매바. 'generic'은 모델 미지정 바 */
  stickyBuy?: ProductId | 'generic' | false;
  /** 본문 최대폭 — 문서형은 narrow */
  width?: 'page' | 'narrow';
}

const {
  title,
  description,
  canonicalPath,
  ogImage,
  ogType = 'website',
  noindex = false,
  updatedDate,
  crumbs = [],
  schemaNodes = [],
  stickyBuy = false,
  width = 'page',
} = Astro.props;

const HOME: Crumb = { name: '홈', href: '/' };
const allCrumbs: Crumb[] = crumbs[0]?.href === '/' ? crumbs : [HOME, ...crumbs];

const jsonLd = graph([breadcrumbSchema(allCrumbs), ...schemaNodes]);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      updatedDate={updatedDate}
      jsonLd={jsonLd}
    />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <Analytics />
  </head>

  <body>
    <a class="skip-link" href="#main">본문 바로가기</a>
    <Header />

    <slot name="hero" />

    <div class:list={['shell', `shell--${width}`]}>
      {allCrumbs.length > 1 && <Breadcrumbs crumbs={allCrumbs} />}
      <main id="main">
        <slot />
      </main>
    </div>

    <Footer />
    {stickyBuy && <StickyBuyBar productId={stickyBuy === 'generic' ? undefined : stickyBuy} />}
  </body>
</html>

<style is:global>
  :root {
    --c-text: #0f172a;
    --c-text-muted: #52627a;
    --c-surface: #ffffff;
    --c-surface-alt: #f5f6f8;
    --c-border: #e2e8f0;
    --c-border-strong: #cbd5e1;
    --c-accent: #f59e0b;
    /*
     * 본문 글자·테두리·포커스에 쓰는 진한 주황.
     * 배경이 흰색(#fff)에서 연회색(#f6f7f9)으로 바뀌면서 이전 값 #b85c00 이 4.29:1 로
     * 떨어져 WCAG AA(4.5:1)를 못 넘겼다. 지금 값은 연회색 위 4.98:1, 흰 배경 5.34:1,
     * 어두운 패널(#0a101c) 위 3.56:1 로 밝은 곳과 어두운 곳 모두에서 성립한다.
     * --c-accent(#f59e0b)는 흰 배경에서 2.15:1 이므로 글자·테두리에는 쓰지 않는다.
     */
    --c-accent-dark: #a85400;
    --c-accent-soft: #fff3dc;
    /* 어두운 배경 블록 — 히어로·수치 강조에 사용 */
    --c-ink: #0a101c;
    --c-ink-2: #111b2e;
    --c-on-ink: #f4f7fb;
    --c-on-ink-dim: #aab5c7;
    /* 제품 본체 색에서 추출한 브랜드 옐로. 안전경고(--c-warn)와는 명도·용도를 분리해서 쓴다. */
    --c-yellow: #ffb20b;
    --c-yellow-dark: #e48700;
    --c-warn: #d97706;
    --c-warn-soft: #fffbeb;
    --c-warn-border: #fcd9a4;
    --c-warn-text: #92400e;
    --c-danger: #dc2626;

    --w-page: 1160px;
    --w-narrow: 760px;
    --pad-x: 20px;

    /* 그림자 — 웹폰트 없이 깊이를 만드는 거의 유일한 수단이라 값을 통일해 쓴다 */
    --shadow-sm: 0 1px 2px rgb(11 37 69 / 0.06);
    --shadow-md: 0 18px 50px -24px rgb(11 18 32 / 0.35), 0 2px 8px rgb(11 18 32 / 0.08);

    /* 웹폰트 0 — 시스템 폰트만 사용 */
    --font-sans: system-ui, -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', '맑은 고딕',
      'Segoe UI', Roboto, sans-serif;
    /* 수치 표기 전용 — 폭 고정 숫자로 표가 흔들리지 않게 한다 */
    --font-num: ui-monospace, 'SF Mono', 'Cascadia Mono', Consolas, monospace;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    color: var(--c-text);
    background: var(--c-surface);
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  body > .shell {
    flex: 1 0 auto;
  }

  .shell {
    width: 100%;
    max-width: var(--w-page);
    margin: 0 auto;
    padding: 0 var(--pad-x) 4.5rem;
  }

  .shell--narrow {
    max-width: var(--w-narrow);
  }

  /*
   * 풀블리드 밴드 — 뷰포트 전체 폭 배경 위에 .shell과 같은 최대폭 안쪽 콘텐츠를 올린다.
   * 히어로처럼 섹션 배경만 화면 끝까지 채우고 싶을 때 쓴다.
   */
  .full-bleed {
    width: 100%;
  }

  .full-bleed__inner {
    max-width: var(--w-page);
    margin: 0 auto;
    padding: 0 var(--pad-x);
  }

  /*
   * 타이포 스케일.
   * 웹폰트를 못 쓰는 대신 크기·굵기·자간 대비를 크게 벌려 위계를 만든다.
   * 한글은 라틴보다 자간이 넓어 보이므로 큰 제목일수록 letter-spacing을 더 조인다.
   */
  h1,
  h2,
  h3,
  h4 {
    line-height: 1.28;
    color: var(--c-text);
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(2.1rem, 5.2vw, 3.1rem);
    font-weight: 850;
    letter-spacing: -0.05em;
    margin: 0.5rem 0 0.9rem;
  }

  h2 {
    font-size: clamp(1.75rem, 3.6vw, 2.45rem);
    font-weight: 850;
    letter-spacing: -0.045em;
    margin: 5rem 0 1rem;
  }

  /*
   * 읽는 문서(.shell--narrow = 가이드·활용사례·문제해결 20건, 개인정보·약관)는
   * 위의 랜딩용 타입 스케일을 쓰지 않는다.
   *
   * 홈·제품·모델비교는 훑어보는 화면이라 큰 제목이 맞지만, 문서는 처음부터 끝까지
   * 읽는 글이다. /guides/mosquito-control/ 은 h2가 11개라 랜딩 스케일을 그대로 두면
   * 제목과 여백만 1,019px — 페이지의 22%를 먹는다.
   * 2026-08-07 사장님 확인: 문서만 원래 크기로.
   */
  .shell--narrow h1 {
    font-size: clamp(1.9rem, 5.2vw, 2.65rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .shell--narrow h2 {
    font-size: clamp(1.4rem, 3.4vw, 1.75rem);
    font-weight: 750;
    letter-spacing: -0.025em;
    margin: 3rem 0 1rem;
  }

  h3 {
    font-size: 1.14rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 1.9rem 0 0.55rem;
  }

  /* 섹션 제목 위 짧은 액센트 바 — 색을 거의 쓰지 않는 레이아웃에 리듬을 준다 */
  .shell main > section > h2::before,
  .shell main > h2::before {
    content: '';
    display: block;
    width: 42px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--c-yellow), #ff6a00);
    margin-bottom: 0.9rem;
  }

  /* 제목 위 작은 라벨 */
  .eyebrow {
    display: inline-block;
    margin: 0 0 0.4rem;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--c-accent-dark);
    text-transform: uppercase;
  }

  /* 수치는 폭 고정 숫자로 */
  .num {
    font-family: var(--font-num);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  p,
  li {
    overflow-wrap: break-word;
  }

  a {
    color: var(--c-accent-dark);
    text-underline-offset: 2px;
  }

  /*
   * 포커스 테두리는 --c-accent(#f59e0b)를 쓰지 않는다. 흰 배경에서 2.15:1 이라
   * UI 요소 기준(3:1)에 미달해 키보드 사용자가 어디에 있는지 안 보인다.
   * --c-accent-dark 는 밝은 배경 5.34:1, 어두운 패널 3.56:1 로 양쪽 다 성립한다.
   */
  a:focus-visible,
  button:focus-visible,
  summary:focus-visible {
    outline: 3px solid var(--c-accent-dark);
    outline-offset: 2px;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  hr {
    border: 0;
    border-top: 1px solid var(--c-border);
    margin: 2rem 0;
  }

  code {
    background: var(--c-surface-alt);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    font-size: 0.9em;
  }

  /*
   * 키보드 사용자가 가장 먼저 만나는 요소다. 주황(#f59e0b) 위 흰 글자는 2.15:1 이라
   * 정작 눈에 안 띄었다. 어두운 바탕에 흰 글자로 바꿔 18:1 을 확보한다.
   */
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.6rem 1rem;
    background: var(--c-ink);
    color: #fff;
    font-weight: 700;
    border-bottom: 3px solid var(--c-accent);
  }

  .skip-link:focus {
    left: 0;
  }

  .lede {
    font-size: clamp(1.02rem, 2.2vw, 1.12rem);
    line-height: 1.75;
    color: var(--c-text-muted);
    margin: 0 0 1.75rem;
    max-width: 62ch;
    text-wrap: pretty;
  }

  /*
   * 섹션 패널.
   * 전폭 밴드는 가로 스크롤 위험이 있어 쓰지 않고, 안쪽에서 배경·여백으로 리듬을 만든다.
   */
  .panel {
    margin: 4rem 0;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--c-border);
    border-radius: 24px;
    background: var(--c-surface);
    box-shadow: var(--shadow-sm);
  }

  .panel--alt {
    background: var(--c-surface-alt);
    box-shadow: none;
  }

  .panel--ink {
    border-color: transparent;
    background: linear-gradient(135deg, var(--c-ink), var(--c-ink-2));
    color: var(--c-on-ink);
  }

  .panel--ink h2,
  .panel--ink h3 {
    color: #fff;
  }

  .panel--ink h2::before {
    background: var(--c-on-ink-dim);
  }

  .panel--ink a {
    color: #fff;
  }

  .panel > :first-child {
    margin-top: 0;
  }

  .panel > :last-child {
    margin-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
