---
import Analytics from '../components/Analytics.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';
import StickyBuyBar from '../components/StickyBuyBar.astro';
import { SITE } from '../data/site';
import type { ProductId } from '../data/products';
import { breadcrumbSchema, graph, type Crumb } from '../lib/schema';

interface Props {
  /** 30자 이내 고유 title */
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  updatedDate?: Date;
  /** 화면 브레드크럼 = BreadcrumbList. 홈("/")은 자동으로 맨 앞에 붙는다. */
  crumbs?: Crumb[];
  /** 홈의 Organization/WebSite, 문서의 Article 등 추가 JSON-LD 노드 */
  schemaNodes?: unknown[];
  /** 전환층 전용 하단 고정 구매바. 'generic'은 모델 미지정 바 */
  stickyBuy?: ProductId | 'generic' | false;
  /** 본문 최대폭 — 문서형은 narrow */
  width?: 'page' | 'narrow';
}

const {
  title,
  description,
  canonicalPath,
  ogImage,
  ogType = 'website',
  noindex = false,
  updatedDate,
  crumbs = [],
  schemaNodes = [],
  stickyBuy = false,
  width = 'page',
} = Astro.props;

const HOME: Crumb = { name: '홈', href: '/' };
const allCrumbs: Crumb[] = crumbs[0]?.href === '/' ? crumbs : [HOME, ...crumbs];

const jsonLd = graph([breadcrumbSchema(allCrumbs), ...schemaNodes]);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      updatedDate={updatedDate}
      jsonLd={jsonLd}
    />
    {/*
      브랜드 글꼴. 92개 unicode-range 조각으로 나뉘어 있어 브라우저가 그 페이지에
      실제로 쓰인 글자가 든 조각만 받는다. 첫 조각(라틴·숫자·기호)만 미리 받아 두면
      제목이 시스템 글꼴로 한 번 그려졌다가 바뀌는 깜빡임이 줄어든다.
    */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/pretendard/woff2/PretendardVariable.subset.0.woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/fonts/pretendard/pretendard.css" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <Analytics />
  </head>

  <body>
    <a class="skip-link" href="#main">본문 바로가기</a>
    <Header />

    <slot name="hero" />

    <div class:list={['shell', `shell--${width}`]}>
      {allCrumbs.length > 1 && <Breadcrumbs crumbs={allCrumbs} />}
      <main id="main">
        <slot />
      </main>
    </div>

    <Footer />
    {stickyBuy && <StickyBuyBar productId={stickyBuy === 'generic' ? undefined : stickyBuy} />}
  </body>
</html>

<style is:global>
  :root {
    /*
     * ── 블루가드 브랜드 색 ──
     * 상표권 폴더의 공식 로고에서 뽑은 값이다. 사이트가 쓰는 src/assets/brand/wordmark.png 는
     * 그 원본과 바이트 단위로 같은 파일이라, 로고와 화면 색이 어긋나면 안 된다.
     *
     * 브랜드 색은 네이비·시안 두 파랑과 회색뿐이다. 이전 강조색 #f59e0b 는 Tailwind
     * 기본 팔레트(amber-500)였고 로고와 무관했다. 제품 본체의 노랑은 사진 안에만 남기고
     * UI 색으로는 쓰지 않는다 — 안전 경고(--c-warn)와 헷갈리는 것도 막는다.
     */
    --c-navy: #004282;
    --c-cyan: #008fd5;
    /* 로고 G마크의 중간 톤. 시안과 네이비 사이를 잇는 값이라 그라디언트 끝에 쓴다 */
    --c-blue: #006cb8;
    /*
     * 액센트 바용 그라디언트.
     * 파랑 계열 안에서만 움직인다 — 디자인 시스템이 여러 색을 섞는 그라디언트를 금한다.
     */
    --grad-brand: linear-gradient(100deg, var(--c-cyan), var(--c-blue));
    /*
     * 구매 버튼 전용.
     *
     * 시안 위에는 흰 글자가 3.57:1 로 AA에 미달해서 진한 네이비 글자를 얹는다.
     * 그라디언트라 양 끝이 모두 4.5:1 을 넘어야 한다 — 지금 값은 6.05:1 / 4.81:1 이다.
     *
     * 디자인 시스템의 hover 규칙은 "한 단계 어둡게"지만 여기서는 반대로 밝힌다.
     * 시안을 더 어둡게 하면 --c-blue(#006cb8) 쪽으로 가는데 거기서는 진한 글자가
     * 3.13:1 로 무너진다. 밝히는 쪽은 7.21:1 / 5.15:1 로 오히려 여유가 늘어난다.
     */
    --grad-cta: linear-gradient(100deg, #19a3e5, var(--c-cyan));
    --grad-cta-hover: linear-gradient(100deg, #38b3ec, #0d95d8);
    --c-on-cta: #001b3d;

    --c-text: #0c1b33;
    --c-text-muted: #46586f;
    --c-surface: #ffffff;
    --c-surface-alt: #f1f5fa;
    --c-border: #dce4ee;
    --c-border-strong: #bccbdd;

    /* 채움·아이콘용 시안. 흰 배경 3.57:1 이라 본문 글자에는 쓰지 않는다 */
    --c-accent: var(--c-cyan);
    /*
     * 본문 글자·테두리에 쓰는 진한 파랑.
     * 흰 배경 9.99:1, 연회색(#f1f5fa) 위 9.2:1. 이전 주황(--c-accent-dark #a85400)이
     * 5.34:1 로 아슬아슬했던 것과 달리 여유가 크다.
     */
    --c-accent-dark: var(--c-navy);
    --c-accent-soft: #e4f1fb;
    /*
     * 포커스 테두리 전용.
     * --c-accent-dark 는 어두운 패널(--c-ink #042a60) 위에서 1.9:1 이라 쓸 수 없다.
     * 시안은 밝은 배경 3.57:1, 어두운 패널 위 5.34:1 로 양쪽 다 UI 기준(3:1)을 넘긴다.
     */
    --c-focus: var(--c-cyan);

    /* 어두운 배경 블록 — 히어로·수치 강조에 사용. 로고 그림자면의 딥네이비다 */
    --c-ink: #042a60;
    --c-ink-2: #04305f;
    --c-on-ink: #eaf2fb;
    --c-on-ink-dim: #9fb8d0;

    /*
     * 안전 경고는 브랜드 색과 분리해서 쓴다.
     * 디자인 시스템은 "경고에 빨강을 쓰지 말라"고 하지만 그것은 살충제 기준이다.
     * 연막소독기는 화기·고온 위험이 실재하므로 --c-danger 는 그대로 둔다.
     */
    --c-warn: #d97706;
    --c-warn-soft: #fffbeb;
    --c-warn-border: #fcd9a4;
    --c-warn-text: #92400e;
    --c-danger: #dc2626;

    --w-page: 1160px;
    --w-narrow: 760px;
    --pad-x: 20px;

    /*
     * 모서리 — 디자인 시스템이 정한 단계. 이 밖의 값은 쓰지 않는다.
     * 이전에는 사이트 안에 12종이 흩어져 있어 규칙이 없어 보였다.
     */
    --r-tag: 4px;
    --r-sm: 6px;
    --r-btn: 10px;
    --r-card: 16px;
    --r-tile: 20px;
    --r-panel: 24px;
    --r-hero: 32px;
    --r-pill: 999px;

    /* 그림자는 중성 검정이 아니라 차가운 네이비 기운으로 — 디자인 시스템 규정 */
    --shadow-sm: 0 1px 2px rgb(9 32 63 / 0.06);
    --shadow-md: 0 18px 50px -24px rgb(9 32 63 / 0.35), 0 2px 8px rgb(9 32 63 / 0.08);

    /*
     * 브랜드 지정 글꼴. public/fonts/pretendard/ 에 자체 호스팅한 변수 폰트를 쓴다.
     * unicode-range 로 92조각이 나뉘어 있어 브라우저는 그 페이지에 실제로 쓰인
     * 글자가 든 조각만 내려받는다. 사장님이 편집 화면에서 어떤 글자를 넣어도 빠지지 않는다.
     */
    --font-sans: 'Pretendard Variable', Pretendard, system-ui, -apple-system,
      'Apple SD Gothic Neo', 'Malgun Gothic', '맑은 고딕', 'Segoe UI', Roboto, sans-serif;
    /* 수치 표기 전용 — 폭 고정 숫자로 표가 흔들리지 않게 한다 */
    --font-num: ui-monospace, 'SF Mono', 'Cascadia Mono', Consolas, monospace;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    color: var(--c-text);
    background: var(--c-surface);
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  body > .shell {
    flex: 1 0 auto;
  }

  .shell {
    width: 100%;
    max-width: var(--w-page);
    margin: 0 auto;
    padding: 0 var(--pad-x) 4.5rem;
  }

  .shell--narrow {
    max-width: var(--w-narrow);
  }

  /*
   * 풀블리드 밴드 — 뷰포트 전체 폭 배경 위에 .shell과 같은 최대폭 안쪽 콘텐츠를 올린다.
   * 히어로처럼 섹션 배경만 화면 끝까지 채우고 싶을 때 쓴다.
   */
  .full-bleed {
    width: 100%;
  }

  .full-bleed__inner {
    max-width: var(--w-page);
    margin: 0 auto;
    padding: 0 var(--pad-x);
  }

  /*
   * 타이포 스케일.
   *
   * 이전에는 웹폰트가 없어 굵기 850·750 같은 값으로 위계를 억지로 벌렸다. 시스템 글꼴에는
   * 그런 굵기가 없어 브라우저가 700으로 눌러 그렸기 때문에 실제로는 문제가 없었다.
   * 지금은 Pretendard 변수 폰트라 850을 적으면 진짜 850으로 그려져 과하게 뭉친다.
   * 그래서 제목은 모두 700으로 맞추고 위계는 크기와 자간이 지게 했다.
   *
   * 한글은 라틴보다 자간이 넓어 보이므로 조여 주되, 디자인 시스템의 -0.02em 을 기준으로
   * 큰 제목만 조금 더 당긴다. 이전 -0.05em 은 Pretendard 에서 글자가 붙어 보인다.
   */
  h1,
  h2,
  h3,
  h4 {
    line-height: 1.28;
    color: var(--c-text);
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(2.1rem, 5.2vw, 3.1rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin: 0.5rem 0 0.9rem;
  }

  h2 {
    font-size: clamp(1.75rem, 3.6vw, 2.45rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin: 5rem 0 1rem;
  }

  /*
   * 읽는 문서(.shell--narrow = 가이드·활용사례·문제해결 20건, 개인정보·약관)는
   * 위의 랜딩용 타입 스케일을 쓰지 않는다.
   *
   * 홈·제품·모델비교는 훑어보는 화면이라 큰 제목이 맞지만, 문서는 처음부터 끝까지
   * 읽는 글이다. /guides/mosquito-control/ 은 h2가 11개라 랜딩 스케일을 그대로 두면
   * 제목과 여백만 1,019px — 페이지의 22%를 먹는다.
   * 2026-08-07 사장님 확인: 문서만 원래 크기로.
   */
  .shell--narrow h1 {
    font-size: clamp(1.9rem, 5.2vw, 2.65rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .shell--narrow h2 {
    font-size: clamp(1.4rem, 3.4vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 3rem 0 1rem;
  }

  h3 {
    font-size: 1.14rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 1.9rem 0 0.55rem;
  }

  /* 섹션 제목 위 짧은 액센트 바 — 색을 거의 쓰지 않는 레이아웃에 리듬을 준다 */
  .shell main > section > h2::before,
  .shell main > h2::before {
    content: '';
    display: block;
    width: 42px;
    height: 3px;
    border-radius: var(--r-pill);
    background: var(--grad-brand);
    margin-bottom: 0.9rem;
  }

  /* 제목 위 작은 라벨 */
  .eyebrow {
    display: inline-block;
    margin: 0 0 0.4rem;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--c-accent-dark);
    text-transform: uppercase;
  }

  /* 수치는 폭 고정 숫자로 */
  .num {
    font-family: var(--font-num);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  p,
  li {
    overflow-wrap: break-word;
  }

  a {
    color: var(--c-accent-dark);
    text-underline-offset: 2px;
  }

  /*
   * 포커스는 밝은 화면과 어두운 패널 양쪽에서 보여야 한다.
   * --c-accent-dark(네이비)는 흰 배경 9.99:1 로 좋지만 어두운 패널 위에서 1.9:1 이라
   * 히어로·수치 블록 안에서는 사라진다. --c-focus(시안)는 3.57:1 / 5.34:1 로 양쪽 다 넘긴다.
   */
  a:focus-visible,
  button:focus-visible,
  summary:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 2px;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  hr {
    border: 0;
    border-top: 1px solid var(--c-border);
    margin: 2rem 0;
  }

  code {
    background: var(--c-surface-alt);
    padding: 0.1em 0.35em;
    border-radius: var(--r-tag);
    font-size: 0.9em;
  }

  /*
   * 키보드 사용자가 가장 먼저 만나는 요소라 대비를 넉넉히 둔다.
   * 어두운 네이비 바탕에 흰 글자로 13.9:1 이다.
   */
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.6rem 1rem;
    background: var(--c-ink);
    color: #fff;
    font-weight: 700;
    border-bottom: 3px solid var(--c-accent);
  }

  .skip-link:focus {
    left: 0;
  }

  .lede {
    font-size: clamp(1.02rem, 2.2vw, 1.12rem);
    line-height: 1.75;
    color: var(--c-text-muted);
    margin: 0 0 1.75rem;
    max-width: 62ch;
    text-wrap: pretty;
  }

  /*
   * 섹션 패널.
   * 전폭 밴드는 가로 스크롤 위험이 있어 쓰지 않고, 안쪽에서 배경·여백으로 리듬을 만든다.
   */
  .panel {
    margin: 4rem 0;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--c-border);
    border-radius: var(--r-panel);
    background: var(--c-surface);
    box-shadow: var(--shadow-sm);
  }

  .panel--alt {
    background: var(--c-surface-alt);
    box-shadow: none;
  }

  .panel--ink {
    border-color: transparent;
    background: linear-gradient(135deg, var(--c-ink), var(--c-ink-2));
    color: var(--c-on-ink);
  }

  .panel--ink h2,
  .panel--ink h3 {
    color: #fff;
  }

  .panel--ink h2::before {
    background: var(--c-on-ink-dim);
  }

  .panel--ink a {
    color: #fff;
  }

  .panel > :first-child {
    margin-top: 0;
  }

  .panel > :last-child {
    margin-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
