---
import { Image } from 'astro:assets';
import wordmark from '../assets/brand/wordmark.png';
import { BUSINESS, EXTERNAL, SITE } from '../data/site';

const year = new Date().getFullYear();

const businessRows = [
  { label: '상호', value: BUSINESS.name },
  { label: '대표자', value: BUSINESS.ceo },
  { label: '사업자등록번호', value: BUSINESS.businessNumber },
  { label: '통신판매업신고', value: BUSINESS.mailOrderNumber },
  { label: '주소', value: BUSINESS.address },
  { label: '전화', value: BUSINESS.tel },
].filter((row) => row.value);

const columns = [
  {
    title: '제품',
    links: [
      { label: '제품 라인업', href: '/products/' },
      { label: '모델 비교표', href: '/compare/' },
      // 헤더 메뉴(site.ts NAV)는 4개로 줄여 둔 상태라 이 둘은 여기가 주 진입 경로다
      { label: '연무기', href: '/mist/' },
      { label: '방역기', href: '/equipment/' },
    ],
  },
  {
    title: '기술문서',
    links: [
      { label: '사용법', href: '/guides/' },
      // 활용사례·문제해결은 헤더 메뉴에서 뺐으므로(site.ts NAV) 여기가 주 진입 경로다
      { label: '활용사례', href: '/uses/' },
      { label: '문제해결', href: '/troubleshooting/' },
      { label: '안전수칙', href: '/safety/' },
    ],
  },
  {
    title: '고객지원',
    links: [
      { label: '기술지원 문의', href: `mailto:${BUSINESS.email}` },
      { label: '블루가드 공식몰', href: EXTERNAL.corporate, external: true },
    ],
  },
  {
    title: '정책',
    links: [
      { label: '개인정보처리방침', href: '/privacy/' },
      { label: '이용약관', href: '/terms/' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <Image src={wordmark} width={280} height={66} alt={SITE.name} class="site-footer__logo" />
        <p class="site-footer__blurb">
          휴대용 부탄가스 연막소독기의 사양, 사용법, 안전수칙을 정리한 공식 기술정보
          사이트입니다.
        </p>
      </div>

      {
        columns.map((col) => (
          <nav class="site-footer__col" aria-label={col.title}>
            <h2>{col.title}</h2>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a href={link.href} {...(link.external ? { target: '_blank', rel: 'noopener external' } : {})}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <hr class="site-footer__rule" />

    <dl class="site-footer__business">
      {
        businessRows.map((row) => (
          <div>
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))
      }
      <div>
        <dt>이메일</dt>
        <dd><a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a></dd>
      </div>
    </dl>

    <p class="site-footer__copy">© {year} {SITE.name}. 제품 사양은 공지 없이 변경될 수 있습니다.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 3.5rem;
    background: var(--c-ink);
    color: var(--c-on-ink);
  }

  .site-footer__inner {
    max-width: var(--w-page);
    margin: 0 auto;
    padding: 2.75rem var(--pad-x) 2rem;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(4, 1fr);
    gap: 2rem;
  }

  .site-footer__logo {
    height: 30px;
    width: auto;
    display: block;
    /* 워드마크가 진한 네이비 계열이라 어두운 배경에서는 밝게 반전한다 */
    filter: brightness(0) invert(1);
    opacity: 0.95;
  }

  .site-footer__blurb {
    margin: 0.9rem 0 0;
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--c-on-ink-dim);
    max-width: 32ch;
  }

  .site-footer__col h2 {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--c-on-ink-dim);
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .site-footer__col a {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--c-on-ink);
    text-decoration: none;
  }

  .site-footer__col a:hover {
    text-decoration: underline;
  }

  .site-footer__rule {
    margin: 2.25rem 0 1.5rem;
    border: 0;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .site-footer__business {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
    font-size: 0.8rem;
    color: var(--c-on-ink-dim);
    line-height: 1.6;
  }

  .site-footer__business div {
    display: flex;
    gap: 0.4rem;
  }

  .site-footer__business dt {
    font-weight: 600;
    color: var(--c-on-ink);
  }

  .site-footer__business dd {
    margin: 0;
  }

  .site-footer__business a {
    color: var(--c-on-ink-dim);
  }

  .site-footer__copy {
    margin: 1.5rem 0 0;
    font-size: 0.76rem;
    color: var(--c-on-ink-dim);
    opacity: 0.85;
  }

  @media (max-width: 860px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 2rem;
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
