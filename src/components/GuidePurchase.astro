---
import BuyCTA from './BuyCTA.astro';
import { COMPARE_PAGE } from '../data/pages';

interface Props {
  content: string;
}

const { content } = Astro.props;
---

<section id="model-guide" tabindex="-1" aria-labelledby="model-guide-title">
  <h2 id="model-guide-title">어떤 모델이 맞을까요?</h2>
  <p>{COMPARE_PAGE.lede}</p>
  <a class="model-link" href="/compare/#model-guide">세 모델의 실물 사진과 구성품 비교하기</a>
  <p class="store-note">구성을 정하셨다면 공식몰 상품 화면에서 같은 이름의 옵션을 직접 선택하세요.</p>
  <BuyCTA content={content} variant="secondary" label="공식몰에서 옵션 선택하기" />
</section>

<style>
  #model-guide {
    margin: 2rem 0 0;
    padding: 1.25rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-card);
    background: var(--c-surface-alt);
    scroll-margin-top: 7.5rem;
  }

  h2 { margin: 0 0 0.6rem; }
  p { margin: 0 0 0.65rem; }
  .model-link { font-weight: 700; }
  .store-note { margin-top: 1.2rem; }
</style>
