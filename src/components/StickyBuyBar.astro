---
import { getProduct, maxFillLiters, type ProductId } from '../data/products';
import { BUY_CTA_LABEL, BUY_CTA_LABEL_SHORT, OFFICIAL_STORE_PRODUCT_URL, SITE } from '../data/site';
import { withUtm } from '../lib/url';

/**
 * 전환층(제품·모델비교·구매 유도 문서) 전용 하단 고정 바.
 * 정보성 문서 전반에는 붙이지 않는다.
 */
interface Props {
  /** 모델이 특정된 페이지에서만 지정. 생략하면 모델 미지정 바 */
  productId?: ProductId;
  /** utm_content 접미사 — 기본 sticky_bar */
  content?: string;
}

const { productId, content = 'sticky_bar' } = Astro.props;

const product = productId ? getProduct(productId) : null;
const href = withUtm(product?.buyUrl ?? OFFICIAL_STORE_PRODUCT_URL, { content });
---

<div class="sticky-bar" data-sticky-buy-bar>
  <div class="sticky-bar__inner">
    <div class="sticky-bar__info">
      <strong class="sticky-bar__model">{product?.officialLabel ?? SITE.name}</strong>
      <span class="sticky-bar__spec">
        {
          product
            ? `탱크 ${product.tankLiters}L · 최대충전 ${maxFillLiters(product.tankLiters)}L`
            : '공식몰에서 모델 옵션을 선택합니다'
        }
      </span>
    </div>
    <a
      class="sticky-bar__cta"
      href={href}
      target="_blank"
      rel="noopener external"
      data-ga-event="purchase_cta_click"
      data-ga-utm-content={content}
      data-ga-model={product?.officialLabel}
      data-ga-product-id={product?.id}
    >
      {product ? BUY_CTA_LABEL_SHORT : BUY_CTA_LABEL}
    </a>
  </div>
</div>

<style>
  .sticky-bar {
    position: sticky;
    bottom: 0;
    z-index: 40;
    height: 60px;
    background: rgb(4 42 96 / 0.96);
    border-top: 1px solid rgb(255 255 255 / 0.1);
    box-shadow: 0 -12px 30px rgb(4 9 18 / 0.2);
    backdrop-filter: blur(14px);
  }

  .sticky-bar__inner {
    height: 100%;
    max-width: var(--w-page);
    margin: 0 auto;
    padding: 0 var(--pad-x);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .sticky-bar__info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .sticky-bar__model {
    font-size: 0.95rem;
    line-height: 1.2;
    color: #fff;
  }

  .sticky-bar__spec {
    font-size: 0.8rem;
    color: var(--c-on-ink-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sticky-bar__cta {
    flex: none;
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 1.25rem;
    border-radius: var(--r-pill);
    background: var(--grad-cta);
    color: var(--c-on-cta);
    font-weight: 700;
    text-decoration: none;
  }

  .sticky-bar__cta:hover {
    background: var(--grad-cta-hover);
  }

  @media (min-width: 721px) {
    .sticky-bar {
      display: none;
    }
  }

  @media print {
    .sticky-bar {
      display: none;
    }
  }
</style>
