---
/**
 * 영상 자리(placeholder).
 *
 * - `video`가 없으면 "촬영 예정" 자리표시 박스만 렌더링한다.
 * - `video`가 있으면 클릭 전에는 어떤 외부 요청도 하지 않는 파사드로 두고,
 *   클릭 시점에 iframe을 주입하면서 GA4 `video_play`를 보낸다.
 */
interface Props {
  video?: { provider: 'youtube'; id: string; title: string };
  /** 자리표시 상태에서 보여줄 설명 */
  placeholderNote?: string;
  caption?: string;
}

const { video, placeholderNote = '실제 작동 영상은 촬영 후 이 자리에 추가됩니다.', caption } =
  Astro.props;
---

<figure class="video">
  {
    video ? (
      <div
        class="video__facade"
        data-video-facade
        data-video-id={video.id}
        data-video-title={video.title}
      >
        <button type="button" class="video__play" aria-label={`${video.title} 재생`}>
          <span class="video__play-icon" aria-hidden="true" />
          <span class="video__play-label">{video.title}</span>
        </button>
      </div>
    ) : (
      <div class="video__placeholder">
        <span class="video__placeholder-badge">영상 자리</span>
        <p class="video__placeholder-note">{placeholderNote}</p>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .video {
    margin: 1.75rem 0;
  }

  .video__facade,
  .video__placeholder {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .video__facade {
    background: linear-gradient(135deg, #1e293b, #0f172a);
  }

  .video__play {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    background: none;
    border: 0;
    color: #fff;
    cursor: pointer;
    padding: 1rem;
    font: inherit;
  }

  .video__play-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.16);
    border: 2px solid rgb(255 255 255 / 0.7);
    position: relative;
  }

  .video__play-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 54%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 11px 0 11px 18px;
    border-color: transparent transparent transparent #fff;
  }

  .video__play-label {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .video__placeholder {
    background: var(--c-surface-alt);
    border: 1px dashed var(--c-border-strong);
    flex-direction: column;
    gap: 0.6rem;
    text-align: center;
    padding: 1rem;
  }

  .video__placeholder-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    color: var(--c-text-muted);
  }

  .video__placeholder-note {
    margin: 0;
    font-size: 0.9rem;
    color: var(--c-text-muted);
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--c-text-muted);
  }

  .video :global(iframe) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 10px;
    display: block;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video-facade]').forEach((facade) => {
    facade.addEventListener(
      'click',
      () => {
        const id = facade.dataset.videoId;
        const title = facade.dataset.videoTitle ?? '';
        if (!id) return;

        window.gtag?.('event', 'video_play', { video_id: id, video_title: title });

        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
        iframe.title = title;
        iframe.loading = 'lazy';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        facade.replaceWith(iframe);
      },
      { once: true },
    );
  });
</script>
