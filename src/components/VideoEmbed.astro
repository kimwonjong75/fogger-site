---
import { Image } from 'astro:assets';
import poster from '../assets/video-poster-howto.jpg';
import { HOWTO_VIDEO } from '../data/media';

/**
 * 공식 사용법 영상.
 *
 * 자체 호스팅이라 외부 요청이 없고, 클릭 전에는 <video>를 만들지 않으므로
 * 초기 페이지 전송량에 영향을 주지 않는다(포스터 이미지만 lazy 로드).
 * 재생 시 GA4 `video_play`를 보낸다.
 */
interface Props {
  caption?: string;
  /** 영상이 준비되지 않은 자리에 쓰는 안내 (영상을 넘기지 않을 때만) */
  placeholderNote?: string;
  /** true면 영상 대신 자리표시 박스를 렌더링 */
  placeholder?: boolean;
}

const {
  caption = '블루가드 공식 사용방법 안내 영상입니다. 재생을 누르면 영상이 내려받아집니다.',
  placeholderNote = '실제 작동 영상은 촬영 후 이 자리에 추가됩니다.',
  placeholder = false,
} = Astro.props;

const minutes = Math.floor(HOWTO_VIDEO.durationSec / 60);
const seconds = String(HOWTO_VIDEO.durationSec % 60).padStart(2, '0');
---

<figure class="video">
  {
    placeholder ? (
      <div class="video__placeholder">
        <span class="video__placeholder-badge">영상 자리</span>
        <p class="video__placeholder-note">{placeholderNote}</p>
      </div>
    ) : (
      <div
        class="video__facade"
        data-video-facade
        data-video-src={HOWTO_VIDEO.src}
        data-video-title={HOWTO_VIDEO.title}
      >
        <Image
          src={poster}
          alt={`${HOWTO_VIDEO.title} — 작업 전 준비 단계를 설명하는 영상 첫 장면`}
          width={HOWTO_VIDEO.width}
          height={HOWTO_VIDEO.height}
          loading="lazy"
          decoding="async"
          class="video__poster"
        />
        <button type="button" class="video__play">
          <span class="video__play-icon" aria-hidden="true" />
          <span class="video__play-label">
            {HOWTO_VIDEO.title} 재생
            <span class="video__play-meta">
              {minutes}분 {seconds}초 · 소리 있음
            </span>
          </span>
        </button>
      </div>
    )
  }
  {caption && !placeholder && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .video {
    margin: 1.75rem 0;
  }

  .video__facade,
  .video__placeholder {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--c-ink);
  }

  .video :global(.video__poster) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video__play {
    position: absolute;
    inset: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: rgb(11 37 69 / 0.45);
    border: 0;
    color: #fff;
    cursor: pointer;
    padding: 1rem;
    font: inherit;
    transition: background-color 0.15s ease;
  }

  .video__play:hover {
    background: rgb(11 37 69 / 0.3);
  }

  .video__play-icon {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.18);
    border: 2px solid rgb(255 255 255 / 0.85);
    position: relative;
    backdrop-filter: blur(2px);
  }

  .video__play-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 54%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 12px 0 12px 19px;
    border-color: transparent transparent transparent #fff;
  }

  .video__play-label {
    display: grid;
    gap: 0.2rem;
    font-size: 1rem;
    font-weight: 700;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.5);
  }

  .video__play-meta {
    font-size: 0.8rem;
    font-weight: 500;
    opacity: 0.9;
  }

  .video__placeholder {
    background: var(--c-surface-alt);
    border: 1px dashed var(--c-border-strong);
    flex-direction: column;
    gap: 0.6rem;
    text-align: center;
    padding: 1rem;
  }

  .video__placeholder-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    color: var(--c-text-muted);
  }

  .video__placeholder-note {
    margin: 0;
    font-size: 0.9rem;
    color: var(--c-text-muted);
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--c-text-muted);
  }

  .video :global(video) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    display: block;
    background: #000;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video-facade]').forEach((facade) => {
    facade.addEventListener(
      'click',
      () => {
        const src = facade.dataset.videoSrc;
        const title = facade.dataset.videoTitle ?? '';
        if (!src) return;

        window.gtag?.('event', 'video_play', { video_title: title, video_src: src });

        const video = document.createElement('video');
        video.src = src;
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        video.preload = 'auto';
        video.setAttribute('title', title);
        facade.replaceWith(video);
        video.focus();
      },
      { once: true },
    );
  });
</script>
