---
import { MANUAL } from '../data/media';

/**
 * 공식 사용설명서 내려받기.
 *
 * 제조사가 만든 1차 자료라 검색·AI 인용 관점에서 신뢰 근거가 된다.
 * 클릭 시 GA4 `manual_download` 이벤트를 보낸다.
 */
interface Props {
  variant?: 'block' | 'inline';
}

const { variant = 'block' } = Astro.props;
---

<a
  class:list={['manual', `manual--${variant}`]}
  href={MANUAL.href}
  download
  data-ga-event="manual_download"
  data-ga-manual-name={MANUAL.name}
  data-ga-file-type={MANUAL.fileType}
>
  <svg class="manual__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V7zM14 3v4h4" />
    <path d="M12 11v6m0 0-2.5-2.5M12 17l2.5-2.5" />
  </svg>
  <span class="manual__body">
    <strong>{MANUAL.label}</strong>
    <span class="manual__meta">
      BF-100S · BF-102 공용 · PDF {MANUAL.pages}쪽 · {MANUAL.sizeLabel}
    </span>
  </span>
</a>

<style>
  .manual {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--c-text);
    border: 1px solid var(--c-border-strong);
    border-radius: 10px;
    padding: 0.8rem 1.1rem;
    background: var(--c-surface);
    min-height: 44px;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .manual:hover {
    border-color: var(--c-accent);
    background: var(--c-accent-soft);
  }

  .manual--block {
    display: flex;
    margin: 1.5rem 0;
  }

  .manual__icon {
    flex: none;
    width: 26px;
    height: 26px;
    fill: none;
    stroke: var(--c-accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .manual__body {
    display: grid;
    gap: 0.1rem;
  }

  .manual__body strong {
    font-size: 0.98rem;
  }

  .manual__meta {
    font-size: 0.8rem;
    color: var(--c-text-muted);
  }
</style>
