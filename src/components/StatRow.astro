---
import {
  FILL_RATIO_LABEL,
  HEAT_SOURCE,
  PRODUCTS,
  maxFillLiters,
} from '../data/products';

/**
 * 핵심 수치 강조 블록.
 *
 * 우리가 확실히 아는 값(탱크 용량, 최대 충전량, 충전 한도, 가열원)을 크게 세운다.
 * 표 안에 묻혀 있던 숫자를 시각적 앵커로 끌어올려, 사람에게는 스캔 포인트가 되고
 * 답변 엔진에는 잘라내도 뜻이 통하는 자족적 사실 단위가 된다.
 */
interface Props {
  variant?: 'ink' | 'plain';
}

const { variant = 'ink' } = Astro.props;

const tanks = PRODUCTS.map((p) => p.tankLiters);
const minTank = Math.min(...tanks);
const maxTank = Math.max(...tanks);

const stats = [
  {
    value: `${minTank}–${maxTank}`,
    unit: 'L',
    label: '탱크 용량',
    note: `모델에 따라 ${minTank}L 또는 ${maxTank}L`,
  },
  {
    value: `${maxFillLiters(minTank)}–${maxFillLiters(maxTank)}`,
    unit: 'L',
    label: '최대 충전량',
    note: `탱크 용량의 ${FILL_RATIO_LABEL} 상한`,
  },
  {
    value: FILL_RATIO_LABEL.replace('%', ''),
    unit: '%',
    label: '충전 한도',
    note: '넘겨 채우면 넘침·역류 위험',
  },
  {
    value: HEAT_SOURCE,
    unit: '',
    label: '가열원',
    note: '별도 전원 없이 작동',
  },
];
---

<dl class:list={['stats', `stats--${variant}`]}>
  {
    stats.map((stat) => (
      <div class="stats__item">
        <dt class="stats__label">{stat.label}</dt>
        <dd class:list={['stats__value', !/^[\d.–-]+$/.test(stat.value) && 'stats__value--text']}>
          {/* 숫자에만 폭 고정 글꼴을 쓴다. 한글에 적용하면 폴백이 일어나 글꼴이 튄다 */}
          <span class:list={[/^[\d.–-]+$/.test(stat.value) && 'num']}>{stat.value}</span>
          {stat.unit && <span class="stats__unit">{stat.unit}</span>}
        </dd>
        <p class="stats__note">{stat.note}</p>
      </div>
    ))
  }
</dl>

<style>
  .stats {
    margin: 2rem 0;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: 14px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .stats--ink {
    background: linear-gradient(135deg, var(--c-ink), var(--c-ink-2));
    color: var(--c-on-ink);
  }

  .stats--plain {
    background: var(--c-surface-alt);
    border: 1px solid var(--c-border);
  }

  .stats__item {
    display: grid;
    gap: 0.15rem;
    align-content: start;
  }

  .stats__item + .stats__item {
    padding-left: 1.25rem;
    border-left: 1px solid rgb(255 255 255 / 0.16);
  }

  .stats--plain .stats__item + .stats__item {
    border-left-color: var(--c-border);
  }

  .stats__label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    opacity: 0.75;
  }

  .stats__value {
    margin: 0;
    font-size: clamp(1.5rem, 3.6vw, 2rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    display: flex;
    align-items: baseline;
    gap: 0.1em;
  }

  /* 한글 값은 같은 크기로 두면 과하게 커 보인다 */
  .stats__value--text {
    font-size: clamp(1.2rem, 2.6vw, 1.45rem);
    letter-spacing: -0.02em;
  }

  .stats__unit {
    font-size: 0.55em;
    font-weight: 700;
    opacity: 0.8;
  }

  .stats__note {
    margin: 0.2rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    opacity: 0.7;
  }

  @media (max-width: 780px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.1rem;
    }

    .stats__item:nth-child(odd) + .stats__item,
    .stats__item + .stats__item {
      padding-left: 0;
      border-left: 0;
    }

    .stats__item:nth-child(even) {
      padding-left: 1.1rem;
      border-left: 1px solid rgb(255 255 255 / 0.16);
    }

    .stats--plain .stats__item:nth-child(even) {
      border-left-color: var(--c-border);
    }
  }
</style>
