---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * astro:assets 래퍼.
 * - AVIF/WebP 를 생성하고 원본 포맷으로 폴백한다.
 * - width/height 를 필수로 받아 CLS를 없앤다.
 * - 히어로가 아니면 lazy 로딩.
 * - alt 는 "{주제} — {구체 장면}" 형식을 강제한다.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  width: number;
  height: number;
  /** 히어로 이미지 여부 — true면 eager + high priority */
  priority?: boolean;
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  priority = false,
  sizes = '(max-width: 760px) 100vw, 760px',
  class: className,
} = Astro.props;

if (!alt.includes(' — ')) {
  throw new Error(
    `[Pic] alt는 "{주제} — {구체 장면}" 형식이어야 합니다(em dash 앞뒤 공백). 받은 값: "${alt}"`,
  );
}
---

<Picture
  src={src}
  alt={alt}
  width={width}
  height={height}
  widths={[Math.round(width / 2), width, width * 2]}
  sizes={sizes}
  formats={['avif', 'webp']}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  class={className}
/>
