---
import { GA4_MEASUREMENT_ID, SITE } from '../data/site';

/**
 * GA4 계측.
 *
 * 두 가지 조건을 모두 만족할 때만 gtag.js를 불러온다.
 *  1. 측정 ID가 자리표시자가 아닌 실제 값
 *  2. 현재 호스트가 운영 도메인
 *
 * 2번이 없으면 localhost·프리뷰 배포·스테이징에서 발생한 조회가 운영 통계에 섞인다.
 * 이 조건은 GA4 관리화면의 내부 트래픽 필터를 대신하지 않는다 — 사무실 IP 필터는 별도로 건다.
 *
 * 수집 이벤트
 *  - purchase_cta_click : utm_content, model, product_id
 *  - model_select       : model, product_id, context
 *  - video_play         : video_title, video_src   (VideoEmbed에서 발생)
 *  - safety_print       : manual_name, file_type   (안전수칙 인쇄/PDF 저장 버튼)
 *  - scroll_75          : page_path (페이지당 1회)
 */
const isRealId = /^G-[A-Z0-9]{6,}$/.test(GA4_MEASUREMENT_ID) && !/^G-X+$/.test(GA4_MEASUREMENT_ID);
/** 자리표시자 ID는 산출물에 내보내지 않는다 */
const measurementId = isRealId ? GA4_MEASUREMENT_ID : '';
/** 계측을 켤 호스트 */
const analyticsHost = new URL(SITE.url).hostname;
---

<script is:inline define:vars={{ measurementId, isRealId, analyticsHost }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    window.dataLayer.push(arguments);
  }
  window.gtag = window.gtag || gtag;

  // 운영 도메인이 아니면 외부 요청 자체를 만들지 않는다.
  if (isRealId && location.hostname === analyticsHost) {
    const loader = document.createElement('script');
    loader.async = true;
    loader.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
    document.head.appendChild(loader);

    gtag('js', new Date());
    gtag('config', measurementId, { send_page_view: true });
  }
</script>

<script>
  type GaParams = Record<string, string | number | undefined>;

  function track(name: string, params: GaParams): void {
    const clean: GaParams = {};
    for (const [key, value] of Object.entries(params)) {
      if (value !== undefined && value !== '') clean[key] = value;
    }
    // gtag 한 경로로만 보낸다 (GTM 병행 시 중복 집계를 피하기 위해 dataLayer 직접 push는 하지 않는다)
    window.gtag?.('event', name, clean);
  }

  /* 클릭 이벤트 위임 — data-ga-event 를 가진 요소 전부 */
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const el = target?.closest<HTMLElement>('[data-ga-event]');
    if (!el) return;

    const name = el.dataset.gaEvent;
    if (!name) return;

    track(name, {
      utm_content: el.dataset.gaUtmContent,
      model: el.dataset.gaModel,
      product_id: el.dataset.gaProductId,
      context: el.dataset.gaContext,
      manual_name: el.dataset.gaManualName,
      file_type: el.dataset.gaFileType,
      link_url: el instanceof HTMLAnchorElement ? el.href : undefined,
      page_path: location.pathname,
    });
  });

  /* scroll_75 — 페이지당 1회 */
  let scroll75Sent = false;
  function checkScrollDepth(): void {
    if (scroll75Sent) return;
    const doc = document.documentElement;
    const scrollable = doc.scrollHeight - window.innerHeight;
    if (scrollable <= 0) return;
    const depth = (window.scrollY / scrollable) * 100;
    if (depth < 75) return;

    scroll75Sent = true;
    window.removeEventListener('scroll', checkScrollDepth);
    track('scroll_75', { page_path: location.pathname, percent_scrolled: 75 });
  }

  window.addEventListener('scroll', checkScrollDepth, { passive: true });
  checkScrollDepth();
</script>
