---
import { Image } from 'astro:assets';
import wordmark from '../assets/brand/wordmark.png';
import BuyCTA from './BuyCTA.astro';
import { BUY_CTA_LABEL_SHORT, NAV, SITE } from '../data/site';
import { normalizePath } from '../lib/url';

const current = normalizePath(Astro.url.pathname);
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header class="site-header">
  <div class="site-header__row">
    <a class="site-header__brand" href="/">
      <Image
        src={wordmark}
        width={380}
        height={90}
        alt={SITE.name}
        loading="lazy"
        decoding="async"
        class="site-header__logo"
      />
    </a>

    <nav class="site-header__nav" aria-label="주요 메뉴">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <BuyCTA content="header" label={BUY_CTA_LABEL_SHORT} class="site-header__buy" />

      <details class="site-header__toggle">
        <summary aria-label="메뉴 열기">
          <span class="site-header__toggle-bar" aria-hidden="true" />
        </summary>
        <nav class="site-header__mobile-nav" aria-label="주요 메뉴 (모바일)">
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--c-border);
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: saturate(180%) blur(8px);
  }

  .site-header__row {
    max-width: var(--w-page);
    margin: 0 auto;
    padding: 0 var(--pad-x);
    min-height: 60px;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .site-header__brand {
    flex: none;
    display: inline-flex;
    align-items: center;
  }

  .site-header__logo {
    display: block;
    height: 26px;
    width: auto;
  }

  .site-header__nav {
    flex: 1;
    min-width: 0;
  }

  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 0.75rem;
    white-space: nowrap;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--c-text-muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .site-header__nav a:hover {
    color: var(--c-text);
  }

  .site-header__nav a[aria-current='page'] {
    color: var(--c-accent-dark);
    border-bottom-color: var(--c-accent);
  }

  .site-header__actions {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* 모바일 토글 — <details>/<summary> 만으로 구현해 JS가 필요 없다 */
  .site-header__toggle {
    display: none;
    position: relative;
  }

  .site-header__toggle summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    border: 1px solid var(--c-border-strong);
    cursor: pointer;
    list-style: none;
  }

  .site-header__toggle summary::-webkit-details-marker {
    display: none;
  }

  .site-header__toggle-bar,
  .site-header__toggle-bar::before,
  .site-header__toggle-bar::after {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--c-text);
    border-radius: 1px;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .site-header__toggle-bar {
    position: relative;
  }

  .site-header__toggle-bar::before,
  .site-header__toggle-bar::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .site-header__toggle-bar::before {
    top: -6px;
  }

  .site-header__toggle-bar::after {
    top: 6px;
  }

  .site-header__toggle[open] .site-header__toggle-bar {
    background: transparent;
  }

  .site-header__toggle[open] .site-header__toggle-bar::before {
    transform: translateY(6px) rotate(45deg);
  }

  .site-header__toggle[open] .site-header__toggle-bar::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  .site-header__mobile-nav {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 200px;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 10px;
    box-shadow: var(--shadow-md);
    padding: 0.4rem;
  }

  .site-header__mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .site-header__mobile-nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--c-text);
    text-decoration: none;
  }

  .site-header__mobile-nav a:hover {
    background: var(--c-surface-alt);
  }

  .site-header__mobile-nav a[aria-current='page'] {
    color: var(--c-accent-dark);
  }

  @media (max-width: 720px) {
    .site-header__nav {
      display: none;
    }

    .site-header__toggle {
      display: block;
    }
  }

  @media (max-width: 400px) {
    .site-header__logo {
      height: 22px;
    }
  }

  @media print {
    .site-header {
      position: static;
    }

    .site-header__nav,
    .site-header__toggle,
    :global(.site-header__buy) {
      display: none;
    }
  }
</style>
