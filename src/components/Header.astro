---
import { Image } from 'astro:assets';
import wordmark from '../assets/brand/wordmark.png';
import BuyCTA from './BuyCTA.astro';
import { BUY_CTA_LABEL_SHORT, NAV, SITE } from '../data/site';
import { normalizePath } from '../lib/url';

const current = normalizePath(Astro.url.pathname);
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header class="site-header">
  <div class="site-header__brandbar">
    <div class="site-header__brandbar-inner">
      <a class="site-header__brand" href="/">
        <Image
          src={wordmark}
          width={380}
          height={90}
          alt={SITE.name}
          loading="lazy"
          decoding="async"
          class="site-header__logo"
        />
      </a>

      <span class="site-header__rule" aria-hidden="true"></span>
      <p class="site-header__tagline">{SITE.tagline}</p>

      <div class="site-header__actions">
        <BuyCTA content="header" label={BUY_CTA_LABEL_SHORT} class="site-header__buy" />

        <details class="site-header__toggle">
          <summary aria-label="메뉴 열기">
            <span class="site-header__toggle-bar" aria-hidden="true" />
          </summary>
          <nav class="site-header__mobile-nav" aria-label="주요 메뉴 (모바일)">
            <ul>
              {
                NAV.map((item) => (
                  <li>
                    <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </details>
      </div>
    </div>
  </div>

  <div class="site-header__row">
    <nav class="site-header__nav" aria-label="주요 메뉴">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  /* 2단 헤더 — 흰 띠는 브랜드, 네이비 띠는 메뉴.
     배경을 흰색으로 깔아야 로고의 원본 2색(네이비·시안)을 그대로 쓸 수 있다.
     네이비 위에 그냥 올리면 로고의 네이비 획이 배경에 묻히고,
     흰색으로 반전하면 브랜드의 시그니처인 시안이 사라진다. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .site-header__brandbar {
    background: var(--c-surface);
    border-bottom: 1px solid var(--c-border);
  }

  .site-header__brandbar-inner {
    max-width: var(--w-page);
    margin: 0 auto;
    padding: 0 var(--pad-x);
    min-height: 58px;
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .site-header__brand {
    flex: none;
    display: inline-flex;
    align-items: center;
  }

  .site-header__logo {
    display: block;
    height: 30px;
    width: auto;
  }

  /* 로고와 소개문을 갈라 주는 세로선 — 둘이 한 덩어리로 읽히지 않게 한다 */
  .site-header__rule {
    flex: none;
    width: 1px;
    height: 20px;
    background: var(--c-border-strong);
  }

  .site-header__tagline {
    margin: 0;
    min-width: 0;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--c-navy);
    white-space: nowrap;
  }

  .site-header__row {
    background: rgb(4 42 96 / 0.94);
    backdrop-filter: saturate(140%) blur(16px);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .site-header__nav {
    max-width: var(--w-page);
    margin: 0 auto;
    padding: 0 var(--pad-x);
  }

  .site-header__nav ul {
    display: flex;
    align-items: center;
    /* 링크 자체의 좌우 패딩만큼 당겨 첫 글자를 로고 왼쪽 끝과 맞춘다 */
    margin: 0 0 0 -0.75rem;
    gap: clamp(0.15rem, 1vw, 0.75rem);
    list-style: none;
    padding: 0;
  }

  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    height: 46px;
    padding: 0 0.75rem;
    white-space: nowrap;
    font-size: 0.88rem;
    font-weight: 700;
    color: #b6c0d0;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .site-header__nav a:hover {
    color: #fff;
  }

  .site-header__nav a[aria-current='page'] {
    color: #fff;
    border-bottom-color: var(--c-cyan);
  }

  .site-header__actions {
    flex: none;
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .site-header__actions :global(.buy-cta) {
    border-radius: var(--r-pill) !important;
    background: var(--grad-cta) !important;
    color: var(--c-on-cta) !important;
    box-shadow: 0 8px 24px rgb(0 143 213 / 0.28);
    font-size: 0.88rem !important;
    font-weight: 700 !important;
  }

  /* 모바일 토글 — <details>/<summary> 만으로 구현해 JS가 필요 없다 */
  .site-header__toggle {
    display: none;
    position: relative;
  }

  .site-header__toggle summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-btn);
    /* 토글이 네이비 띠에서 흰 띠로 옮겨왔다 — 테두리·막대도 같이 뒤집는다 */
    border: 1px solid var(--c-border-strong);
    cursor: pointer;
    list-style: none;
  }

  .site-header__toggle summary::-webkit-details-marker {
    display: none;
  }

  .site-header__toggle-bar,
  .site-header__toggle-bar::before,
  .site-header__toggle-bar::after {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--c-navy);
    border-radius: 1px;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .site-header__toggle-bar {
    position: relative;
  }

  .site-header__toggle-bar::before,
  .site-header__toggle-bar::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .site-header__toggle-bar::before {
    top: -6px;
  }

  .site-header__toggle-bar::after {
    top: 6px;
  }

  .site-header__toggle[open] .site-header__toggle-bar {
    background: transparent;
  }

  .site-header__toggle[open] .site-header__toggle-bar::before {
    transform: translateY(6px) rotate(45deg);
  }

  .site-header__toggle[open] .site-header__toggle-bar::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  .site-header__mobile-nav {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 200px;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-btn);
    box-shadow: var(--shadow-md);
    padding: 0.4rem;
  }

  .site-header__mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .site-header__mobile-nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    border-radius: var(--r-sm);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--c-text);
    text-decoration: none;
  }

  .site-header__mobile-nav a:hover {
    background: var(--c-surface-alt);
  }

  .site-header__mobile-nav a[aria-current='page'] {
    color: var(--c-accent-dark);
  }

  @media (max-width: 720px) {
    /* 메뉴가 토글 안으로 들어가므로 네이비 띠에 남을 것이 없다 — 띠째 접는다.
       흰 띠 하나만 남아 sticky 높이가 오히려 예전(64px)보다 낮아진다 */
    .site-header__row {
      display: none;
    }

    .site-header__toggle {
      display: block;
    }

    .site-header__brandbar-inner {
      min-height: 54px;
    }

    .site-header__actions :global(.buy-cta) {
      display: none !important;
    }
  }

  @media (max-width: 400px) {
    .site-header__logo {
      height: 22px;
    }

    .site-header__tagline {
      font-size: 0.85rem;
    }

    .site-header__brandbar-inner {
      gap: 0.6rem;
    }
  }

  @media print {
    .site-header {
      position: static;
    }

    /* 메뉴를 감추면 네이비 띠는 빈 줄만 남으므로 띠째 뺀다 */
    .site-header__row,
    .site-header__toggle,
    .site-header__actions :global(.buy-cta) {
      display: none;
    }
  }
</style>
