---
import { BUSINESS, EXTERNAL, REVIEWER_NAME } from '../data/site';
import { getLatestReviewDate } from '../lib/content';

/**
 * 신뢰 블록.
 *
 * 사업자등록번호·통신판매업신고번호는 법적 표기이며 이미 푸터에 있으므로 여기서 반복하지 않는다.
 * 이 블록은 대신 검수 주체·검수일처럼 "이 정보를 믿어도 되는 이유"를 보여준다.
 * 실적·만족도·후기 평점처럼 근거가 확보되지 않은 수치는 넣지 않는다.
 */
const latestReview = await getLatestReviewDate();
const reviewDateLabel = latestReview
  ? new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }).format(
      latestReview,
    )
  : '검수 중';

const items = [
  {
    icon: 'check',
    label: '콘텐츠 검수',
    value: REVIEWER_NAME,
    sub: '기술지원 담당',
  },
  {
    icon: 'calendar',
    label: '최종 검수일',
    value: reviewDateLabel,
    sub: '문서별 수정일은 각 페이지 하단 참고',
  },
  {
    icon: 'store',
    label: '공식몰 직영',
    value: 'blueguard.kr',
    sub: '제품 문의·구매 채널',
    href: EXTERNAL.corporate,
  },
  BUSINESS.tel
    ? { icon: 'phone', label: '기술지원 문의', value: BUSINESS.tel, sub: 'A/S·사용법 접수', href: `tel:${BUSINESS.tel.replace(/-/g, '')}` }
    : { icon: 'mail', label: '기술지원 문의', value: BUSINESS.email, sub: 'A/S·사용법 접수', href: `mailto:${BUSINESS.email}` },
];

const PATHS: Record<string, string> = {
  check: 'M20 6 9 17l-5-5M9 21h6a2 2 0 0 0 2-2V9M5 9V5a2 2 0 0 1 2-2h4',
  calendar: 'M8 2v4M16 2v4M3.5 9h17M4 4h16a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z',
  store: 'M4 9h16l-1 11a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1zM4 9l1.5-5h13L20 9M9 13a3 3 0 0 0 6 0',
  phone: 'M6 3h3l2 5-2.5 1.5a12 12 0 0 0 6 6L16 13l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2',
  mail: 'M3 6h18v12H3zM3 6l9 7 9-7',
};
---

<section class="trust" aria-label="콘텐츠 신뢰 정보">
  <ul>
    {
      items.map((item) => (
        <li>
          <svg class="trust__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d={PATHS[item.icon]} />
          </svg>
          <div class="trust__body">
            <span class="trust__label">{item.label}</span>
            {item.href ? (
              <a class="trust__value" href={item.href} rel={item.href.startsWith('http') ? 'noopener external' : undefined}>
                {item.value}
              </a>
            ) : (
              <span class="trust__value">{item.value}</span>
            )}
            <span class="trust__sub">{item.sub}</span>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .trust {
    margin: 2.5rem 0;
    padding: 1.25rem clamp(1rem, 3vw, 1.5rem);
    border: 1px solid var(--c-border);
    border-radius: var(--r-card);
    background: var(--c-surface);
    box-shadow: var(--shadow-sm);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.1rem;
  }

  li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    min-width: 0;
  }

  .trust__icon {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 0.15rem;
    fill: none;
    stroke: var(--c-accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .trust__body {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .trust__label {
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--c-text-muted);
    letter-spacing: 0.02em;
  }

  .trust__value {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--c-text);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  a.trust__value:hover {
    color: var(--c-accent-dark);
    text-decoration: underline;
  }

  .trust__sub {
    font-size: 0.75rem;
    color: var(--c-text-muted);
  }

  @media (max-width: 860px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 460px) {
    ul {
      grid-template-columns: 1fr;
    }
  }
</style>
