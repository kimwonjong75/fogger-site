---
import BuyCTA from './BuyCTA.astro';
import Pic from './Pic.astro';
import { maxFillLiters, priceLabel, type Product } from '../data/products';
import { PRODUCT_IMAGES, PRODUCT_IMAGE_ALT } from '../data/product-images';
import { BUY_CTA_LABEL_SHORT } from '../data/site';

interface Props {
  product: Product;
  /** GA model_select 이벤트의 발생 위치 (home, products, compare …) */
  context: string;
  /** 카드 안에 구매 버튼까지 노출할지 */
  withBuy?: boolean;
  /**
   * 축약 모드 — 사양 표와 사용처 줄을 접는다.
   * 홈은 "어느 것을 고를지"만 정하는 자리라 값 비교는 /compare/로 넘긴다.
   * 세 카드를 다 펼치면 모바일에서 2,400px(3화면)을 혼자 차지한다.
   */
  compact?: boolean;
}

const { product, context, withBuy = true, compact = false } = Astro.props;
const href = `/products/${product.id}/`;
const price = priceLabel(product);
---

<article class:list={['model-card', compact && 'model-card--compact']}>
  <a class="model-card__figure" href={href} tabindex="-1" aria-hidden="true">
    <Pic
      src={PRODUCT_IMAGES[product.id]}
      alt={PRODUCT_IMAGE_ALT[product.id]}
      width={320}
      height={320}
      sizes="(max-width: 900px) 90vw, 320px"
      class="model-card__photo"
    />
  </a>

  <header class="model-card__head">
    <h3 class="model-card__title">
      <a
        href={href}
        data-ga-event="model_select"
        data-ga-model={product.officialLabel}
        data-ga-product-id={product.id}
        data-ga-context={context}
      >
        {product.officialLabel}
      </a>
    </h3>
  </header>

  {price && <p class="model-card__price">{price}<span>공식몰 판매가</span></p>}

  <p class="model-card__tagline">{product.tagline}</p>

  <p class="model-card__headline">
    <span class="num">{product.tankLiters}</span><span class="model-card__unit">L</span>
    <span class="model-card__headline-label">탱크</span>
    <span class="model-card__sep" aria-hidden="true"></span>
    <span class="num">{maxFillLiters(product.tankLiters)}</span><span class="model-card__unit">L</span>
    <span class="model-card__headline-label">최대 충전</span>
  </p>

  {
    !compact && (
      <dl class="model-card__specs">
        <div>
          <dt>어깨끈</dt>
          <dd>{product.shoulderStrap ? '포함' : '미포함'}</dd>
        </div>
        <div>
          <dt>롱노즐</dt>
          <dd>{product.longNozzle ? '포함' : '미포함'}</dd>
        </div>
      </dl>
    )
  }

  {
    !compact && product.bestFor.length > 0 && (
      <p class="model-card__best">
        <span>이럴 때</span>
        {product.bestFor.slice(0, 2).join(' · ')}
      </p>
    )
  }

  <footer class="model-card__foot">
    <a
      class="model-card__more"
      href={href}
      data-ga-event="model_select"
      data-ga-model={product.officialLabel}
      data-ga-product-id={product.id}
      data-ga-context={`${context}_detail`}
    >
      상세 사양 보기
    </a>
    {withBuy && <BuyCTA productId={product.id} content={`${context}_card_${product.id}`} label={BUY_CTA_LABEL_SHORT} />}
  </footer>
</article>

<style>
  .model-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.25rem;
    border: 1px solid var(--c-border);
    border-radius: 10px;
    background: var(--c-surface);
  }

  /* 사진은 제목 링크와 목적지가 같아 스크린리더에는 중복이므로 숨긴다 */
  .model-card__figure {
    display: block;
    margin: -0.25rem 0 0.25rem;
    border-radius: 10px;
    overflow: hidden;
    background: var(--c-surface-alt);
  }

  .model-card :global(.model-card__photo) {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    transition: transform 0.2s ease;
  }

  .model-card:hover :global(.model-card__photo) {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .model-card:hover :global(.model-card__photo) {
      transform: none;
    }
  }

  .model-card__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .model-card__title {
    margin: 0;
    font-size: 1.2rem;
  }

  .model-card__title a {
    color: var(--c-text);
    text-decoration: none;
  }

  .model-card__title a:hover {
    text-decoration: underline;
  }

  /* 가격은 구매 판단의 첫 기준이라 태그라인보다 위에, 모델명 바로 아래 둔다 */
  .model-card__price {
    margin: 0 0 0.15rem;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .model-card__price span {
    margin-left: 0.4rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--c-text-muted);
    letter-spacing: 0;
  }

  .model-card__tagline {
    margin: 0;
    color: var(--c-text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /*
   * 두 핵심 수치는 표에서 빼내 카드의 시각 앵커로 세운다.
   * 배경은 제품 본체 색에서 뽑은 옐로 틴트 + 왼쪽 액센트 바로, 브랜드 블루가 아니라
   * 실제 제품과 시각적으로 연결되게 한다.
   */
  .model-card__headline {
    margin: 0;
    padding: 0.7rem 0.9rem 0.7rem 0.8rem;
    border-radius: 8px;
    border-left: 4px solid var(--c-yellow);
    background: #fdf6e3;
    color: var(--c-ink);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.1rem 0.35rem;
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .model-card__unit {
    font-size: 0.6em;
    font-weight: 700;
  }

  .model-card__headline-label {
    font-size: 0.5em;
    font-weight: 600;
    color: var(--c-text-muted);
    margin-right: 0.35rem;
  }

  .model-card__sep {
    width: 1px;
    align-self: stretch;
    background: var(--c-border-strong);
    margin: 0 0.35rem;
  }

  .model-card__specs {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 1rem;
    font-size: 0.88rem;
  }

  .model-card__specs div {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    border-bottom: 1px dotted var(--c-border);
    padding-bottom: 0.35rem;
  }

  .model-card__specs dt {
    color: var(--c-text-muted);
  }

  .model-card__specs dd {
    margin: 0;
    font-weight: 600;
  }

  .model-card__best {
    margin: 0;
    font-size: 0.86rem;
    color: var(--c-text-muted);
    line-height: 1.6;
  }

  .model-card__best span {
    display: inline-block;
    margin-right: 0.4rem;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: var(--c-surface-alt);
    font-weight: 600;
    color: var(--c-text);
  }

  .model-card__foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 0.4rem;
  }

  .model-card__more {
    font-size: 0.9rem;
    font-weight: 600;
  }

  @media (max-width: 480px) {
    .model-card__specs {
      grid-template-columns: 1fr;
    }
  }

  /*
   * 축약 카드는 모바일에서 가로로 눕는다.
   * 세로로 쌓으면 정사각 사진 하나가 화면 폭만큼(약 295px) 높이를 먹어서
   * 카드 3개가 2,000px을 차지한다. 사진을 왼쪽에 붙이면 같은 정보가 1/3 높이에 들어간다.
   */
  @media (max-width: 900px) {
    .model-card--compact {
      display: grid;
      grid-template-columns: 104px minmax(0, 1fr);
      column-gap: 1rem;
      row-gap: 0.3rem;
      align-items: start;
    }

    .model-card--compact .model-card__figure {
      grid-row: 1 / -1;
      margin: 0;
      align-self: center;
    }

    .model-card--compact > :not(.model-card__figure) {
      grid-column: 2;
    }

    .model-card--compact .model-card__headline {
      font-size: 1.1rem;
      padding: 0.45rem 0.6rem;
    }

    .model-card--compact .model-card__foot {
      padding-top: 0.2rem;
    }
  }
</style>
