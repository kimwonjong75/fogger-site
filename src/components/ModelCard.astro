---
import BuyCTA from './BuyCTA.astro';
import Pic from './Pic.astro';
import { FILL_RATIO_LABEL, maxFillLiters, SHIPPING, type Product } from '../data/products';
import { PRODUCT_IMAGES, PRODUCT_IMAGE_ALT } from '../data/product-images';
import { BUY_CTA_LABEL_SHORT } from '../data/site';

interface Props {
  product: Product;
  /** GA model_select 이벤트의 발생 위치 (home, products, compare …) */
  context: string;
  /** 카드 안에 구매 버튼까지 노출할지 */
  withBuy?: boolean;
}

const { product, context, withBuy = true } = Astro.props;
const href = `/products/${product.id}/`;
---

<article class="model-card">
  <a class="model-card__figure" href={href} tabindex="-1" aria-hidden="true">
    <Pic
      src={PRODUCT_IMAGES[product.id]}
      alt={PRODUCT_IMAGE_ALT[product.id]}
      width={320}
      height={320}
      sizes="(max-width: 900px) 90vw, 320px"
      class="model-card__photo"
    />
  </a>

  <header class="model-card__head">
    <h3 class="model-card__title">
      <a
        href={href}
        data-ga-event="model_select"
        data-ga-model={product.model}
        data-ga-product-id={product.id}
        data-ga-context={context}
      >
        {product.model}
      </a>
    </h3>
  </header>

  <p class="model-card__tagline">{product.tagline}</p>

  <p class="model-card__headline">
    <span class="num">{product.tankLiters}</span><span class="model-card__unit">L</span>
    <span class="model-card__headline-label">탱크</span>
    <span class="model-card__sep" aria-hidden="true"></span>
    <span class="num">{maxFillLiters(product.tankLiters)}</span><span class="model-card__unit">L</span>
    <span class="model-card__headline-label">최대 충전</span>
  </p>

  <dl class="model-card__specs">
    <div>
      <dt>충전 한도</dt>
      <dd>{FILL_RATIO_LABEL}</dd>
    </div>
    <div>
      <dt>어깨끈</dt>
      <dd>{product.shoulderStrap ? '포함' : '미포함'}</dd>
    </div>
    <div>
      <dt>롱노즐</dt>
      <dd>{product.longNozzle ? '포함' : '미포함'}</dd>
    </div>
    <div>
      <dt>배송</dt>
      <dd>{SHIPPING.label}</dd>
    </div>
  </dl>

  {
    product.bestFor.length > 0 && (
      <p class="model-card__best">
        <span>이럴 때</span>
        {product.bestFor.slice(0, 3).join(' · ')}
      </p>
    )
  }

  <footer class="model-card__foot">
    <a
      class="model-card__more"
      href={href}
      data-ga-event="model_select"
      data-ga-model={product.model}
      data-ga-product-id={product.id}
      data-ga-context={`${context}_detail`}
    >
      상세 사양 보기
    </a>
    {withBuy && <BuyCTA productId={product.id} content={`${context}_card_${product.id}`} label={BUY_CTA_LABEL_SHORT} />}
  </footer>
</article>

<style>
  .model-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.25rem;
    border: 1px solid var(--c-border);
    border-radius: 10px;
    background: var(--c-surface);
  }

  /* 사진은 제목 링크와 목적지가 같아 스크린리더에는 중복이므로 숨긴다 */
  .model-card__figure {
    display: block;
    margin: -0.25rem 0 0.25rem;
    border-radius: 10px;
    overflow: hidden;
    background: var(--c-surface-alt);
  }

  .model-card :global(.model-card__photo) {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    transition: transform 0.2s ease;
  }

  .model-card:hover :global(.model-card__photo) {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .model-card:hover :global(.model-card__photo) {
      transform: none;
    }
  }

  .model-card__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .model-card__title {
    margin: 0;
    font-size: 1.2rem;
  }

  .model-card__title a {
    color: var(--c-text);
    text-decoration: none;
  }

  .model-card__title a:hover {
    text-decoration: underline;
  }

  .model-card__tagline {
    margin: 0;
    color: var(--c-text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /* 두 핵심 수치는 표에서 빼내 카드의 시각 앵커로 세운다 */
  .model-card__headline {
    margin: 0;
    padding: 0.7rem 0.9rem;
    border-radius: 10px;
    background: var(--c-accent-soft);
    color: var(--c-accent-dark);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.1rem 0.35rem;
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .model-card__unit {
    font-size: 0.6em;
    font-weight: 700;
  }

  .model-card__headline-label {
    font-size: 0.5em;
    font-weight: 600;
    color: var(--c-text-muted);
    margin-right: 0.35rem;
  }

  .model-card__sep {
    width: 1px;
    align-self: stretch;
    background: var(--c-border-strong);
    margin: 0 0.35rem;
  }

  .model-card__specs {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 1rem;
    font-size: 0.88rem;
  }

  .model-card__specs div {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    border-bottom: 1px dotted var(--c-border);
    padding-bottom: 0.35rem;
  }

  .model-card__specs dt {
    color: var(--c-text-muted);
  }

  .model-card__specs dd {
    margin: 0;
    font-weight: 600;
  }

  .model-card__best {
    margin: 0;
    font-size: 0.86rem;
    color: var(--c-text-muted);
    line-height: 1.6;
  }

  .model-card__best span {
    display: inline-block;
    margin-right: 0.4rem;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: var(--c-surface-alt);
    font-weight: 600;
    color: var(--c-text);
  }

  .model-card__foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 0.4rem;
  }

  .model-card__more {
    font-size: 0.9rem;
    font-weight: 600;
  }

  @media (max-width: 480px) {
    .model-card__specs {
      grid-template-columns: 1fr;
    }
  }
</style>
