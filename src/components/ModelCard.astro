---
import Pic from './Pic.astro';
import { maxFillLiters, priceLabel, PRICES_CONFIRMED, type Product } from '../data/products';

interface Props {
  product: Product;
  /** GA model_select 이벤트의 발생 위치 (home, products, compare …) */
  context: string;
  /** 홈에는 추천 용도와 선택을 좌우하는 사양만 표시한다. */
  compact?: boolean;
}

const { product, context, compact = false } = Astro.props;
const href = `/products/${product.id}/`;
const purchaseGuide = `/compare/#buy-${product.id}`;
const price = !compact && PRICES_CONFIRMED ? priceLabel(product) : null;
const decidingFeature = product.longNozzle
  ? product.nozzle
  : product.shoulderStrap
    ? '어깨끈 포함'
    : product.nozzle;
---

<article class:list={['model-card', compact && 'model-card--compact']}>
  <a class="model-card__figure" href={href} tabindex="-1"
    data-ga-event="model_select"
    data-ga-model={product.officialLabel}
    data-ga-product-id={product.id}
    data-ga-context={context}>
    <Pic
      src={product.image}
      alt={product.imageAlt}
      width={320}
      height={320}
      sizes="(max-width: 900px) 90vw, 320px"
      class="model-card__photo"
    />
  </a>

  <header class="model-card__head">
    <h3 class="model-card__title">
      <a
        href={href}
        data-ga-event="model_select"
        data-ga-model={product.officialLabel}
        data-ga-product-id={product.id}
        data-ga-context={context}
      >
        {product.officialLabel}
      </a>
    </h3>
  </header>

  <p class="model-card__best">{product.bestFor.slice(0, 2).join(' · ')}</p>

  {compact ? (
    <p class="model-card__headline model-card__headline--compact">
      탱크 {product.tankLiters}L · {decidingFeature}
    </p>
  ) : (
    <>
      <p class="model-card__tagline">{product.tagline}</p>
      <p class="model-card__headline">
        <span class="model-card__measure">
          <span class="num">{product.tankLiters}<span class="model-card__unit">L</span></span>
          <span class="model-card__headline-label">탱크 용량</span>
        </span>
        <span class="model-card__sep" aria-hidden="true"></span>
        <span class="model-card__measure">
          <span class="num">{maxFillLiters(product.tankLiters)}<span class="model-card__unit">L</span></span>
          <span class="model-card__headline-label">최대 충전량</span>
        </span>
      </p>
    </>
  )}

  {
    !compact && (
      <dl class="model-card__specs">
        <div>
          <dt>어깨끈</dt>
          <dd>{product.shoulderStrap ? '포함' : '미포함'}</dd>
        </div>
        <div>
          <dt>노즐</dt>
          <dd>{product.nozzle}</dd>
        </div>
      </dl>
    )
  }

  {!compact && <p class="model-card__includes"><strong>구성품</strong> {product.includes.join(' · ')}</p>}

  {price && <p class="model-card__price"><span>공식몰 판매가</span> <strong>{price}</strong></p>}

  <footer class="model-card__foot">
    <a
      class="model-card__more"
      href={href}
      aria-label={`${product.officialLabel} 상세 사양 보기`}
      data-ga-event="model_select"
      data-ga-model={product.officialLabel}
      data-ga-product-id={product.id}
      data-ga-context={`${context}_detail`}
    >
      상세 사양 보기
    </a>
    <a
      class="model-card__guide"
      href={purchaseGuide}
      aria-label={`${product.officialLabel} 구매 안내`}
      data-ga-event="model_select"
      data-ga-model={product.officialLabel}
      data-ga-product-id={product.id}
      data-ga-context={`${context}_guide`}
    >
      구매 안내
    </a>
  </footer>
</article>

<style>
  .model-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.25rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-btn);
    background: var(--c-surface);
  }

  .model-card__figure {
    display: block;
    margin: -0.25rem 0 0.25rem;
    border-radius: var(--r-btn);
    overflow: hidden;
    background: var(--c-surface-alt);
  }

  .model-card :global(.model-card__photo) {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    transition: transform 0.2s ease;
  }

  .model-card:hover :global(.model-card__photo) {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .model-card:hover :global(.model-card__photo) {
      transform: none;
    }
  }

  .model-card__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .model-card__title {
    margin: 0;
    font-size: 1.2rem;
  }

  .model-card__title a {
    color: var(--c-text);
    text-decoration: none;
  }

  .model-card__title a:hover {
    text-decoration: underline;
  }

  .model-card__price {
    margin: auto 0 0;
  }

  .model-card__price span {
    font-size: 0.8rem;
    color: var(--c-text-muted);
  }

  .model-card__price strong {
    font-size: 1.05rem;
  }

  .model-card__tagline {
    margin: 0;
    color: var(--c-text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /*
   * 두 핵심 수치는 표에서 빼내 카드의 시각 앵커로 세운다.
   * 배경은 브랜드 시안의 옅은 틴트를 쓴다. 이전에는 제품 본체 색인 옐로 틴트에
   * 왼쪽 액센트 바를 뒀지만, 디자인 시스템이 색 있는 한쪽 테두리를 금한다.
   */
  .model-card__headline {
    margin: 0;
    padding: 0.7rem 0.9rem;
    border-radius: var(--r-btn);
    background: var(--c-accent-soft);
    color: var(--c-ink);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.1rem 0.35rem;
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .model-card__headline--compact {
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: 0;
  }

  .model-card__measure {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .model-card__unit {
    font-size: 0.6em;
    font-weight: 700;
  }

  .model-card__headline-label {
    font-size: 0.5em;
    font-weight: 600;
    color: var(--c-text-muted);
    margin-right: 0.35rem;
  }

  .model-card__sep {
    width: 1px;
    align-self: stretch;
    background: var(--c-border-strong);
    margin: 0 0.35rem;
  }

  .model-card__specs {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 1rem;
    font-size: 0.88rem;
  }

  .model-card__specs div {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    border-bottom: 1px dotted var(--c-border);
    padding-bottom: 0.35rem;
  }

  .model-card__specs dt {
    color: var(--c-text-muted);
  }

  .model-card__specs dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }

  .model-card__best {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .model-card__includes {
    margin: 0;
    font-size: 0.88rem;
    color: var(--c-text-muted);
  }

  .model-card__foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.35rem 0.85rem;
    flex-wrap: wrap;
    padding-top: 0.4rem;
  }

  .model-card__price + .model-card__foot {
    margin-top: 0;
  }

  .model-card__more,
  .model-card__guide {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .model-card__guide {
    font-weight: 700;
  }

  @media (max-width: 480px) {
    .model-card__specs {
      grid-template-columns: 1fr;
    }
  }

  /*
   * 축약 카드는 모바일에서 가로로 눕는다.
   * 세로로 쌓으면 정사각 사진 하나가 화면 폭만큼(약 295px) 높이를 먹어서
   * 카드 3개가 2,000px을 차지한다. 사진을 왼쪽에 붙이면 같은 정보가 1/3 높이에 들어간다.
   */
  @media (max-width: 900px) {
    .model-card--compact {
      display: grid;
      grid-template-columns: 104px minmax(0, 1fr);
      column-gap: 1rem;
      row-gap: 0.3rem;
      align-items: start;
    }

    .model-card--compact .model-card__figure {
      grid-row: 1 / span 4;
      margin: 0;
      align-self: center;
    }

    .model-card--compact > :not(.model-card__figure) {
      grid-column: 2;
    }

    .model-card--compact .model-card__headline {
      padding: 0.45rem 0.6rem;
    }

    .model-card--compact .model-card__foot {
      padding-top: 0.2rem;
    }
  }
</style>
