---
import { docHref, type DocEntry } from '../lib/content';

interface Props {
  /** published 필터를 통과한 문서만 넘길 것 */
  docs: DocEntry[];
}

const { docs } = Astro.props;

const formatter = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: 'Asia/Seoul',
});
---

{docs.length === 0 && <p class="doc-index__empty">공개된 문서가 아직 없습니다. 검수가 끝나는 대로 추가됩니다.</p>}

<ul class="doc-index">
  {
    docs.map((doc) => (
      <li>
        <a href={docHref(doc.collection, doc.id)}>
          <strong>{doc.data.title}</strong>
          <span class="doc-index__desc">{doc.data.description}</span>
          <span class="doc-index__meta">
            <time datetime={doc.data.updatedDate.toISOString().slice(0, 10)}>
              {formatter.format(doc.data.updatedDate)} 수정
            </time>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .doc-index {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .doc-index a {
    display: grid;
    gap: 0.3rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--c-border);
    border-radius: 10px;
    background: var(--c-surface);
    text-decoration: none;
    color: var(--c-text);
  }

  .doc-index a:hover {
    border-color: var(--c-accent);
    background: var(--c-accent-soft);
  }

  .doc-index strong {
    font-size: 1.02rem;
  }

  .doc-index__desc {
    font-size: 0.9rem;
    color: var(--c-text-muted);
    line-height: 1.65;
  }

  .doc-index__empty {
    margin: 1.5rem 0 0;
    padding: 1rem 1.15rem;
    border: 1px dashed var(--c-border-strong);
    border-radius: 10px;
    color: var(--c-text-muted);
    font-size: 0.92rem;
  }

  .doc-index__meta {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    font-size: 0.78rem;
    color: var(--c-text-muted);
  }
</style>
