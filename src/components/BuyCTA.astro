---
import { getProduct, SHIPPING, type ProductId } from '../data/products';
import { BUY_CTA_LABEL, OFFICIAL_STORE_PRODUCT_URL } from '../data/site';
import { withUtm } from '../lib/url';

/**
 * 공식몰 구매 CTA.
 *
 * 공식몰은 단일 상품 페이지 + 옵션 선택 구조라 모델별 딥링크가 없다.
 * productId를 주면 GA에 모델을 함께 기록하지만, 링크 목적지와 문구는 옵션 선택 기준이다.
 */
interface Props {
  /** 계측용 모델 지정. 생략하면 모델 미지정 CTA */
  productId?: ProductId;
  /** utm_content — CTA 위치 식별자 (예: hero, doc_footer, sticky_bar) */
  content: string;
  label?: string;
  variant?: 'primary' | 'secondary';
  /** 무료배송 배지 표시 (조건 문구는 페이지의 ShippingNote가 담당) */
  showShipping?: boolean;
  campaign?: string;
  class?: string;
}

const {
  productId,
  content,
  label,
  variant = 'primary',
  showShipping = false,
  campaign,
  class: className,
} = Astro.props;

const product = productId ? getProduct(productId) : null;
const href = withUtm(product?.buyUrl ?? OFFICIAL_STORE_PRODUCT_URL, { content, campaign });
const text = label ?? BUY_CTA_LABEL;
---

<span class:list={['buy-cta-wrap', className]}>
  <a
    class:list={['buy-cta', `buy-cta--${variant}`]}
    href={href}
    target="_blank"
    rel="noopener external"
    data-ga-event="purchase_cta_click"
    data-ga-utm-content={content}
    data-ga-model={product?.officialLabel}
    data-ga-product-id={product?.id}
  >
    {text}
  </a>
  {showShipping && SHIPPING.free && <span class="buy-cta__note">{SHIPPING.label}</span>}
</span>

<style>
  .buy-cta-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .buy-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 1.4rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.2;
    text-decoration: none;
    border: 1.5px solid transparent;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  /*
   * 주황 위에는 진한 글자를 얹는다.
   *
   * 강조색이 파랑(#1d63b8)에서 주황(#f59e0b)으로 바뀌면서, 파랑에서 성립하던
   * "흰 글자"가 2.15:1 로 떨어졌다(AA 기준 4.5:1). 사이트에서 가장 중요한 버튼이
   * 가장 안 읽히는 상태였다. 헤더·하단 구매바는 이미 진한 글자를 쓰고 있었고,
   * 여기도 같은 방식으로 맞춘다 — 그라데이션 밝은 끝 10.4:1, 진한 끝 6.5:1.
   */
  .buy-cta--primary {
    background: linear-gradient(100deg, var(--c-yellow), #ff6a00);
    color: #17110a;
    font-weight: 850;
  }

  .buy-cta--primary:hover {
    background: linear-gradient(100deg, #ffc13b, #ff7b1a);
  }

  /* 테두리도 --c-accent 는 흰 배경에서 2.15:1 이라 UI 요소 기준(3:1)에 미달한다 */
  .buy-cta--secondary {
    background: transparent;
    color: var(--c-accent-dark);
    border-color: var(--c-accent-dark);
  }

  .buy-cta--secondary:hover {
    background: var(--c-accent-soft);
  }

  .buy-cta__note {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--c-accent-dark);
  }
</style>
